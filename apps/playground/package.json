{
  "name": "@lumiose/playground",
  "version": "0.0.0",
  "private": true,
  "description": "The Lumiose playground at /playground: edit .stsx in the browser, see the compiled client and server code, the CSS, the diagnostics and the running result. Uses the WebAssembly compiler (crates/lumiose_wasm).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare:assets": "node scripts/assets.ts",
    "dev": "node scripts/assets.ts && lumiose dev",
    "build": "node scripts/assets.ts && lumiose build",
    "preview": "lumiose preview",
    "typecheck": "lumiose check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "screenshots": "SCREENSHOTS=1 playwright test -g screenshots"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@lumiose/site-kit": "workspace:*",
    "lumiose": "workspace:*"
  },
  "devDependencies": {
    "@lumiose/compiler": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
