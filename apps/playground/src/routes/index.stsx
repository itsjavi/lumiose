// The playground page, prerendered: the site header and footer from @lumiose/site-kit around the
// Playground island, which loads the WebAssembly compiler and the editor in the browser.
import { Footer, GitHubLink, SiteHeader } from "@lumiose/site-kit";
import { Title } from "lumiose";
import { Playground } from "../islands/Playground.stsx";
import { BASE, footerColumns, navLinks, REPOSITORY, SITE, siteLink } from "../lib/site.ts";

export default function PlaygroundPage() {
  return (
    <div class="page">
      <Title>Playground · Lumiose</Title>
      <SiteHeader
        links={navLinks}
        current={siteLink("/playground")}
        home={siteLink("/")}
        actions={<GitHubLink href={REPOSITORY} />}
      />
      <main id="content">
        <Playground client:load base={BASE} site={SITE} />
      </main>
      <Footer columns={footerColumns}>
        <p>
          MIT licensed. The playground compiles in your browser with Lumiose's WebAssembly build.
        </p>
      </Footer>
    </div>
  );
}

<style>
  .page {
    display: flex;
    flex-direction: column;
    min-block-size: 100dvh;
  }
  main {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
</style>
