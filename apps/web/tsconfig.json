{
  // The generated Lumiose tsconfig pairs the workspace with `.lumiose/shadow`, so the `.stsx` modules
  // of @lumiose/site-kit type-check with the site (`lumiose check`).
  "extends": ["../../tsconfig.base.json", "./.lumiose/tsconfig.generated.json"],
  "compilerOptions": {
    // `vite/client` types `import.meta.glob` and `?raw` imports in src/content.
    "types": ["node", "lumiose/env", "vite/client"]
  },
  "include": [
    "src",
    "e2e",
    "vite.config.ts",
    "playwright.config.ts",
    ".lumiose/shadow",
    ".lumiose/types"
  ]
}
