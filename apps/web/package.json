{
  "name": "@lumiose/web",
  "version": "0.0.0",
  "private": true,
  "description": "The Lumiose website: the landing page at /, the docs at /docs, the @lumiose/ui docs at /ui and the playground at /playground (the WebAssembly compiler, crates/lumiose_wasm, in the browser). A static Lumiose site built with @lumiose/site-kit.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "playground:assets": "node scripts/playground-assets.ts",
    "ui:demos": "node scripts/ui-demos.ts",
    "dev": "node scripts/playground-assets.ts --optional && lumiose dev",
    "build": "node scripts/playground-assets.ts && lumiose build",
    "preview": "lumiose preview",
    "typecheck": "lumiose check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "screenshots": "SCREENSHOTS=1 playwright test -g screenshots"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@lumiose/site-kit": "workspace:*",
    "@lumiose/ui": "workspace:*",
    "lumiose": "workspace:*",
    "marked": "^18.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@lumiose/cli": "workspace:*",
    "@lumiose/compiler": "workspace:*",
    "@lumiose/vite": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "demo": {
    "title": "Lumiose website and playground",
    "kind": "site"
  }
}
