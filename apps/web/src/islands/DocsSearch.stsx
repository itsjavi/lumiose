// Island (client:idle): search the docs as you type, over the prebuilt search.json index (fetched
// once, on first focus). Arrow keys move through the results, Enter opens one, Escape closes the
// list, and "/" focuses the box from anywhere on the page. Without JavaScript the input is inert.
import { color, font, radius, shadow, space, text, weight } from "@lumiose/site-kit/tokens";
import { computed, fetchJSON, onMount, signal } from "lumiose";
import { searchDocs, type SearchEntry } from "../lib/search.ts";

export function DocsSearch(props: { index: string }) {
  const query = signal("");
  const entries = signal<SearchEntry[] | undefined>(undefined);
  const failed = signal(false);
  const open = signal(false);
  const active = signal(-1);
  const ready = signal(false);
  const results = computed(() => searchDocs(entries() ?? [], query()));
  let input: HTMLInputElement | undefined;
  let loading: Promise<void> | undefined;

  /** "/" focuses the box, unless the reader is typing somewhere. */
  const onShortcut = (event: KeyboardEvent) => {
    const target = event.target as HTMLElement | null;
    const typing = target?.closest("input, textarea, select, [contenteditable]") !== null;
    if (event.key === "/" && !typing) {
      event.preventDefault();
      input?.focus();
    }
  };

  onMount(() => {
    ready.set(true);
    document.addEventListener("keydown", onShortcut);
    return () => document.removeEventListener("keydown", onShortcut);
  });

  function loadIndex() {
    loading ??= fetchJSON<SearchEntry[]>(props.index).then(
      (data) => entries.set(data),
      () => {
        failed.set(true);
        loading = undefined;
      },
    );
  }

  function onInput(value: string) {
    loadIndex();
    query.set(value);
    active.set(-1);
    open.set(value.trim() !== "");
  }

  function go(index: number) {
    const result = results()[index];
    if (result !== undefined) location.assign(result.url);
  }

  function onKeyDown(event: KeyboardEvent) {
    const count = results().length;
    if (event.key === "ArrowDown" && count > 0) {
      event.preventDefault();
      open.set(true);
      active.set((active() + 1) % count);
    } else if (event.key === "ArrowUp" && count > 0) {
      event.preventDefault();
      active.set(active() <= 0 ? count - 1 : active() - 1);
    } else if (event.key === "Enter" && count > 0) {
      event.preventDefault();
      go(Math.max(0, active()));
    } else if (event.key === "Escape") {
      open.set(false);
      active.set(-1);
    }
  }

  const status = () =>
    failed()
      ? "Search is unavailable right now."
      : entries() === undefined
        ? "Loading…"
        : `Nothing matches “${query().trim()}”.`;

  return (
    <div class="search" role="search" data-ready={ready() ? "" : undefined}>
      <label class="sr-only" for="docs-search">
        Search the docs
      </label>
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="11" cy="11" r="6.5" />
        <path d="m16 16 4.5 4.5" />
      </svg>
      <input
        id="docs-search"
        type="search"
        placeholder="Search the docs"
        autocomplete="off"
        spellcheck={false}
        role="combobox"
        aria-autocomplete="list"
        aria-controls="docs-search-results"
        aria-expanded={open() && results().length > 0 ? "true" : "false"}
        aria-activedescendant={active() >= 0 ? `docs-search-${active()}` : undefined}
        ref={(element) => (input = element)}
        onInput={(event) => onInput(event.currentTarget.value)}
        onKeyDown={onKeyDown}
        onFocus={() => {
          loadIndex();
          open.set(query().trim() !== "");
        }}
        onBlur={() => setTimeout(() => open.set(false), 150)}
      />
      <kbd class="key" aria-hidden="true">
        /
      </kbd>
      <div class="panel" hidden={!open()}>
        <ul id="docs-search-results" role="listbox" aria-label="Docs pages" hidden={results().length === 0}>
          {results().map((result, index) => (
            <li id={`docs-search-${index}`} role="option" aria-selected={index === active() ? "true" : "false"}>
              <a href={result.url} tabindex="-1">
                <span class="where">
                  {result.section}
                  {result.heading === undefined ? "" : ` · ${result.title}`}
                </span>
                <strong>{result.heading ?? result.title}</strong>
                <span class="snippet">{result.snippet}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="status" role="status" hidden={results().length > 0}>
          {status()}
        </p>
      </div>
    </div>
  );
}

<style>
  .search {
    position: relative;
  }
  .icon {
    position: absolute;
    inset-inline-start: 0.7rem;
    inset-block-start: 50%;
    inline-size: 1rem;
    block-size: 1rem;
    translate: 0 -50%;
    fill: none;
    stroke: $color.subtle;
    stroke-width: 2;
    stroke-linecap: round;
    pointer-events: none;
  }
  input {
    inline-size: 100%;
    padding: 0.5rem 2.2rem 0.5rem 2.1rem;
    border: 1px solid $color.border;
    border-radius: $radius.md;
    background: $color.surface;
    font-size: $text.sm;
  }
  input:focus-visible {
    outline: none;
    border-color: $color.accent;
    box-shadow: 0 0 0 3px $color.accentSoft;
  }
  input::-webkit-search-cancel-button {
    display: none;
  }
  .key {
    position: absolute;
    inset-inline-end: 0.6rem;
    inset-block-start: 50%;
    translate: 0 -50%;
    color: $color.subtle;
    font-size: $text.xs;
    pointer-events: none;
  }
  .panel {
    position: absolute;
    z-index: 30;
    inset-inline-start: 0;
    inset-block-start: calc(100% + $space.xs);
    inline-size: min(26rem, calc(100vw - 2rem));
    max-block-size: 70vh;
    overflow-y: auto;
    padding: $space.xxs;
    border: 1px solid $color.border;
    border-radius: $radius.md;
    background: $color.surface;
    box-shadow: $shadow.lg;
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li a {
    display: grid;
    gap: 0.1rem;
    padding: $space.xs $space.sm;
    border-radius: $radius.sm;
    color: inherit;
    text-decoration: none;
  }
  li a strong {
    font-weight: $weight.semibold;
  }
  .where,
  .snippet,
  .status {
    color: $color.muted;
    font-size: $text.xs;
  }
  .where {
    color: $color.accentText;
  }
  .snippet {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-family: $font.mono;
  }
  .status {
    padding: $space.xs $space.sm;
  }
  li[aria-selected="true"] a,
  li a:hover {
    background: $color.accentSoft;
  }
</style>
