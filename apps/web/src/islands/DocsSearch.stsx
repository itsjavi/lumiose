// Island (client:idle): search the docs as you type, over the prebuilt search.json index (fetched
// once, on first focus). @lumiose/ui's Autocomplete runs the box (TASK-421): `mode="none"` leaves
// the ranking to searchDocs, the arrow keys move through the results (the first one is
// highlighted as you type), and Escape closes them, keeping the text. Each result is a link: Enter
// opens the highlighted one and a click follows it, instead of filling the box. "/" focuses the
// box from anywhere on the page. Without JavaScript the input is inert.
import { Autocomplete } from "@lumiose/ui";
import "@lumiose/ui/autocomplete.css";
import { color, font, radius, shadow, space, text, weight } from "@lumiose/site-kit/tokens";
import { computed, fetchJSON, onMount, signal } from "lumiose";
import { searchDocs, type SearchEntry } from "../lib/search.ts";

export function DocsSearch(props: { index: string }) {
  const query = signal("");
  const entries = signal<SearchEntry[] | undefined>(undefined);
  const failed = signal(false);
  const ready = signal(false);
  const results = computed(() => searchDocs(entries() ?? [], query()));
  let input: HTMLInputElement | undefined;
  let loading: Promise<void> | undefined;

  /** "/" focuses the box, unless the reader is typing somewhere. */
  const onShortcut = (event: KeyboardEvent) => {
    const target = event.target as HTMLElement | null;
    const typing = target?.closest("input, textarea, select, [contenteditable]") !== null;
    if (event.key === "/" && !typing) {
      event.preventDefault();
      input?.focus();
    }
  };

  /**
   * Enter opens the highlighted result (or the first): on the input itself, so it runs before
   * the autocomplete's element, which would fill the result's value into the box.
   */
  const onEnter = (event: KeyboardEvent) => {
    if (event.key !== "Enter" || event.isComposing) return;
    const id = input?.getAttribute("aria-activedescendant");
    const url = id ? document.getElementById(id)?.dataset["value"] : results()[0]?.url;
    if (url !== undefined) {
      event.preventDefault();
      location.assign(url);
    }
  };

  onMount(() => {
    ready.set(true);
    document.addEventListener("keydown", onShortcut);
    input?.addEventListener("keydown", onEnter);
    return () => {
      document.removeEventListener("keydown", onShortcut);
      input?.removeEventListener("keydown", onEnter);
    };
  });

  function loadIndex() {
    loading ??= fetchJSON<SearchEntry[]>(props.index).then(
      (data) => entries.set(data),
      () => {
        failed.set(true);
        loading = undefined;
      },
    );
  }

  const status = () =>
    failed()
      ? "Search is unavailable right now."
      : entries() === undefined
        ? "Loading…"
        : `Nothing matches “${query().trim()}”.`;

  return (
    <div class="search" role="search" data-ready={ready() ? "" : undefined}>
      <Autocomplete.Root
        mode="none"
        autoHighlight
        onValueChange={(value) => {
          loadIndex();
          query.set(value);
        }}
      >
        <Autocomplete.Label class="sr-only">Search the docs</Autocomplete.Label>
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="6.5" />
          <path d="m16 16 4.5 4.5" />
        </svg>
        <Autocomplete.Input
          class="input"
          placeholder="Search the docs"
          spellcheck={false}
          ref={(element) => (input = element)}
          onFocus={loadIndex}
        />
        <kbd class="key" aria-hidden="true">
          /
        </kbd>
        <Autocomplete.Popup class="panel" sideOffset={4}>
          <Autocomplete.List>
            {results().map((result) => (
              <Autocomplete.Item class="result" value={result.url}>
                {/* The link navigates, with modifier keys too; the element never sees the click. */}
                <a href={result.url} tabindex="-1" on:click={(event) => event.stopPropagation()}>
                  <span class="where">
                    {result.section}
                    {result.heading === undefined ? "" : ` · ${result.title}`}
                  </span>
                  <strong>{result.heading ?? result.title}</strong>
                  <span class="snippet">{result.snippet}</span>
                </a>
              </Autocomplete.Item>
            ))}
          </Autocomplete.List>
          {query().trim() !== "" && (
            <Autocomplete.Empty class="status">{status()}</Autocomplete.Empty>
          )}
        </Autocomplete.Popup>
      </Autocomplete.Root>
    </div>
  );
}

<style>
  .search {
    position: relative;
  }
  .icon {
    position: absolute;
    inset-inline-start: 0.7rem;
    inset-block-start: 50%;
    inline-size: 1rem;
    block-size: 1rem;
    translate: 0 -50%;
    fill: none;
    stroke: $color.subtle;
    stroke-width: 2;
    stroke-linecap: round;
    pointer-events: none;
  }
  .input {
    inline-size: 100%;
    padding: 0.5rem 2.2rem 0.5rem 2.1rem;
    border: 1px solid $color.border;
    border-radius: $radius.md;
    background: $color.surface;
    font-size: $text.sm;
  }
  .input:focus-visible {
    outline: none;
    border-color: $color.accent;
    box-shadow: 0 0 0 3px $color.accentSoft;
  }
  .key {
    position: absolute;
    inset-inline-end: 0.6rem;
    inset-block-start: 50%;
    translate: 0 -50%;
    color: $color.subtle;
    font-size: $text.xs;
    pointer-events: none;
  }
  /* A popover in the top layer, placed under the input by @lumiose/ui's placement rules. */
  .panel {
    inline-size: min(26rem, calc(100vw - 2rem));
    max-block-size: 70vh;
    overflow-y: auto;
    padding: $space.xxs;
    border: 1px solid $color.border;
    border-radius: $radius.md;
    background: $color.surface;
    box-shadow: $shadow.lg;
  }
  .result a {
    display: grid;
    gap: 0.1rem;
    padding: $space.xs $space.sm;
    border-radius: $radius.sm;
    color: inherit;
    text-decoration: none;
  }
  .result a strong {
    font-weight: $weight.semibold;
  }
  .where,
  .snippet,
  .status {
    color: $color.muted;
    font-size: $text.xs;
  }
  .where {
    color: $color.accentText;
  }
  .snippet {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-family: $font.mono;
  }
  .status {
    padding: $space.xs $space.sm;
  }
  .result[data-highlighted] a,
  .result a:hover {
    background: $color.accentSoft;
  }
</style>
