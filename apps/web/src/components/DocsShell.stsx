// The docs shell of /docs and /ui (TASK-387): search and the section navigation beside the page.
// Below $bp.lg the navigation folds into a closed disclosure above the page, so the content comes
// first on phones; on wide screens CSS shows the disclosure's content without its summary.
//
// The sidebar is slim (TASK-608, decision-90): mono uppercase group labels, plain links, and an
// amber dot before the current page (with the text colour and a heavier weight, so the state is
// not shown by colour alone).
import { bp, color, font, label, layout, space, text, weight } from "@lumiose/site-kit/tokens";
import { href } from "lumiose";
import { DocsSearch } from "../islands/DocsSearch.stsx";

export interface ShellLink {
  href: string;
  label: string;
  /** A tooltip, for short labels. */
  title?: string;
  current?: boolean;
}

export interface ShellSection {
  title: string;
  links: ShellLink[];
  /**
   * A closed disclosure (open when it holds the current page) with its links in two columns:
   * the diagnostics.
   */
  codes?: boolean;
}

export function DocsShell(props: {
  /** The navigation's name, as screen readers announce it ("Docs"). */
  label: string;
  sections: ShellSection[];
  children?: JSX.Element;
}) {
  const links = (section: ShellSection) => (
    <ul role="list" class={{ codes: section.codes === true }}>
      {section.links.map((link) => (
        <li>
          <a href={link.href} aria-current={link.current ? "page" : undefined} title={link.title}>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  );

  return (
    <div class="docs">
      <aside class="side" aria-label="Documentation">
        <DocsSearch client:idle index={href("/search.json")} />
        <details class="menu">
          <summary>Menu</summary>
          <nav aria-label={props.label}>
            {props.sections.map((section) =>
              section.codes ? (
                <details class="group" open={section.links.some((link) => link.current)}>
                  <summary>{section.title}</summary>
                  {links(section)}
                </details>
              ) : (
                <div class="group">
                  <p class="heading">{section.title}</p>
                  {links(section)}
                </div>
              ),
            )}
          </nav>
        </details>
      </aside>
      <div class="page">{props.children}</div>
    </div>
  );
}

<style>
  .docs {
    display: grid;
    gap: $space.lg;
    max-inline-size: $layout.page;
    margin-inline: auto;
    padding: $space.lg $layout.gutter $space.xxl;
  }
  @media (width >= $bp.lg) {
    .docs {
      grid-template-columns: 12rem minmax(0, 1fr);
      gap: $space.xxl;
      padding-block-start: $space.xxl;
    }
    /* The navigation scrolls on its own, below the search box, whose results may overlap
       the page. */
    .side {
      position: sticky;
      inset-block-start: calc($layout.header + $space.lg);
      align-self: start;
      z-index: 3;
    }
    nav {
      max-block-size: calc(100dvh - $layout.header - 6.5rem);
      overflow-y: auto;
      overscroll-behavior: contain;
      padding-inline-end: $space.xs;
    }
    /* The disclosure is always open on wide screens. */
    .menu > summary {
      display: none;
    }
    .menu::details-content {
      content-visibility: visible;
    }
  }
  .side {
    display: grid;
    gap: $space.md;
    align-content: start;
    min-inline-size: 0;
  }
  .menu > summary,
  .heading,
  .group > summary {
    color: $color.muted;
    font-family: $label.font;
    font-size: $label.size;
    letter-spacing: $label.tracking;
    line-height: 1.2;
    text-transform: $label.transform;
  }
  .menu > summary {
    padding: $space.sm;
    border: 1px solid $color.border;
    color: $color.text;
    cursor: pointer;
  }
  nav {
    display: grid;
    gap: $space.lg;
    padding-block: $space.sm;
  }
  .heading,
  .group > summary {
    margin-block-end: $space.xs;
  }
  .group > summary {
    padding-block: $space.xxs;
    cursor: pointer;
  }
  a {
    display: block;
    padding-block: 0.2rem;
    color: $color.muted;
    font-size: $text.sm;
    line-height: 1.4;
    text-decoration: none;
  }
  a:hover {
    color: $color.text;
  }
  a[aria-current="page"] {
    color: $color.text;
    font-weight: $weight.semibold;
  }
  a[aria-current="page"]::before {
    content: "●";
    margin-inline-end: 0.5em;
    color: $color.accent;
    font-size: 0.6em;
    vertical-align: 0.2em;
  }
  a:focus-visible {
    outline-offset: 1px;
  }
  .codes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .codes a {
    font-family: $font.mono;
    font-size: $text.xs;
  }
  .codes li:first-child {
    grid-column: 1 / -1;
  }
  .codes li:first-child a {
    font-family: inherit;
    font-size: $text.sm;
  }
  .page {
    min-inline-size: 0;
  }
</style>
