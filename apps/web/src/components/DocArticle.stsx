// A docs page: the head (section, title, lead), the step bar of a page of numbered steps, the
// Markdown in sections (the kit's CodeBlock for code) and prev/next links. Shared by /docs, /ui and
// /stsx (TASK-387). A UI page passes `demo`, which renders the live demo of an example
// (src/ui-demos), and `palette`, the default theme's colours; the demos then appear above their
// code. The page's first demo runs at the top instead, once: its example points there, so no
// component renders twice (or its ids would).
//
// The layout comes from the Markdown's structure (TASK-608, decision-90; the rule is `layoutRows`
// in content/docs.ts): in a section, words sit on the left and the code they describe on the right,
// from $bp.md up; below it the blocks stack in source order. Words without code are one column of
// about 68 characters, and a table may take the page's width.
//
// The Markdown's styles target only its own HTML (`.chunk`), so they never reach a demo: a demo's
// preview resets what the site's unlayered base styles set (`all: revert-layer`), so the components
// look as @lumiose/ui's default theme draws them, in the site's light or dark scheme.
import { CodeBlock } from "@lumiose/site-kit";
import { highlight } from "@lumiose/site-kit/highlight";
import {
  bp,
  color,
  font,
  label,
  layout,
  leading,
  space,
  text,
  weight,
} from "@lumiose/site-kit/tokens";
import { adjacentDocs, type DocBlock, type DocCode, type DocPage } from "../content/docs.ts";
import { DocSteps } from "../islands/DocSteps.stsx";
import { site, type OgImage } from "../lib/site.ts";
import { PageMeta } from "./PageMeta.tsx";

type Demo = NonNullable<DocCode["demo"]>;

export interface DocArticleProps {
  page: DocPage;
  /** The document title. */
  title: string;
  /** The meta description, instead of the page's summary (a section's landing page). */
  description?: string;
  /** The Open Graph image, instead of the home page's. */
  image?: OgImage;
  /** Renders a UI example's live demo by id. */
  demo?: (id: string) => JSX.Element;
  /** Renders the default theme's palette. */
  palette?: () => JSX.Element;
}

/** A title longer than this is set smaller: a diagnostic's sentence, not a page's name. */
const LONG_TITLE = 26;

export function DocArticle(props: DocArticleProps) {
  const around = () => adjacentDocs(props.page);
  const toc = () =>
    props.page.headings.filter((heading) => heading.depth === 2 || props.page.headings.length < 14);
  const steps = () =>
    props.page.steps.map((heading) => ({
      id: heading.id,
      number: heading.step!,
      title: heading.text.replace(/^\d+\.\s+/, ""),
    }));
  const demos = () =>
    props.demo === undefined
      ? []
      : props.page.blocks.flatMap((block) =>
          block.kind === "code" && block.demo !== undefined ? [block.demo] : [],
        );
  /** The page's first demo, which runs at the top. */
  const first = () => demos()[0];
  const preview = (demo: Demo) => (
    <div class="preview" data-demo={demo.id}>
      {props.demo!(demo.id)}
    </div>
  );
  const code = (block: DocCode) =>
    block.demo !== undefined && props.demo !== undefined ? (
      <figure class="demo" id={`demo-${block.demo.id}`}>
        {block.demo.id === first()!.id ? (
          <figcaption class="note">
            <a href="#live">Live at the top of the page</a>:{" "}
            {block.demo.island ? "an island" : "server-rendered, no island"}
          </figcaption>
        ) : (
          <>
            {preview(block.demo)}
            <figcaption class="note">
              {block.demo.island
                ? "Live: an island, hydrated when it scrolls into view"
                : "Live: server-rendered, no island"}
            </figcaption>
          </>
        )}
        <CodeBlock code={block.code} lang={block.lang} title={block.title} highlight={highlight} />
      </figure>
    ) : (
      <CodeBlock code={block.code} lang={block.lang} title={block.title} highlight={highlight} />
    );
  const full = (block: DocBlock) =>
    block.kind === "palette" ? (
      props.palette?.()
    ) : block.kind === "html" ? (
      <div class={["chunk", block.wide ? "wide" : "words"]} innerHTML={block.html} />
    ) : (
      code(block)
    );

  return (
    <div class={{ doc: true, stepped: props.page.steps.length > 0 }}>
      <PageMeta
        title={props.title}
        description={props.description ?? (props.page.summary || site.description)}
        image={props.image}
      />

      <article>
        <header class="head">
          <div class="name">
            <p class="section">{props.page.section}</p>
            <h1 class={{ long: props.page.title.length > LONG_TITLE }}>{props.page.title}</h1>
          </div>
          {props.page.summary !== "" && <p class="lead" innerHTML={props.page.summaryHtml} />}
        </header>
        {toc().length > 1 && (
          <nav class="toc" aria-label="On this page">
            <details>
              <summary>On this page</summary>
              <ol role="list">
                {toc().map((heading) => (
                  <li class={{ sub: heading.depth === 3 }}>
                    <a href={`#${heading.id}`}>{heading.text}</a>
                  </li>
                ))}
              </ol>
            </details>
          </nav>
        )}
        {steps().length > 0 && <DocSteps client:idle steps={steps()} />}
        {first() !== undefined && (
          <figure class="demo hero" id="live">
            {preview(first()!)}
            <figcaption class="note">
              A live demo, with the default theme. <a href={`#demo-${first()!.id}`}>Its code</a>
            </figcaption>
          </figure>
        )}
        <div class="prose">
          {props.page.sections.map((section) => (
            <section
              class={{
                sec: true,
                top: section.heading?.depth === 2,
                sub: section.heading?.depth === 3,
              }}
            >
              {section.rows.map((row) =>
                row.kind === "full" ? (
                  full(row.block)
                ) : (
                  <div class={{ pair: true, tailed: row.tail !== undefined }}>
                    {row.lead !== undefined && <div class="chunk words" innerHTML={row.lead} />}
                    <div class="aside">{row.aside.map(code)}</div>
                    {row.tail !== undefined && (
                      <div class="chunk words tail" innerHTML={row.tail} />
                    )}
                  </div>
                ),
              )}
            </section>
          ))}
        </div>
        <nav class="adjacent" aria-label="Previous and next pages">
          {around().prev === undefined ? (
            <span />
          ) : (
            <a rel="prev" href={around().prev!.url}>
              <small>Previous</small>
              {around().prev!.label}
            </a>
          )}
          {around().next === undefined ? (
            <span />
          ) : (
            <a rel="next" class="next" href={around().next!.url}>
              <small>Next</small>
              {around().next!.label}
            </a>
          )}
        </nav>
      </article>
    </div>
  );
}

<style>
  /* Where sticky words stop below the header, and how far below the page's scroll padding (the
     header) an anchor stops: both lower on a page with the step bar. */
  .doc {
    --doc-top: calc($layout.header + $space.lg);
    --doc-anchor: 0px;
  }
  .doc.stepped {
    --doc-top: calc($layout.header + $space.xxxl);
    --doc-anchor: $space.xxl;
  }
  article {
    min-inline-size: 0;
  }

  /* The head: the section and a large title, the summary beside them, and a rule below. */
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: $space.md $space.xl;
    padding-block-end: $space.lg;
    border-block-end: 1px solid $color.text;
  }
  .name {
    flex: 1 1 18rem;
    min-inline-size: 0;
  }
  .section,
  .toc summary,
  .adjacent small,
  .chunk :deep(.step) {
    color: $color.muted;
    font-family: $label.font;
    font-size: $label.size;
    font-weight: $weight.regular;
    letter-spacing: $label.tracking;
    line-height: 1.2;
    text-transform: $label.transform;
  }
  h1 {
    margin-block-start: $space.md;
    font-size: $text.display;
    letter-spacing: -0.05em;
    line-height: 0.98;
  }
  h1.long {
    font-size: $text.xxxl;
    letter-spacing: -0.045em;
    line-height: $leading.tight;
  }
  .lead {
    flex: 0 1 22rem;
    color: $color.muted;
    line-height: 1.5;
    text-wrap: pretty;
  }
  /* A subtitle reads as one sentence: its code is set in the code font, without chips. */
  .lead :deep(code) {
    padding: 0;
    border: 0;
    background: none;
    color: $color.text;
    font-size: 0.9em;
  }

  /* The page's headings, folded: the sections are a scroll away, and a step page has its bar. */
  .toc {
    border-block-end: 1px solid $color.border;
  }
  .toc summary {
    padding-block: $space.sm;
    cursor: pointer;
  }
  .toc ol {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 0 $space.lg;
    padding-block-end: $space.md;
  }
  .toc a {
    display: block;
    padding-block: 0.25rem;
    color: $color.muted;
    font-size: $text.sm;
    line-height: 1.35;
    text-decoration: none;
  }
  .toc a:hover {
    color: $color.text;
  }
  .toc .sub a {
    padding-inline-start: $space.md;
  }

  /* Sections: a hairline above each `##`, words at a readable measure, and pairs in two columns. */
  .prose {
    font-size: 1.0625rem;
    line-height: $leading.normal;
  }
  .sec {
    padding-block-start: $space.xl;
  }
  .sec.top {
    padding-block: $space.xxl $space.lg;
    border-block-start: 1px solid $color.border;
  }
  .sec.top:first-child {
    border-block-start: 0;
  }
  .words {
    max-inline-size: 68ch;
  }
  .aside {
    display: grid;
    gap: $space.md;
    min-inline-size: 0;
    margin-block-end: $space.md;
  }
  .aside :deep(.code),
  .aside > .demo {
    margin-block: 0;
  }
  @media (width >= $bp.md) {
    .pair {
      display: grid;
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      grid-template-rows: auto 1fr;
      column-gap: $space.xl;
    }
    .pair > .words {
      grid-column: 1;
      align-self: start;
    }
    .pair > .aside {
      grid-area: 1 / 2 / span 2;
      align-self: start;
    }
    /* The words stay in view while their code scrolls past. */
    .pair:not(.tailed) > .words {
      position: sticky;
      inset-block-start: var(--doc-top);
    }
    .pair > .tail {
      grid-row: 2;
    }
    /* Code beside words has less room: one size down, as many characters a line as it can. */
    .aside :deep(pre) {
      font-size: 0.8125rem;
    }
  }

  .chunk :deep(:is(p, ul, ol, blockquote, .table, .nested-code)) {
    margin-block: 0 $space.md;
  }
  .chunk :deep(:is(h2, h3, h4)) {
    position: relative;
    scroll-margin-block-start: var(--doc-anchor);
  }
  .chunk :deep(h2) {
    margin-block-end: $space.sm;
    font-size: $text.xxl;
  }
  .chunk :deep(h3) {
    margin-block-end: $space.sm;
    font-size: $text.xl;
  }
  .chunk :deep(h4) {
    margin-block: $space.lg $space.xs;
  }
  .chunk :deep(.step) {
    display: block;
    margin-block-end: $space.sm;
  }
  .chunk :deep(.anchor) {
    position: absolute;
    inset-inline-start: -1.1em;
    inset-block-end: 0;
    padding-inline-end: 0.3em;
    color: $color.subtle;
    text-decoration: none;
    opacity: 0;
    transition: opacity 120ms;
  }
  .chunk :deep(:is(h2, h3, h4):hover .anchor),
  .chunk :deep(.anchor:focus-visible) {
    opacity: 1;
  }
  .chunk :deep(:is(ul, ol)) {
    padding-inline-start: 1.4em;
  }
  /* List items are often whole paragraphs with a bold lead-in: space them like paragraphs. */
  .chunk :deep(li + li) {
    margin-block-start: $space.xs;
  }
  .chunk :deep(li::marker) {
    color: $color.subtle;
  }
  .chunk :deep(li > :is(ul, ol)) {
    margin-block: $space.xxs 0;
  }
  .chunk :deep(blockquote) {
    padding: $space.sm $space.md;
    border-inline-start: 3px solid $color.border;
    background: $color.sunken;
    color: $color.muted;
  }
  .chunk :deep(blockquote.status) {
    border-color: $color.infoBorder;
    background: $color.infoBg;
    color: $color.text;
  }
  .chunk :deep(blockquote > :last-child) {
    margin-block-end: 0;
  }
  .chunk :deep(.table) {
    overflow-x: auto;
    border: 1px solid $color.border;
  }
  .chunk :deep(table) {
    inline-size: 100%;
    border-collapse: collapse;
    font-size: $text.sm;
  }
  .chunk :deep(:is(th, td)) {
    padding: $space.xs $space.sm;
    border-block-end: 1px solid $color.border;
    text-align: start;
    vertical-align: top;
  }
  .chunk :deep(th) {
    background: $color.sunken;
    font-weight: $weight.semibold;
    white-space: nowrap;
  }
  .chunk :deep(tr:last-child td) {
    border-block-end: 0;
  }
  .chunk :deep(td code) {
    white-space: nowrap;
  }
  .chunk :deep(.nested-code) {
    padding: $space.sm $space.md;
    border: 1px solid $color.border;
    background: $color.codeBg;
    overflow-x: auto;
    font-size: $text.sm;
  }

  /* Live demos: the preview, a caption, then the example's code below it. */
  .demo {
    margin-block: $space.lg;
  }
  .demo :deep(.code) {
    margin-block: 0;
  }
  .preview {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: $space.md;
    min-block-size: 9rem;
    padding: $space.xl $space.lg;
    border: 1px solid $color.border;
    background: var(--lu-background);
    color: var(--lu-foreground);
    font-family: $font.sans;
    font-size: 1rem;
    line-height: 1.5;
  }
  .hero .preview {
    min-block-size: 12rem;
  }
  /* The site's base styles are unlayered, so they would win over the theme's layered rules: inside
     a demo they step back to the theme (lu.theme, lu.core) and the browser's defaults. */
  .preview :deep(*),
  .preview :deep(*::before),
  .preview :deep(*::after) {
    all: revert-layer;
  }
  .note {
    padding: $space.xs $space.md;
    border-inline: 1px solid $color.border;
    background: $color.sunken;
    color: $color.muted;
    font-size: $text.sm;
  }
  .demo > .note:first-child {
    border-block-start: 1px solid $color.border;
  }
  .hero .note {
    padding-inline: 0;
    border: 0;
    background: none;
  }

  /* Two equal columns that a long label ("Autocomplete") cannot widen: it breaks instead, at 320 px
     with WCAG's text spacing (1.4.10, 1.4.12) and in wider fallback fonts (DejaVu Sans on Linux,
     where Inter is not installed). */
  .adjacent {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: $space.md;
    margin-block-start: $space.xxl;
    border-block-start: 1px solid $color.text;
  }
  .adjacent a {
    display: grid;
    align-content: start;
    gap: $space.xs;
    padding-block: $space.lg;
    font-size: $text.xl;
    font-weight: $weight.semibold;
    letter-spacing: -0.03em;
    line-height: $leading.tight;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .adjacent a:hover {
    text-decoration: underline;
  }
  .adjacent [rel="prev"] small::before {
    content: "← ";
  }
  .adjacent .next small::after {
    content: " →";
  }
  .next {
    text-align: end;
  }

  .chunk :deep(code) {
    font-family: $font.mono;
  }
  /* A long path or expression in a sentence or a heading (`Toast.createToastManager`), or a long
     title ("Autocomplete" in Linux's wider fallback font), breaks rather than widening a phone's
     page, also with WCAG's text-spacing overrides (1.4.10, 1.4.12). Table cells keep theirs on one
     line. */
  .chunk :deep(code),
  h1,
  .chunk :deep(h2),
  .chunk :deep(h3),
  .lead :deep(code) {
    overflow-wrap: anywhere;
  }
</style>
