// A small horizontal bar chart for benchmark results: one row per framework, in grey, with
// Lumiose's bar in amber and its row bold (decision-90). Plain HTML and CSS (bar widths are custom properties), so it prerenders and
// reads well without JavaScript; the values are in the text for screen readers.
import { color, font, label, space, text, weight } from "@lumiose/site-kit/tokens";
import type { Bar } from "../content/evidence.ts";

export interface BarChartProps {
  title: string;
  /** What the numbers are, such as "renders/s" or "× fastest". */
  unit: string;
  better: "lower" | "higher";
  bars: readonly Bar[];
  /** Formats a value for display. Default: as is. */
  format?: (value: number) => string;
}

export function BarChart(props: BarChartProps) {
  const max = () => Math.max(...props.bars.map((bar) => bar.value));
  const sorted = () =>
    props.bars.toSorted((a, b) =>
      props.better === "lower" ? a.value - b.value : b.value - a.value,
    );
  const shown = (value: number) => (props.format ?? String)(value);

  return (
    <figure class="chart">
      <figcaption>
        <strong>{props.title}</strong>
        <span>
          {props.unit}, {props.better} is better
        </span>
      </figcaption>
      <ol role="list">
        {sorted().map((bar) => (
          <li class={{ self: bar.self }} style={{ "--size": `${(bar.value / max()) * 100}%` }}>
            <span class="label">{bar.label}</span>
            <span class="track" aria-hidden="true">
              <span class="bar" />
            </span>
            <span class="value">{shown(bar.value)}</span>
          </li>
        ))}
      </ol>
    </figure>
  );
}

<style>
  .chart {
    display: grid;
    align-content: start;
    gap: $space.sm;
    margin: 0;
    padding-block-start: $space.md;
    border-block-start: 1px solid $color.text;
  }
  figcaption {
    display: grid;
    gap: $space.xxs;
  }
  figcaption strong {
    font-size: $text.lg;
    letter-spacing: -0.02em;
  }
  figcaption span {
    color: $color.muted;
    font-family: $label.font;
    font-size: $label.size;
    letter-spacing: $label.tracking;
    line-height: 1.5;
    text-transform: $label.transform;
  }
  ol {
    display: grid;
    gap: $space.xs;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    display: grid;
    grid-template-columns: 6.5rem 1fr 4.5rem;
    align-items: center;
    gap: $space.sm;
    font-size: $text.sm;
  }
  .label {
    color: $color.muted;
  }
  .self .label,
  .self .value {
    color: $color.text;
    font-weight: $weight.semibold;
  }
  .track {
    block-size: 0.5rem;
    background: $color.sunken;
  }
  .bar {
    display: block;
    inline-size: var(--size);
    block-size: 100%;
    background: $color.borderStrong;
  }
  /* No minimum width: equal values draw equal bars, so a zero is empty for every stack. */
  .self .bar {
    background: $color.accent;
  }
  .value {
    font-family: $font.mono;
    font-variant-numeric: tabular-nums;
    text-align: end;
  }
</style>
