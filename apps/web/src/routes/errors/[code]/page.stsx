// Short diagnostic URLs (`/errors/LUM4006`) redirect to the diagnostic's docs page
// (`/docs/errors/LUM4006`, https://lumiose.dev/docs/errors/LUM4006 on GitHub Pages).
// Prerendered as static redirect pages (meta refresh plus a link).
import { href, redirect, type PageProps } from "lumiose";
import { diagnosticCodes } from "../../../content/docs.ts";

export function staticPaths() {
  return diagnosticCodes().map((code) => ({ params: { code } }));
}

export default function ErrorCode(props: PageProps<"/errors/[code]">) {
  return redirect(href("/docs/[[...path]]", { path: `errors/${props.params.code}` }), 301);
}
