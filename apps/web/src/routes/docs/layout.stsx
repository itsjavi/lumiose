// The docs shell (DocsShell): search and the docs navigation, the index's sections. The UI section
// lists the @lumiose/ui pages, at their /ui URLs; the diagnostics fold into a disclosure.
import { href, url, type LayoutProps } from "lumiose";
import { DocsShell, type ShellSection } from "../../components/DocsShell.stsx";
import { docNav, findDoc } from "../../content/docs.ts";
import { sitePath } from "../../lib/site.ts";

export default function DocsLayout(props: LayoutProps<"/docs">) {
  const path = sitePath(url().pathname).replace(/^\/docs\/?|\/$/g, "");
  const current = findDoc(path);
  const sections = (): ShellSection[] => [
    ...docNav().map((section) =>
      section.title === "Diagnostics"
        ? {
            title: section.title,
            codes: true,
            links: section.pages.map((page) => ({
              href: page.url,
              label: page.path === "errors" ? "All diagnostics" : page.title.split(":")[0]!,
              title: page.title,
              current: page === current,
            })),
          }
        : {
            title: section.title,
            links: section.pages.map((page) => ({
              href: page.url,
              label: page.label,
              current: page === current,
            })),
          },
    ),
    {
      title: "See it run",
      links: [
        { href: href("/examples"), label: "Examples" },
        { href: href("/benchmarks"), label: "Benchmarks" },
      ],
    },
  ];

  return (
    <DocsShell label="Docs" sections={sections()}>
      {props.children}
    </DocsShell>
  );
}
