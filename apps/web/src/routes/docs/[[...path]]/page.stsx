// Every docs page (`staticPaths`: the index at /docs, the concept and reference pages, and the
// diagnostics at /docs/errors/LUMxxxx), rendered from packages/lumiose/docs by DocArticle. The UI
// pages moved to /ui (TASK-387): their old URLs below /docs/ui are static redirects.
import { notFound, redirect, type PageProps } from "lumiose";
import { DocArticle } from "../../../components/DocArticle.stsx";
import { docPages, findDoc, uiPages, type DocPage } from "../../../content/docs.ts";

export function staticPaths() {
  return [
    ...docPages().map((page) => ({ params: { path: page.path } })),
    ...uiPages().map((page) => ({ params: { path: `ui${page.path && `/${page.path}`}` } })),
  ];
}

export default function DocsPage(props: PageProps<"/docs/[[...path]]">) {
  const path = props.params.path ?? "";
  const moved = /^ui(?:\/(.*))?$/.exec(path);
  if (moved) return redirect(uiPages().find((page) => page.path === (moved[1] ?? ""))!.url, 301);
  const page = findDoc(path) ?? notFound(`No docs page "${path}".`);
  return (
    <DocArticle
      page={page}
      title={
        page.path === ""
          ? "Lumiose docs: guides, concepts and API reference"
          : `${page.title} · Lumiose docs`
      }
      description={description(page)}
    />
  );
}

/** The meta description of the index and the diagnostics, whose one-line summaries say little. */
function description(page: DocPage): string | undefined {
  if (page.path === "") {
    return "Learn Lumiose: getting started, components, signals, scoped styles, routing, islands, server rendering, and the API and CLI reference.";
  }
  const code = /^errors\/(LUM\d+)$/.exec(page.path)?.[1];
  return code && `Lumiose diagnostic ${code}: ${page.summary} What it means, an example, and how to fix it.`;
}
