// The landing page (decision-90, which amends decision-37): a hero beside one code example that
// runs, four numbered rows, a strip of live @lumiose/ui components and a closing install box, over
// the site's beams of light (the root layout). Everything else is one click deeper: the stack table
// and the charts on /benchmarks, rendering modes and apps on /showcase, tooling in the docs.
//
// Nothing on it moves after the first paint. The code is highlighted on the server; the counter
// under it is the island whose source the panel shows (content/samples.ts), rendered on the server
// at its final size; the UI components are server HTML. The editor lives on /playground only.
import "@lumiose/ui/tabs.css";
import "@lumiose/ui/slider.css";
import "@lumiose/ui/themes/default.css";
import { CopyButton, LinkButton } from "@lumiose/site-kit";
import { color, font, label, layout, motion, space, weight } from "@lumiose/site-kit/tokens";
import { Button } from "@lumiose/ui/button";
import { Slider } from "@lumiose/ui/slider";
import { Switch } from "@lumiose/ui/switch";
import { Tabs } from "@lumiose/ui/tabs";
import { href } from "lumiose";
import { PageMeta } from "../components/PageMeta.tsx";
import { UiPreview } from "../components/UiPreview.stsx";
import { counterHtml, installCommand } from "../content/samples.ts";
import Counter from "../islands/Counter.stsx";
import { site } from "../lib/site.ts";

const docs = (path: string) => href("/docs/[[...path]]", { path });

/** The four rows: what you do with Lumiose, each one sentence and one link. */
const ROWS = [
  {
    title: "Write",
    href: docs("concepts/components"),
    text: (
      <>
        TSX and its styles in one <code>.stsx</code> file, typed by stock TypeScript.
      </>
    ),
  },
  {
    title: "Render",
    href: docs("concepts/rendering-modes"),
    text: <>Each route picks static, server or SPA. The component doesn't change.</>,
  },
  {
    title: "Hydrate",
    href: docs("concepts/islands"),
    text: (
      <>
        Add <code>client:idle</code> where you use a component. It becomes an island.
      </>
    ),
  },
  {
    title: "Measure",
    href: href("/benchmarks"),
    text: <>Compared with the stacks you know, from committed benchmark runs.</>,
  },
];

export default function Home() {
  return (
    <div class="home">
      <PageMeta
        title="Lumiose web framework: feels like React, runs like vanilla JS"
        ogTitle={`Lumiose: ${site.tagline}`}
        description={site.description}
      />

      <section class="hero" aria-labelledby="hero-title">
        <div class="pitch">
          <p class="label">Static sites · Server-side rendering · Islands · SPAs</p>
          <h1 id="hero-title">
            <span class="line">One component model,</span>{" "}
            <span class="line dim">from static pages to full-stack apps</span>
          </h1>
          <p class="lead">
            Write components in TSX with their styles in the same file. Each route picks how it
            renders, with no rewrite.
          </p>
          <div class="cta">
            <LinkButton href={docs("getting-started")} size="lg">
              Get started
            </LinkButton>
            <LinkButton href={href("/playground")} variant="secondary" size="lg">
              Open playground
            </LinkButton>
          </div>
        </div>

        <figure class="code">
          <figcaption class="bar label">
            <span class="file">Counter.stsx</span>
            <span>live</span>
          </figcaption>
          <pre tabindex="0">
            <code innerHTML={counterHtml()} />
          </pre>
          <div class="out">
            <Counter client:load />
            <span class="label">
              <span aria-hidden="true">← </span>try it
            </span>
          </div>
        </figure>
      </section>

      <ol class="rows" role="list">
        {ROWS.map((row, index) => (
          <li>
            <a class="row" href={row.href}>
              <span class="label">{String(index + 1).padStart(2, "0")}</span>
              <h2>{row.title}</h2>
              <p>{row.text}</p>
              <span class="arr" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))}
      </ol>

      <section class="strip" aria-labelledby="ui-title">
        <div>
          <p class="label">@lumiose/ui</p>
          <h2 id="ui-title">Components without opinions.</h2>
          <p>Accessible behaviour on native HTML, in plain black and white. Style them your way.</p>
          <LinkButton href={href("/ui/[[...path]]", { path: "" })} variant="secondary" size="sm">
            Browse components
          </LinkButton>
        </div>
        <ul class="tray" role="list" aria-label="Live components">
          <li>
            <UiPreview id="landing-switch">
              <Switch.Root class="lu-switch" defaultChecked aria-label="Demo switch" />
            </UiPreview>
          </li>
          <li>
            <UiPreview id="landing-tabs">
              <Tabs.Root class="lu-tabs" defaultValue="one">
                <Tabs.List aria-label="Demo tabs">
                  <Tabs.Tab value="one">One</Tabs.Tab>
                  <Tabs.Tab value="two">Two</Tabs.Tab>
                </Tabs.List>
                <Tabs.Panel value="one">First panel</Tabs.Panel>
                <Tabs.Panel value="two">Second panel</Tabs.Panel>
              </Tabs.Root>
            </UiPreview>
          </li>
          <li>
            <UiPreview id="landing-slider">
              <Slider.Root class="lu-slider" defaultValue={40} style="inline-size: 7rem">
                <Slider.Control>
                  <Slider.Track>
                    <Slider.Indicator />
                  </Slider.Track>
                  <Slider.Thumb aria-label="Demo slider" />
                </Slider.Control>
              </Slider.Root>
            </UiPreview>
          </li>
          <li>
            <UiPreview id="landing-button">
              <Button class="lu-button" data-variant="primary">
                Button
              </Button>
            </UiPreview>
          </li>
        </ul>
      </section>

      <section class="end" aria-labelledby="start-title">
        <h2 id="start-title">
          <span class="line">Enlighten your</span> <span class="line">next project.</span>
        </h2>
        <div class="start">
          <div class="install">
            <code>{installCommand}</code>
            <CopyButton client:visible text={installCommand} label="Copy the install command" />
          </div>
          <LinkButton href={docs("")} size="lg">
            Read the docs
          </LinkButton>
        </div>
      </section>
    </div>
  );
}

<style>
  .home {
    max-inline-size: $layout.page;
    margin-inline: auto;
    padding-inline: $layout.gutter;
    padding-block-end: $space.xxl;
  }
  .label {
    margin: 0;
    color: $color.muted;
    font-family: $label.font;
    font-size: $label.size;
    letter-spacing: $label.tracking;
    line-height: 1.3;
    text-transform: $label.transform;
  }
  .line {
    display: block;
  }
  h2 {
    margin: 0;
  }

  /* The hero: the pitch beside the code, both starting on the same top line, with less room above
     than the reference has (user, 2026-11-17). */
  .hero {
    display: grid;
    gap: $space.xxl;
    padding-block: clamp(2.5rem, 5.5vw, 4.5rem) clamp(3rem, 7vw, 5.5rem);
  }
  .hero > * {
    min-inline-size: 0;
  }
  @media (width >= 54rem) {
    .hero {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: 4rem;
      align-items: start;
    }
  }
  /* The pitch starts near the corner the beams fan out from. Its label takes the text colour, and
     the headline's grey line and the lead a stronger grey than the page's (30% of the way to the
     text colour, in each scheme), so they keep 4.5:1 over a beam at its brightest
     (e2e/a11y.e2e.ts measures it). */
  .hero .pitch > .label {
    color: $color.text;
  }
  .dim,
  .lead {
    color: light-dark(#3e3e3e, #bfbfbf);
  }
  h1 {
    margin-block: 1.75rem;
    font-size: clamp(2.5rem, 5.2vw, 4.25rem);
    font-weight: $weight.bold;
    line-height: 0.95;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }
  .lead {
    max-inline-size: 30em;
    margin-block: 0 $space.xl;
    font-size: 1.1875rem;
    line-height: 1.55;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: $space.sm;
  }

  /* The code panel: a title bar, the code, and the row where it runs. */
  .code {
    margin: 0;
    border: 1px solid $color.border;
    background: $color.sunken;
  }
  .bar {
    display: flex;
    justify-content: space-between;
    gap: $space.md;
    padding: $space.sm $space.md;
    border-block-end: 1px solid $color.border;
  }
  /* A file name keeps its case. */
  .file {
    text-transform: none;
  }
  pre {
    margin: 0;
    padding: 1.125rem $space.md;
    overflow-x: auto;
    color: $color.text;
    font-family: $font.mono;
    font-size: 0.8125rem;
    line-height: 1.75;
    tab-size: 2;
  }
  pre:focus-visible {
    outline-offset: -2px;
  }
  pre code {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
  }
  /* Monochrome highlighting: keywords bold, comments grey, emphasis as an amber underline. */
  pre :deep(.tok-keyword) {
    font-weight: $weight.bold;
  }
  pre :deep(.tok-comment) {
    color: $color.muted;
  }
  pre :deep(u) {
    text-decoration: underline 2px $color.accent;
    text-underline-offset: 4px;
  }
  .out {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.875rem;
    min-block-size: 4.625rem;
    padding: 1.125rem $space.md;
    border-block-start: 1px solid $color.border;
    background: $color.bg;
  }
  /* The counter brings its own padding and border (the code above); the page sets its line. */
  .out :deep(button) {
    border-color: $color.borderStrong;
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    line-height: 1.25;
  }
  .out :deep(button:hover) {
    border-color: $color.text;
  }

  /* The rows: each one a link across the page. */
  .rows {
    margin: 0;
    padding: 0;
    border-block-start: 1px solid $color.text;
  }
  .row {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) 1.5rem;
    gap: $space.md;
    align-items: center;
    padding-block: 1.625rem;
    border-block-end: 1px solid $color.border;
    color: $color.text;
    text-decoration: none;
  }
  .row:hover {
    background: $color.sunken;
  }
  .row:focus-visible {
    outline-offset: -2px;
  }
  .row h2 {
    font-size: 1.625rem;
    font-weight: $weight.semibold;
    letter-spacing: -0.03em;
    line-height: 1.55;
  }
  .row p {
    display: none;
    margin: 0;
    color: $color.muted;
  }
  .row code {
    padding: 0;
    border: 0;
    border-block-end: 1px solid $color.border;
    background: none;
    color: inherit;
    font-family: $font.mono;
    font-size: 0.88em;
  }
  .arr {
    font-size: 1.25rem;
    transition:
      color $motion.fast,
      translate $motion.fast;
  }
  .row:hover .arr {
    color: $color.accent;
    translate: 4px 0;
  }
  @media (width >= 54rem) {
    .row {
      grid-template-columns: 5rem minmax(0, 1fr) minmax(0, 1.3fr) 2.5rem;
      gap: $space.xl;
    }
    .row p {
      display: block;
    }
  }

  /* The UI strip: the pitch beside a tray of four live components. */
  .strip {
    display: grid;
    gap: $space.xl;
    align-items: center;
    margin-block-start: 6rem;
  }
  .strip > * {
    min-inline-size: 0;
  }
  .strip h2,
  .end h2 {
    font-size: clamp(2rem, 1.5rem + 2vw, 2.5rem);
    letter-spacing: -0.04em;
    line-height: 1.02;
  }
  .strip h2 {
    margin-block: 0.875rem $space.sm;
  }
  .strip p:not(.label) {
    margin-block: 0 1.25rem;
    color: $color.muted;
  }
  /* Hairlines between the cells, drawn by each cell's end borders, in two columns or four. */
  .tray {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    border-block-start: 1px solid $color.border;
    border-inline-start: 1px solid $color.border;
  }
  .tray li {
    display: grid;
    place-items: center;
    min-inline-size: 0;
    block-size: 8.125rem;
    padding-inline: $space.xs;
    border-block-end: 1px solid $color.border;
    border-inline-end: 1px solid $color.border;
    background: var(--lu-background);
  }
  @media (width >= 54rem) {
    .strip {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: 4rem;
    }
    .tray {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* The closing box. */
  .end {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: $space.xl;
    margin-block-start: 6.875rem;
    padding: clamp(1rem, 5vw, 3rem);
    border: 1px solid $color.border;
  }
  .start {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: $space.sm;
    min-inline-size: 0;
    max-inline-size: 100%;
  }
  .install {
    display: flex;
    align-items: center;
    gap: $space.xs;
    min-inline-size: 0;
    max-inline-size: 100%;
    min-block-size: 2.875rem;
    padding-inline: $space.md $space.xs;
    border: 1px solid $color.border;
  }
  .install code {
    padding: 0;
    border: 0;
    background: none;
    overflow-x: auto;
    color: $color.text;
    font-family: $font.mono;
    font-size: clamp(0.75rem, 3.1vw, 0.9375rem);
    white-space: nowrap;
  }
  .install code::before {
    content: "$ ";
    color: $color.accent;
  }
</style>
