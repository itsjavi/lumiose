// Unknown URLs (dist/client/404.html on a static host).
import { LinkButton } from "@lumiose/site-kit";
import { color, label, layout, space, text } from "@lumiose/site-kit/tokens";
import { href, Title } from "lumiose";

export default function NotFound() {
  return (
    <section class="missing">
      <Title>Page not found · Lumiose</Title>
      <p class="code">404</p>
      <h1>This page is not here</h1>
      <p>
        It may have moved when the docs were reorganised. Search the docs or start from the top.
      </p>
      <div class="actions">
        <LinkButton href={href("/docs/[[...path]]", { path: "" })}>Docs</LinkButton>
        <LinkButton href={href("/")} variant="secondary">
          Home
        </LinkButton>
      </div>
    </section>
  );
}

<style>
  .missing {
    display: grid;
    justify-items: start;
    gap: $space.md;
    max-inline-size: $layout.page;
    margin-inline: auto;
    padding: $space.xxxl $layout.gutter;
  }
  .code {
    font-family: $label.font;
    font-size: $label.size;
    letter-spacing: $label.tracking;
  }
  h1 {
    margin: 0;
    font-size: $text.display;
    line-height: 0.95;
    letter-spacing: -0.05em;
    text-wrap: balance;
  }
  p {
    max-inline-size: 40ch;
    margin: 0;
    color: $color.muted;
    font-size: $text.lg;
  }
  .actions {
    display: flex;
    gap: $space.sm;
    margin-block-start: $space.md;
  }
</style>
