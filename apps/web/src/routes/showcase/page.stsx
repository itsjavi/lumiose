// /showcase: the rendering modes with the apps that use them (moved from the landing,
// decision-37), the real apps (in their own repository and deployment, decision-73), then the demos
// with dummy content, built by scripts/site.ts below /demos/<slug>/ (TASK-163, TASK-215).
import { Card } from "@lumiose/site-kit";
import { color, font, layout, space, text } from "@lumiose/site-kit/tokens";
import { href } from "lumiose";
import { PageMeta } from "../../components/PageMeta.tsx";
import { PageHead, ShowcaseGrid } from "../../components/Showcase.stsx";
import { demos, DOTMATRIX, renderingModes, REPOSITORY, showcase } from "../../content/showcase.ts";
import { usedBy } from "../../content/used-by.ts";

const usedByFile = `${REPOSITORY}/blob/main/apps/web/src/content/used-by.ts`;

export default function Showcase() {
  return (
    <div class="page">
      <PageMeta
        title="Showcase: apps made with Lumiose"
        description="Apps made with Lumiose, running live with their code: the Dotmatrix chiptune studios, a static travel journal, and every rendering mode Lumiose has."
      />
      <PageHead kicker="Showcase" title="Made with Lumiose">
        <p>
          Complete apps, each built with <code>lumiose build</code> and published as static files:
          the Dotmatrix apps from their <a href={DOTMATRIX}>own repository</a>, and the samples
          from the <a href={`${REPOSITORY}/tree/main/examples`}>examples folder</a>. Start your
          own with the{" "}
          <a href={href("/docs/[[...path]]", { path: "getting-started" })}>getting started</a>{" "}
          guide.
        </p>
      </PageHead>

      <section class="block" aria-labelledby="modes-title">
        <h2 id="modes-title">Every rendering mode</h2>
        <p>Each route picks how it renders, and the same components work in all four.</p>
        <div class="modes">
          {renderingModes().map((mode) => (
            <Card title={mode.title} eyebrow={mode.option} href={mode.docs}>
              <p>{mode.description}</p>
              <p class="apps">
                Running:{" "}
                {mode.apps.map((app, index) => (
                  <>
                    {index > 0 && ", "}
                    <a href={app.href}>{app.label}</a>
                  </>
                ))}
              </p>
            </Card>
          ))}
        </div>
      </section>

      <section class="block" aria-labelledby="apps-title">
        <h2 id="apps-title">Apps</h2>
        <ShowcaseGrid items={showcase()} open="Open the app" />
      </section>

      <section class="block" aria-labelledby="demos-title">
        <h2 id="demos-title">Demos</h2>
        <p>Smaller samples with placeholder content, to read alongside their code.</p>
        <ShowcaseGrid items={demos()} open="Open the demo" />
      </section>

      <section class="block" id="used-by" aria-labelledby="used-by-title">
        <h2 id="used-by-title">Used by</h2>
        {usedBy.length === 0 ? (
          <p>No external production apps yet.</p>
        ) : (
          <ul class="used-by" role="list">
            {usedBy.map((app) => (
              <li>
                <a href={app.url}>{app.name}</a>: {app.description}
              </li>
            ))}
          </ul>
        )}
        <p>
          Running Lumiose in production? Add your app: append its name, URL and a one-line
          description to <a href={usedByFile}>apps/web/src/content/used-by.ts</a> and open a pull
          request. The list counts apps the Lumiose maintainer does not run, and it is how the{" "}
          <a href={href("/docs/[[...path]]", { path: "stability" })}>stability rules</a> know that
          Lumiose has real users: there is no telemetry.
        </p>
      </section>
    </div>
  );
}

<style>
  .page {
    max-inline-size: $layout.page;
    margin-inline: auto;
    padding: $space.xl $layout.gutter $space.xxl;
  }
  .block {
    display: grid;
    gap: $space.sm;
    margin-block-end: $space.xxl;
  }
  .block h2,
  .block > p {
    margin: 0;
  }
  .modes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: $space.md;
  }
  .modes p {
    margin: 0;
  }
  .apps {
    margin-block-start: $space.xs;
    color: $color.muted;
    font-size: $text.sm;
  }
  .used-by {
    margin: 0;
    padding-inline-start: $space.lg;
  }
  .apps a {
    position: relative;
    z-index: 1;
    font-family: $font.sans;
  }
</style>
