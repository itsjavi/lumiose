// /benchmarks: the benchmark pages (TASK-163). The fullstack results viewer is copied by
// scripts/site.ts to /benchmarks/fullstack/; the js-framework-benchmark results are a page of
// this site, with the Lumiose benchmark app below it.
import { layout, space } from "@lumiose/site-kit/tokens";
import { Meta, Title } from "lumiose";
import { PageHead, ShowcaseGrid } from "../../components/Showcase.stsx";
import { benchmarks, REPOSITORY } from "../../content/showcase.ts";

export default function Benchmarks() {
  return (
    <div class="page">
      <Title>Benchmarks · Lumiose</Title>
      <Meta name="description" content="Lumiose's benchmarks and their latest committed results." />
      <PageHead kicker="Measured, not claimed" title="Benchmarks">
        <p>
          The latest committed runs of Lumiose's benchmarks, with the machine and date of each. The
          runners and every app measured are in the{" "}
          <a href={`${REPOSITORY}/tree/main/benchmarks`}>benchmarks folder</a>.
        </p>
      </PageHead>
      <ShowcaseGrid items={benchmarks()} open="See the results" />

      <style>
        .page {
          max-inline-size: $layout.page;
          margin-inline: auto;
          padding: $space.xl $layout.gutter $space.xxl;
        }
      </style>
    </div>
  );
}
