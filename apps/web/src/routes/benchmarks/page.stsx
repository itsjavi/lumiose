// /benchmarks: the stack comparison table (moved from the landing, decision-90), the latest results
// as charts (decision-37), then the benchmark pages (TASK-163). The fullstack results viewer is
// copied by scripts/site.ts to /benchmarks/fullstack/; the js-framework-benchmark results are a
// page of this site, with the Lumiose benchmark app below it. Every number comes from the committed
// results (evidence.ts, stacks.ts).
import { bp, color, layout, space, text } from "@lumiose/site-kit/tokens";
import { href } from "lumiose";
import { BarChart } from "../../components/BarChart.stsx";
import { PageMeta } from "../../components/PageMeta.tsx";
import { PageHead, ShowcaseGrid } from "../../components/Showcase.stsx";
import { StackTable } from "../../components/StackTable.stsx";
import { evidence } from "../../content/evidence.ts";
import { benchmarks, REPOSITORY } from "../../content/showcase.ts";
import { ASTRO_NOTE, stacks, tableNote } from "../../content/stacks.ts";
import { link } from "../../lib/site.ts";

const fixed = (digits: number) => (value: number) => value.toFixed(digits);

export default function Benchmarks() {
  const results = evidence();
  const rows = stacks();

  return (
    <div class="page">
      <PageMeta
        title="Benchmarks: Lumiose vs Next.js, SvelteKit, Astro and more"
        description="Lumiose's latest committed benchmark runs: JavaScript shipped, client update speed and server rendering, against Next.js, SvelteKit, Astro, React and more."
      />
      <PageHead kicker="Measured, not claimed" title="Benchmarks">
        <p>
          The latest committed runs of Lumiose's benchmarks, with the machine and date of each. The
          runners and every app measured are in the{" "}
          <a href={`${REPOSITORY}/tree/main/benchmarks`}>benchmarks folder</a>.
        </p>
      </PageHead>

      <section class="block" id="stacks" aria-labelledby="stacks-title">
        <h2 id="stacks-title">Compare the stacks</h2>
        <StackTable rows={rows} labelledBy="stacks-title" />
        <p class="note">{tableNote(results, rows)}</p>
        <p class="note">{ASTRO_NOTE}</p>
      </section>

      <section class="block" aria-labelledby="results-title">
        <h2 id="results-title">Latest results</h2>
        <div class="charts">
          <BarChart
            title="JS on a server page"
            unit="kB loaded by the issue tracker's home page, brotli"
            better="lower"
            bars={results.serverJs}
            format={(value) => Math.round(value).toString()}
          />
          <BarChart
            title="Client updates"
            unit="Weighted geometric mean of CPU time, × the fastest"
            better="lower"
            bars={results.cpu}
            format={fixed(2)}
          />
          <BarChart
            title="Server rendering"
            unit="Renders per second of a 5,000-component page"
            better="higher"
            bars={results.ssr}
            format={(value) => Math.round(value).toString()}
          />
          <BarChart
            title="Bundle size"
            unit="Compressed kB, runtime and benchmark app"
            better="lower"
            bars={results.size}
            format={fixed(1)}
          />
        </div>
        <p class="note">
          Fullstack: {results.fullstackRun}, in the{" "}
          <a href={link("/benchmarks/fullstack/")}>results viewer</a> (
          <a href={href("/benchmarks/fullstack-comparison")}>method and raw data</a>). Client:{" "}
          {results.clientRun},
          in the{" "}
          <a href={href("/benchmarks/js-framework-benchmark")}>js-framework-benchmark report</a>.
          Server: {results.serverRun}, in <code>benchmarks/ssr/RESULTS.md</code>.
        </p>
      </section>

      <section class="block" aria-labelledby="pages-title">
        <h2 id="pages-title">The benchmarks</h2>
        <ShowcaseGrid items={benchmarks()} open="See the results" />
      </section>
    </div>
  );
}

<style>
  .page {
    max-inline-size: $layout.page;
    margin-inline: auto;
    padding: 0 $layout.gutter $space.xxl;
  }
  .block {
    display: grid;
    /* The stack table scrolls inside its column instead of widening the page. */
    grid-template-columns: minmax(0, 1fr);
    gap: $space.md;
    margin-block-end: $space.xxxl;
  }
  h2 {
    margin: 0;
    font-size: $text.xxl;
    line-height: 1.05;
    letter-spacing: -0.035em;
  }
  .charts {
    display: grid;
    gap: $space.xl;
  }
  @media (width >= $bp.md) {
    .charts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .note {
    max-inline-size: 62rem;
    margin: 0;
    color: $color.muted;
    font-size: $text.xs;
  }
</style>
