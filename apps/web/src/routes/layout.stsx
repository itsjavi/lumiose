// Root layout: the beams of light behind the page (components/Beams.stsx), brighter on the landing
// than on inner pages, then the site header (with the theme toggle), the page and the footer, all
// from @lumiose/site-kit. Every route is prerendered (`lumiose({ mode: "static" })`), so the site deploys
// as plain files.
import { Footer, GitHubLink, SiteHeader } from "@lumiose/site-kit";
import { color, radius, space } from "@lumiose/site-kit/tokens";
import { href, url, type LayoutProps } from "lumiose";
import { Beams, BeamsPause } from "../components/Beams.stsx";
import { footerColumns, link, navLinks, REPOSITORY, sitePath, site } from "../lib/site.ts";

export default function RootLayout(props: LayoutProps<"/">) {
  const path = sitePath(url().pathname);
  const current = link(path);

  return (
    <div class="site">
      <Beams dim={path !== "/"} />
      <a class="skip" href="#content">
        Skip to content
      </a>
      <SiteHeader
        class="bar"
        links={navLinks}
        current={current}
        home={href("/")}
        actions={<GitHubLink href={REPOSITORY} />}
      />
      <main id="content">{props.children}</main>
      <Footer columns={footerColumns} tagline={site.tagline}>
        MIT licensed. This site is a static Lumiose app built with @lumiose/site-kit.
        <BeamsPause />
      </Footer>
    </div>
  );
}

<style>
  .site {
    /* The beams are placed in it, behind its content (`z-index: -1` inside this stacking context). */
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    min-block-size: 100dvh;
  }
  /* The header lets the page show through: at 85% of the background its grey links keep 4.5:1
     over the darkest content that scrolls under it, a black button in the light theme (4.96:1;
     the kit's 70% gives 3.34:1). e2e/a11y.e2e.ts flattens it to the same mix. */
  .site .bar {
    background: color-mix(in srgb, $color.bg 85%, transparent);
  }
  main {
    flex: 1;
  }
  .skip {
    position: absolute;
    inset-block-start: $space.xs;
    inset-inline-start: $space.xs;
    z-index: 100;
    padding: $space.xs $space.sm;
    border-radius: $radius.md;
    background: $color.accent;
    color: $color.accentFg;
    translate: 0 -200%;
  }
  .skip:focus-visible {
    translate: 0 0;
  }
</style>

<style global>
  /* Same-origin navigations cross-fade (cross-document View Transitions). */
  @view-transition {
    navigation: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    @view-transition {
      navigation: none;
    }
  }
</style>
