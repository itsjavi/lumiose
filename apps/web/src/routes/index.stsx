// The landing page (decision-37): the hero on a night stage lit by the LightField island, the stack
// comparison table, four short sections and a closing call. Every number comes from the committed
// results through content modules (content/evidence.ts, content/stacks.ts), and the compiled output
// from this version's compiler (content/samples.ts), all checked by content.test.ts. The depth lives
// elsewhere: charts on /benchmarks, rendering modes and apps on /showcase, tooling in the docs.
import { CodeBlock, CopyButton, LinkButton } from "@lumiose/site-kit";
import { highlight } from "@lumiose/site-kit/highlight";
import {
  bp,
  color,
  font,
  layout,
  leading,
  radius,
  space,
  text,
  weight,
} from "@lumiose/site-kit/tokens";
import { href, Meta, Title } from "lumiose";
import { BarChart } from "../components/BarChart.stsx";
import { LightField } from "../islands/LightField.stsx";
import { Playground } from "../islands/Playground.stsx";
import { evidence } from "../content/evidence.ts";
import { prerelease, version } from "../content/release.ts";
import {
  checkText,
  counterCss,
  counterOutput,
  counterSource,
  installCommand,
} from "../content/samples.ts";
import { renderingModes } from "../content/showcase.ts";
import {
  type Cell,
  COLUMNS,
  DOWNLOADS_PERIOD,
  SERVER_SPEED,
  factor,
  kilobytes,
  stacks,
} from "../content/stacks.ts";
import { site } from "../lib/site.ts";

interface StaticTab {
  label: string;
  title: string;
  lang: string;
  code: string;
}

/** Tabs that work without JavaScript: radio buttons pick the panel shown (CSS `:checked`). */
function StaticTabs(props: { name: string; label: string; items: StaticTab[] }) {
  return (
    <div class="static-tabs">
      <fieldset class="choices">
        <legend class="visually-hidden">{props.label}</legend>
        {props.items.map((item, i) => (
          <label>
            <input type="radio" name={props.name} value={String(i)} checked={i === 0} />
            <span>{item.label}</span>
          </label>
        ))}
      </fieldset>
      <div class="static-panels">
        {props.items.map((item) => (
          <CodeBlock
            code={item.code}
            lang={item.lang}
            title={item.title}
            highlight={highlight}
            copy={false}
          />
        ))}
      </div>
    </div>
  );
}

function TableCell(props: { cell: Cell }) {
  return props.cell.kind === "measuring" ? (
    <span class="pending">measuring</span>
  ) : (
    <span class={[props.cell.kind, props.cell.kind === "fact" && props.cell.tone]}>
      {props.cell.text}
    </span>
  );
}

/** A section's link: "Label →", with the arrow hidden from screen readers. */
function More(props: { href: string; children: JSX.Element }) {
  return (
    <a class="more" href={props.href}>
      {props.children} <span aria-hidden="true">→</span>
    </a>
  );
}

export default function Home() {
  const results = evidence();
  const self = (bars: { self: boolean; value: number }[]) => bars.find((bar) => bar.self)!.value;
  const vanilla = results.cpuByColumn["vanillajs"];
  const rows = stacks();
  const measuring = rows.some((row) =>
    [row.fullStack, row.styles, row.serverJs, row.clientSpeed, row.rendering, row.requests].some(
      (cell) => cell.kind === "measuring",
    ),
  );
  const getStarted = href("/docs/[...path]", { path: "getting-started" });

  return (
    <div class="home">
      <Title>{`Lumiose: ${site.tagline}`}</Title>
      <Meta name="description" content={site.description} />
      <Meta property="og:title" content="Lumiose" />
      <Meta property="og:description" content={site.description} />

      {/* A night stage in both themes: the light needs the dark. */}
      <section class="stage" data-theme="dark" aria-labelledby="hero-title">
        <LightField client:idle />
        <div class="scrim" aria-hidden="true" />
        <div class="hero">
          <p class="eyebrow">Static sites · Server-side rendering · Islands · SPAs</p>
          <h1 id="hero-title">
            <span class="line">The best of every stack,</span>{" "}
            <span class="line lit">in one framework</span>
          </h1>
          <p class="lead">
            Lumiose is a web framework for everything from static sites and SPAs to full-stack apps:{" "}
            <strong>TSX with scoped CSS built in</strong>, signals, and{" "}
            <strong>0 kB of JavaScript</strong> until a page needs it.
          </p>
          <div class="actions">
            <LinkButton href={getStarted} size="lg">
              Get started
            </LinkButton>
            <LinkButton href="#compare" variant="secondary" size="lg">
              Compare the stacks
            </LinkButton>
            <LinkButton href={href("/playground")} variant="secondary" size="lg">
              Playground
            </LinkButton>
          </div>
          <div class="install">
            <code>
              <span class="prompt" aria-hidden="true">
                ${" "}
              </span>
              {installCommand}
            </code>
            <CopyButton client:visible text={installCommand} label="Copy the install command" />
          </div>
          {prerelease && <p class="badge">{version} · pre-release</p>}
          <ul class="proof" role="list">
            <li>
              <strong>{factor(self(results.cpu))}</strong>
              <span>vanilla JS on js-framework-benchmark</span>
            </li>
            <li>
              <strong>{kilobytes(self(results.serverJs))}</strong>
              <span>JavaScript on server-rendered pages</span>
            </li>
            <li>
              <strong>{kilobytes(self(results.size))}</strong>
              <span>runtime and app, compressed</span>
            </li>
          </ul>
        </div>
      </section>

      <section class="section" id="compare" aria-labelledby="compare-title">
        <p class="kicker">Compare the stacks</p>
        <h2 id="compare-title">{site.tagline}</h2>
        <p class="intro">
          Components, styles, routing and the server in one project, measured against the stacks you
          already know.
        </p>
        <div class="table" role="region" aria-labelledby="compare-title" tabindex="0">
          <table>
            <caption class="visually-hidden">
              Lumiose compared with other web framework stacks
            </caption>
            <thead>
              <tr>
                {Object.values(COLUMNS).map((label) => (
                  <th scope="col">{label}</th>
                ))}
                {/* Over two cells, each self-describing by its unit: renders/s, then req/s. */}
                <th scope="col" colspan="2">
                  {SERVER_SPEED}
                </th>
              </tr>
            </thead>
            <tbody>
              {rows.map((row) => (
                <tr class={{ self: row.self === true }}>
                  <th scope="row">{row.stack}</th>
                  <td>
                    <TableCell cell={row.fullStack} />
                  </td>
                  <td>
                    <TableCell cell={row.styles} />
                  </td>
                  <td class="number">
                    <TableCell cell={row.serverJs} />
                  </td>
                  <td class="number">
                    <TableCell cell={row.clientSpeed} />
                  </td>
                  <td class="number">
                    <TableCell cell={row.rendering} />
                  </td>
                  <td class="number">
                    <TableCell cell={row.requests} />
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="note">
          JS on a server page: what the fullstack comparison's issue tracker loads for its home
          page, brotli ({results.fullstackRun}). Client speed: js-framework-benchmark's weighted
          factor, where 1.00 is the fastest framework in the run
          {vanilla === undefined ? "" : ` and vanilla JS scores ${vanilla.toFixed(2)}`}. Server
          speed: renders per second of the SSR benchmark's 5,000-component page to an HTML string (
          {results.serverRun}), then requests per second on the fullstack comparison's home page
          {results.requestsRun === "" ? "" : ` (${results.requestsRun})`}. Both React rows use
          React's client and rendering entries.
          {measuring ? ' "measuring": the port or benchmark entry is being added.' : ""} Rows after
          Lumiose are ordered by npm downloads of each stack's main package (
          {DOWNLOADS_PERIOD}). Method and every run: <a href={href("/benchmarks")}>benchmarks</a>.
        </p>
        <p class="note">Astro's interactive islands need a second UI framework.</p>
      </section>

      <section class="section" aria-labelledby="why-title">
        <p class="kicker">Why it feels light</p>
        <h2 id="why-title">Four things, each one click deep</h2>
        <div class="boxes">
          <article class="box wide" aria-labelledby="familiar-title">
            <div class="copy">
              <h3 id="familiar-title">Familiar to write</h3>
              <p>
                A <code>.stsx</code> file is React-like JSX with scoped CSS built in: one{" "}
                <code>&lt;style&gt;</code> at the end of the file serves every component in it,
                typed by stock TypeScript. Edit the sample: it compiles in your browser.
              </p>
              <More href={href("/playground")}>Open the playground</More>
            </div>
            <div class="live-demo">
              {/* The live editor loads (compiler, WebAssembly) when it scrolls into view; until
                  then, and without JavaScript, the sample and its output show as static tabs. */}
              <Playground client:visible embedded code={counterSource}>
                <StaticTabs
                  name="counter-view"
                  label="Counter sample"
                  items={[
                    { label: "You write", title: "App.stsx", lang: "stsx", code: counterSource },
                    { label: "JS output", title: "App.js", lang: "js", code: counterOutput },
                    { label: "CSS output", title: "App.css", lang: "css", code: counterCss },
                  ]}
                />
              </Playground>
            </div>
          </article>

          <article class="box wide" aria-labelledby="modes-title">
            <h3 id="modes-title">Every rendering mode</h3>
            <p>Choose per route, from static to SPA: the same components work in all four.</p>
            <ol class="modes" role="list">
              {renderingModes().map((mode) => (
                <li class="mode">
                  <strong>{mode.title}</strong>
                  <span>{mode.summary}</span>
                  <ul class="apps" role="list">
                    {mode.apps.map((app) => (
                      <li>
                        <a href={app.href}>{app.label}</a>
                      </li>
                    ))}
                  </ul>
                </li>
              ))}
            </ol>
            <More href={href("/showcase")}>See the showcase</More>
          </article>

          <article class="box" aria-labelledby="fast-title">
            <h3 id="fast-title">Light and fast, measured</h3>
            <p>
              The same issue tracker built three ways: the JavaScript a server-rendered page loads.
            </p>
            <BarChart
              title="JS on a server page"
              unit="kB, brotli"
              better="lower"
              bars={results.serverJs}
              format={(value) => kilobytes(value).replace(" kB", "")}
            />
            <More href={href("/benchmarks")}>All benchmarks</More>
          </article>

          <article class="box" aria-labelledby="explicit-title">
            <h3 id="explicit-title">Explicit, for you and your agent</h3>
            <p>
              No hidden machinery: client boundaries where you write them, every diagnostic with a{" "}
              <code>LUMxxxx</code> code and a fix, and the docs in the package, served to your agent
              over MCP.
            </p>
            <CodeBlock
              code={checkText}
              lang="sh"
              title="terminal"
              highlight={highlight}
              copy={false}
            />
            <More href={href("/docs/[...path]", { path: "reference/mcp" })}>
              Docs and MCP for agents
            </More>
          </article>
        </div>
      </section>

      <section class="section closing" aria-labelledby="start-title">
        <p class="kicker">Start</p>
        <h2 id="start-title">Enlighten your next project.</h2>
        <div class="actions">
          <LinkButton href={getStarted} size="lg">
            Get started
          </LinkButton>
          <LinkButton
            href={href("/docs/[...path]", { path: "coming-from-react" })}
            variant="secondary"
            size="lg"
          >
            Coming from React
          </LinkButton>
        </div>
      </section>
    </div>
  );
}

<style>
  .home {
    background: $color.bg;
  }

  /* The stage: the CSS light is the fallback, under the LightField canvas once it draws. */
  .stage {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background:
      radial-gradient(50% 70% at 82% 8%, rgb(255 191 107 / 0.32), transparent 60%),
      radial-gradient(70% 90% at 75% 0%, rgb(143 132 255 / 0.28), transparent 70%), #07061a;
    /* The copy is lighter than the site's dark theme, so it reads over the brightest frames. */
    --lm-muted: #cfcee6;
    color: $color.text;
    /* A horizon of light where the night meets the page. */
    border-block-end: 1px solid $color.border;
    border-image: linear-gradient(
        90deg,
        transparent,
        color-mix(in oklab, $color.glowA 70%, transparent) 30%,
        color-mix(in oklab, $color.glowB 70%, transparent) 70%,
        transparent
      )
      1;
  }
  /* Keeps the copy readable over any frame of the light (decision-39): dark where the text is,
     clear where the light is. Phones stack the copy across the whole width, so it covers more. */
  .scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      rgb(7 6 26 / 0.9) 0%,
      rgb(7 6 26 / 0.82) 50%,
      rgb(7 6 26 / 0.72) 64%,
      rgb(7 6 26 / 0) 92%
    );
  }
  @media (width < $bp.lg) {
    .scrim {
      background: linear-gradient(
        180deg,
        rgb(7 6 26 / 0) 0,
        rgb(7 6 26 / 0.84) 8rem,
        rgb(7 6 26 / 0.88) 100%
      );
    }
  }
  .hero,
  .section {
    max-inline-size: $layout.page;
    margin-inline: auto;
    padding-inline: $layout.gutter;
  }
  .hero {
    display: grid;
    justify-items: start;
    gap: $space.lg;
    /* Room at the bottom for the pause button. */
    padding-block: $space.xxxl calc($space.xxxl + $space.lg);
  }
  /* Narrow screens give the light the top of the stage; the copy starts below it. */
  @media (width < $bp.lg) {
    .hero {
      padding-block-start: 9rem;
    }
  }
  .eyebrow,
  .kicker {
    margin: 0;
    font-family: $font.mono;
    font-size: $text.sm;
    font-weight: $weight.semibold;
  }
  .eyebrow {
    color: $color.glowText;
  }
  .kicker {
    color: $color.accentText;
  }
  h1 {
    margin: 0;
    max-inline-size: 16ch;
    font-size: clamp(2.6rem, 1.2rem + 4.2vw, 4.75rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }
  .line {
    display: block;
  }
  /* The headline's light sweep: CSS only, once, and not under reduced motion. */
  .lit {
    background-image:
      linear-gradient(100deg, transparent 38%, rgb(255 255 255 / 0.95) 50%, transparent 62%),
      linear-gradient(90deg, #ffd9a3 0%, $color.glowB 30%, #fff1dc 60%, #b8b0ff 100%);
    background-size:
      300% 100%,
      100% 100%;
    background-position:
      -30% 0,
      0 0;
    background-repeat: no-repeat;
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    animation: sweep 1.8s cubic-bezier(0.45, 0, 0.55, 1) 0.5s both;
  }
  @keyframes sweep {
    from {
      background-position:
        120% 0,
        0 0;
    }
    to {
      background-position:
        -30% 0,
        0 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lit {
      animation: none;
    }
  }
  .lead {
    margin: 0;
    max-inline-size: 58ch;
    color: $color.muted;
    font-size: clamp(1.05rem, 0.98rem + 0.3vw, 1.2rem);
    line-height: 1.55;
  }
  .lead strong {
    color: $color.text;
    font-weight: $weight.semibold;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: $space.sm;
  }
  .install {
    display: flex;
    align-items: center;
    gap: $space.xs;
    max-inline-size: 100%;
    padding: $space.xxs $space.xxs $space.xxs $space.md;
    border: 1px solid $color.border;
    border-radius: $radius.md;
    background: color-mix(in oklab, $color.bg 75%, transparent);
    font-size: $text.sm;
  }
  .install code {
    padding: 0;
    border: 0;
    background: none;
    overflow-x: auto;
    color: $color.text;
    white-space: nowrap;
  }
  .prompt {
    color: $color.glowText;
  }
  .badge {
    margin: 0;
    padding: 0.1rem $space.xs;
    border: 1px solid $color.borderStrong;
    border-radius: $radius.pill;
    color: $color.muted;
    font-family: $font.mono;
    font-size: $text.xs;
  }
  .proof {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    inline-size: min(100%, 52rem);
    margin: $space.md 0 0;
    padding: 0;
    border-block-start: 1px solid $color.border;
  }
  .proof li {
    display: grid;
    align-content: start;
    gap: $space.xxs;
    padding: $space.md $space.lg 0 0;
  }
  .proof li + li {
    padding-inline-start: $space.lg;
    border-inline-start: 1px solid $color.border;
  }
  .proof strong {
    color: #fff4e3;
    font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.4rem);
    font-weight: $weight.bold;
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-shadow: 0 0 24px rgb(255 191 107 / 0.55);
  }
  .proof span {
    color: $color.muted;
    font-size: $text.sm;
    line-height: $leading.snug;
  }
  @media (width < $bp.md) {
    .proof {
      grid-template-columns: minmax(0, 1fr);
    }
    .proof li,
    .proof li + li {
      padding: $space.sm 0;
      border-inline-start: 0;
    }
    .proof li + li {
      border-block-start: 1px solid $color.border;
    }
  }

  .section {
    padding-block: $space.xxxl;
  }
  .section > h2 {
    margin-block: $space.xs 0;
    font-size: clamp(1.8rem, 1.4rem + 1.6vw, 2.6rem);
    line-height: 1.1;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .intro {
    max-inline-size: 62ch;
    margin-block: $space.sm 0;
    color: $color.muted;
    font-size: $text.lg;
  }

  /* The stack table. */
  .table {
    margin-block-start: $space.xl;
    overflow-x: auto;
    border: 1px solid $color.border;
    border-radius: $radius.lg;
    background: $color.surface;
  }
  table {
    inline-size: 100%;
    min-inline-size: 58rem;
    border-collapse: collapse;
    font-size: $text.sm;
  }
  th,
  td {
    padding: $space.sm $space.md;
    border-block-end: 1px solid $color.border;
    text-align: start;
    vertical-align: middle;
  }
  thead th {
    color: $color.subtle;
    font-size: $text.xs;
    font-weight: $weight.semibold;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  tbody th {
    font-weight: $weight.semibold;
    white-space: nowrap;
  }
  tbody tr:last-child > * {
    border-block-end: 0;
  }
  .number .measured {
    font-family: $font.mono;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .pending,
  .no {
    color: $color.subtle;
  }
  .pending {
    font-family: $font.mono;
    font-size: $text.xs;
  }
  .yes {
    color: $color.accentText;
  }
  /* Lumiose's row: one flat tint across every cell. */
  tr.self > * {
    background: color-mix(in srgb, $color.accent 10%, $color.surface);
  }
  tr.self .measured {
    font-weight: $weight.bold;
  }
  .note {
    max-inline-size: 62rem;
    margin-block: $space.sm 0;
    color: $color.subtle;
    font-size: $text.xs;
  }

  /* The four sections, each a box with a soft glow in the corner. */
  .boxes {
    display: grid;
    gap: $space.lg;
    margin-block-start: $space.xl;
  }
  @media (width >= $bp.lg) {
    .boxes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .wide {
      grid-column: 1 / -1;
    }
    .box.wide:has(.live-demo) {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: $space.xxl;
    }
  }
  .box {
    display: grid;
    align-content: start;
    gap: $space.md;
    min-inline-size: 0;
    padding: $space.lg;
    border: 1px solid $color.border;
    border-radius: $radius.lg;
    background:
      radial-gradient(
        120% 90% at 100% 0%,
        color-mix(in oklab, $color.glowB 14%, transparent),
        transparent 55%
      ),
      radial-gradient(
        90% 70% at 0% 0%,
        color-mix(in oklab, $color.glowA 10%, transparent),
        transparent 60%
      ),
      $color.surface;
  }
  .copy {
    display: grid;
    align-content: start;
    gap: $space.md;
  }
  .box h3 {
    margin: 0;
    font-size: $text.xl;
    letter-spacing: -0.02em;
  }
  .box p {
    max-inline-size: 60ch;
    margin: 0;
    color: $color.muted;
  }
  .box :deep(.code) {
    margin: 0;
  }
  /* The check output wraps like a terminal, so it reads in a narrow box. */
  .box :deep(.code pre) {
    white-space: pre-wrap;
  }
  .more {
    justify-self: start;
    font-weight: $weight.semibold;
  }
  .live-demo {
    min-inline-size: 0;
  }
  .live-demo :deep(pre) {
    white-space: pre;
  }

  .modes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: $space.sm;
    margin: 0;
    padding: 0;
  }
  .mode {
    display: grid;
    align-content: start;
    gap: $space.xxs;
    padding: $space.md;
    border: 1px solid $color.border;
    border-radius: $radius.md;
    background: $color.bg;
  }
  .mode > span {
    color: $color.muted;
    font-size: $text.sm;
  }
  .apps {
    display: grid;
    gap: $space.xxs;
    margin: $space.xs 0 0;
    padding: 0;
    font-size: $text.sm;
  }
  .apps a {
    display: inline-block;
    min-block-size: 24px;
    font-weight: $weight.medium;
  }

  /* StaticTabs: the label of each radio button is a tab; the checked one shows its panel. */
  .choices {
    display: flex;
    gap: $space.xxs;
    margin: 0;
    padding: 0;
    border: 0;
    border-block-end: 1px solid $color.border;
  }
  .choices label {
    position: relative;
    padding: $space.xs $space.md;
    border-radius: $radius.sm $radius.sm 0 0;
    color: $color.muted;
    font-size: $text.sm;
    font-weight: $weight.medium;
    cursor: pointer;
  }
  .choices label:hover {
    color: $color.text;
  }
  .choices label:has(:checked) {
    color: $color.text;
    box-shadow: inset 0 -2px 0 $color.accent;
  }
  .choices label:has(:focus-visible) {
    outline: 2px solid $color.accent;
    outline-offset: 2px;
  }
  .choices input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .static-panels > :global(*) {
    display: none;
  }
  /* About the live editor's height, so the swap barely moves the page. */
  .static-panels :global(pre) {
    max-block-size: 38rem;
    overflow: auto;
  }
  .static-tabs:has(label:nth-of-type(1) :checked) .static-panels > :global(:nth-child(1)),
  .static-tabs:has(label:nth-of-type(2) :checked) .static-panels > :global(:nth-child(2)),
  .static-tabs:has(label:nth-of-type(3) :checked) .static-panels > :global(:nth-child(3)) {
    display: block;
  }
  .visually-hidden {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .closing {
    display: grid;
    justify-items: start;
    gap: $space.md;
    padding-block-end: calc($space.xxxl + $space.lg);
    border-block-start: 1px solid $color.border;
    background:
      radial-gradient(
        60% 120% at 0% 100%,
        color-mix(in oklab, $color.glowB 12%, transparent),
        transparent 60%
      ),
      radial-gradient(
        50% 100% at 30% 100%,
        color-mix(in oklab, $color.glowA 10%, transparent),
        transparent 70%
      );
  }
  .closing h2 {
    font-size: clamp(2.2rem, 1.6rem + 2.6vw, 3.6rem);
  }
</style>
