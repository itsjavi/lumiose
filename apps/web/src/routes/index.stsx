// The landing page: what Lumiose is, with evidence. The benchmark numbers come from the committed
// results (content/evidence.ts) and the compiled output from this version's compiler
// (content/samples.ts, checked by its test).
import { Callout, Card, CodeBlock, LinkButton, Tabs } from "@lumiose/site-kit";
import { highlight } from "@lumiose/site-kit/highlight";
import {
  bp,
  color,
  font,
  gradient,
  layout,
  leading,
  radius,
  shadow,
  space,
  text,
  weight,
} from "@lumiose/site-kit/tokens";
import { href, Meta, Title } from "lumiose";
import { BarChart } from "../components/BarChart.stsx";
import { ShowcaseGrid } from "../components/Showcase.stsx";
import { examples } from "../content/showcase.ts";
import { evidence } from "../content/evidence.ts";
import {
  checkSample,
  checkSource,
  counterCss,
  counterOutput,
  counterSource,
  createCommands,
} from "../content/samples.ts";
import { link, REPOSITORY, site } from "../lib/site.ts";

const fixed = (digits: number) => (value: number) => value.toFixed(digits);

function Icon(props: { path: string }) {
  return (
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" class="icon">
      <path d={props.path} />
    </svg>
  );
}

const ICONS = {
  static: "M4 5h16v4H4zM4 11h16v4H4zM4 17h10v2H4z",
  server: "M4 4h16v6H4zM4 14h16v6H4zM7 7h2M7 17h2",
  islands: "M12 3a4 4 0 1 1 0 8 4 4 0 0 1 0-8ZM5 14a3 3 0 1 1 0 6 3 3 0 0 1 0-6ZM19 14a3 3 0 1 1 0 6 3 3 0 0 1 0-6Z",
  spa: "M4 12h12M12 6l6 6-6 6",
};

export default function Home() {
  const results = evidence();
  const lumioseCpu = () => results.cpu.find((bar) => bar.self)?.value ?? 0;
  const lumioseSize = () => results.size.find((bar) => bar.self)?.value ?? 0;
  const lumioseSsr = () => results.ssr.find((bar) => bar.self)?.value ?? 0;

  return (
    <div class="home">
      <Title>{`Lumiose: ${site.tagline}`}</Title>
      <Meta name="description" content={site.description} />
      <Meta property="og:title" content="Lumiose" />
      <Meta property="og:description" content={site.description} />

      <section class="hero">
        <p class="eyebrow">TypeScript · .stsx · signals · islands</p>
        <h1>
          Web apps that ship <span class="lit">light</span>
        </h1>
        <p class="lead">
          Lumiose compiles <code>.stsx</code> components, TSX with plain CSS beside it, into direct DOM
          updates driven by signals. Pages render on the server, and only the parts that need to be
          interactive ship JavaScript.
        </p>
        <div class="actions">
          <LinkButton href={href("/docs/[...path]", { path: "getting-started" })} size="lg">
            Get started
          </LinkButton>
          <LinkButton href={href("/docs/[...path]", { path: "" })} variant="secondary" size="lg">
            Read the docs
          </LinkButton>
          <LinkButton href={href("/playground")} variant="ghost" size="lg">
            Playground
          </LinkButton>
          <LinkButton href={REPOSITORY} variant="ghost" size="lg" external>
            GitHub
          </LinkButton>
        </div>
        <div class="install">
          <Tabs client:load id="create" label="Package manager" labels={Object.keys(createCommands)}>
            {Object.values(createCommands).map((code) => (
              <CodeBlock code={code} lang="sh" highlight={highlight} />
            ))}
          </Tabs>
        </div>
        <ul class="facts" role="list">
          <li>
            <strong>{fixed(2)(lumioseCpu())}</strong>
            <span>weighted factor on js-framework-benchmark (1.00 is the fastest)</span>
          </li>
          <li>
            <strong>{fixed(1)(lumioseSize())} kB</strong>
            <span>compressed, runtime and app, for the benchmark app</span>
          </li>
          <li>
            <strong>{Math.round(lumioseSsr())}/s</strong>
            <span>server renders of a 5,000-component page</span>
          </li>
        </ul>
      </section>

      <section class="section split" aria-labelledby="stsx-title">
        <header>
          <p class="kicker">One file per component</p>
          <h2 id="stsx-title">TSX and CSS, compiled together</h2>
          <p>
            A <code>.stsx</code> file is TSX with <code>&lt;style&gt;</code> blocks of plain CSS. The
            compiler turns both into the smallest thing that does the job.
          </p>
          <ul class="points" role="list">
            <li>
              <strong>Scoped by placement.</strong> One block at the end of the file styles every
              component in it; nested in an element, it styles that subtree;{" "}
              <code>&lt;style global&gt;</code> styles the app.
            </li>
            <li>
              <strong>JS values in CSS.</strong> <code>$gap</code> and <code>$radius.pill</code>{" "}
              read TypeScript constants, type-checked and inlined at build time.
            </li>
            <li>
              <strong>Math at build time.</strong> Lightning CSS folds{" "}
              <code>calc($gap * 2px)</code> to <code>16px</code>: no runtime, no CSS-in-JS.
            </li>
            <li>
              <strong>Setup once, update what changed.</strong> No virtual DOM: a template is
              cloned once, and only the bindings that read a signal re-run.
            </li>
          </ul>
          <a class="more" href={href("/docs/[...path]", { path: "concepts/styles" })}>
            How styles work →
          </a>
        </header>
        <div class="code-pair">
          <Tabs client:visible id="counter" label="Counter.stsx" labels={["You write", "JS output", "CSS output"]}>
            <CodeBlock code={counterSource} lang="stsx" title="Counter.stsx" highlight={highlight} />
            <CodeBlock code={counterOutput} lang="js" title="Counter.js" highlight={highlight} />
            <CodeBlock code={counterCss} lang="css" title="Counter.css" highlight={highlight} />
          </Tabs>
        </div>
      </section>

      <section class="section" id="performance" aria-labelledby="performance-title">
        <header class="section-head">
          <p class="kicker">Measured, not claimed</p>
          <h2 id="performance-title">Fast on the client and the server</h2>
          <p>
            The same apps in every framework, measured with krausest's own js-framework-benchmark
            runner and a server rendering benchmark. Numbers come from the latest committed run.
          </p>
        </header>
        <div class="charts">
          <BarChart
            title="Client updates"
            unit="Weighted geometric mean of CPU time, × the fastest"
            better="lower"
            bars={results.cpu}
            format={fixed(2)}
          />
          <BarChart
            title="Server rendering"
            unit="Renders per second of a 1,000-row page"
            better="higher"
            bars={results.ssr}
            format={(value) => Math.round(value).toString()}
          />
          <BarChart
            title="Bundle size"
            unit="Compressed kB, runtime and benchmark app"
            better="lower"
            bars={results.size}
            format={fixed(1)}
          />
        </div>
        <p class="source">
          Client: {results.clientRun}. Server: {results.serverRun}. Method, every benchmark and the
          caveats: <a href={href("/benchmarks/js-framework-benchmark")}>js-framework-benchmark</a>,{" "}
          <code>benchmarks/ssr/RESULTS.md</code> in the repository, and the{" "}
          <a href={href("/benchmarks")}>other benchmarks</a>.
        </p>
      </section>

      <section class="section" aria-labelledby="modes-title">
        <header class="section-head">
          <p class="kicker">Server first</p>
          <h2 id="modes-title">Choose how each route renders</h2>
          <p>
            Static, server or SPA, per route, with islands where a page needs interaction. This site
            is a static Lumiose app: every page is prerendered, and the search box is an island.
          </p>
        </header>
        <div class="cards">
          <Card
            title="Static"
            eyebrow="mode = static"
            href={href("/docs/[...path]", { path: "concepts/rendering-modes" })}
            icon={<Icon path={ICONS.static} />}
          >
            Prerendered at build time to plain HTML files, with <code>staticPaths</code> for params.
          </Card>
          <Card
            title="Server"
            eyebrow="mode = server"
            href={href("/docs/[...path]", { path: "concepts/rendering-modes" })}
            icon={<Icon path={ICONS.server} />}
          >
            Rendered per request and streamed: the shell first, then each Suspense boundary.
          </Card>
          <Card
            title="Islands"
            eyebrow="client:load · idle · visible"
            href={href("/docs/[...path]", { path: "concepts/islands" })}
            icon={<Icon path={ICONS.islands} />}
          >
            Only interactive components hydrate, with serializable props and slots.
          </Card>
          <Card
            title="SPA routes"
            eyebrow="mode = spa"
            href={href("/docs/[...path]", { path: "reference/router" })}
            icon={<Icon path={ICONS.spa} />}
          >
            Client navigation with persistent layouts, where an app needs it.
          </Card>
        </div>
      </section>

      <section class="section" aria-labelledby="examples-title">
        <header class="section-head">
          <p class="kicker">See it run</p>
          <h2 id="examples-title">Example apps</h2>
          <p>
            Complete apps built with Lumiose, running on this site. See all the{" "}
            <a href={href("/examples")}>examples</a>, and the{" "}
            <a href={href("/benchmarks")}>benchmarks</a> with their latest results.
          </p>
        </header>
        <ShowcaseGrid items={examples().filter((item) => item.demo !== undefined)} open="Open the app" />
      </section>

      <section class="section split" aria-labelledby="tools-title">
        <header>
          <p class="kicker">For humans and agents</p>
          <h2 id="tools-title">Tooling that explains itself</h2>
          <p>
            Every tool speaks the same diagnostics, with stable <code>LUMxxxx</code> codes and a fix,
            in your editor, in the terminal and as JSON.
          </p>
          <ul class="points" role="list">
            <li>
              <strong>TypeScript 7, typed from routes to CSS.</strong> Stock{" "}
              <code>tsc</code>, no plugins: <code>lumiose check</code> type-checks{" "}
              <code>.stsx</code> through shadow files and maps every error back to your source.
            </li>
            <li>
              <strong>Docs in the package.</strong> <code>lumiose docs</code> and{" "}
              <code>lumiose explain</code> print the version you installed; agents read them from{" "}
              <code>node_modules/lumiose/docs</code>.
            </li>
            <li>
              <strong>Editor support.</strong> A language server and VS Code extension, with CSS
              completion inside style blocks, scoped to where you type.
            </li>
            <li>
              <strong>Machine-readable.</strong> <code>--format json</code> on every command,{" "}
              <a href={href("/llms.txt")}>llms.txt</a> and{" "}
              <a href={href("/llms-full.txt")}>llms-full.txt</a> for this site.
            </li>
          </ul>
        </header>
        <div class="code-pair">
          <CodeBlock code={checkSource} lang="stsx" title="src/Counter.stsx" highlight={highlight} />
          <CodeBlock code={checkSample} lang="sh" title="terminal" highlight={highlight} />
        </div>
      </section>

      <section class="section closing" aria-labelledby="start-title">
        <Callout kind="info" title="Pre-release">
          Lumiose is at 0.0.0. The docs mark what this version does not implement yet with a Status
          note, and the APIs may still change.
        </Callout>
        <h2 id="start-title">Build something light</h2>
        <div class="actions">
          <LinkButton href={href("/docs/[...path]", { path: "getting-started" })} size="lg">
            Get started
          </LinkButton>
          <LinkButton href={href("/docs/[...path]", { path: "concepts/components" })} variant="secondary" size="lg">
            Learn the concepts
          </LinkButton>
        </div>
      </section>
    </div>
  );
}

<style>
  .icon {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .home {
    background:
      $gradient.glow no-repeat,
      $color.bg;
    background-size:
      100% 40rem,
      auto;
  }
  .hero,
  .section {
    max-inline-size: $layout.page;
    margin-inline: auto;
    padding-inline: $layout.gutter;
  }

  .hero {
    padding-block: $space.xxxl $space.xxl;
    text-align: center;
  }
  .eyebrow,
  .kicker {
    color: $color.accentText;
    font-family: $font.mono;
    font-size: $text.sm;
    font-weight: $weight.semibold;
  }
  h1 {
    margin-block: $space.sm $space.md;
    font-size: $text.display;
  }
  .lit {
    background: $gradient.text;
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }
  .lead {
    max-inline-size: $layout.prose;
    margin-inline: auto;
    color: $color.muted;
    font-size: $text.lg;
    line-height: $leading.normal;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: $space.sm;
    margin-block-start: $space.xl;
  }
  .install {
    max-inline-size: 34rem;
    margin: $space.xl auto 0;
    text-align: start;
  }
  /* Until a Tabs island runs (it labels the panels role="tabpanel"), show its first panel. */
  .install :deep(.panels > :not([role]) ~ :not([role])),
  .code-pair :deep(.panels > :not([role]) ~ :not([role])) {
    display: none;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: $space.md;
    max-inline-size: 60rem;
    margin: $space.xl auto 0;
  }
  .facts li {
    display: grid;
    gap: $space.xxs;
    padding: $space.md $space.lg;
    border: 1px solid $color.border;
    border-radius: $radius.lg;
    background: color-mix(in oklab, $color.surface 80%, transparent);
    box-shadow: $shadow.sm;
  }
  .facts strong {
    font-size: $text.xxl;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .facts span {
    color: $color.muted;
    font-size: $text.sm;
    line-height: $leading.snug;
  }

  .section {
    padding-block: $space.xxxl;
    border-block-start: 1px solid $color.border;
  }
  .section h2 {
    margin-block: $space.xs $space.sm;
    font-size: $text.xxxl;
  }
  .section header p:not(.kicker) {
    color: $color.muted;
    font-size: $text.lg;
  }
  .section-head {
    max-inline-size: $layout.prose;
    margin-block-end: $space.xl;
  }
  .split {
    display: grid;
    gap: $space.xl;
    align-items: start;
  }
  @media (width >= $bp.lg) {
    .split {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: $space.xxl;
    }
  }
  .points {
    display: grid;
    gap: $space.sm;
    margin-block: $space.lg;
  }
  .points li {
    padding-inline-start: $space.md;
    border-inline-start: 2px solid $color.border;
    color: $color.muted;
  }
  .points strong {
    color: $color.text;
  }
  .more {
    font-weight: $weight.semibold;
  }
  .code-pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-inline-size: 0;
  }

  .charts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: $space.md;
  }
  .source {
    margin-block-start: $space.md;
    color: $color.subtle;
    font-size: $text.sm;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: $space.md;
  }
  .closing {
    display: grid;
    justify-items: center;
    gap: $space.md;
    text-align: center;
  }
  .closing h2 {
    margin-block-start: $space.lg;
  }
  .closing .actions {
    margin-block-start: 0;
  }
</style>
