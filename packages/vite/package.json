{
  "name": "@lumiose/vite",
  "version": "0.8.1",
  "description": "The Lumiose Vite plugin, dev server and build pipeline.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsjavi/lumiose.git",
    "directory": "packages/vite"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./dev": "./src/app/dev/index.ts",
    "./build": "./src/app/production/index.ts",
    "./internal/*": "./src/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./dev": {
        "types": "./dist/app/dev/index.d.ts",
        "default": "./dist/app/dev/index.js"
      },
      "./build": {
        "types": "./dist/app/production/index.d.ts",
        "default": "./dist/app/production/index.js"
      },
      "./internal/*.ts": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "node ../../scripts/build-package.ts",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@lumiose/compiler": "workspace:*",
    "svgo": "^4.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "lumiose": "workspace:*",
    "vite": "^8.3.4"
  },
  "peerDependencies": {
    "lumiose": "workspace:^",
    "vite": "^8.3.0"
  }
}
