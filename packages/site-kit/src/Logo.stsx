// The Lumiose logo (decision-90): the "Corner L" mark, a capital L as a wall and a floor with a
// quarter of light in its corner, beside the wordmark in mono uppercase. The mark is an inline SVG
// without ids, so any number of instances can share a page.

import { color, font, text, weight } from "./tokens.ts";

export function Logo(props: { wordmark?: boolean; class?: JSX.ClassValue }) {
  return (
    <span class={["logo", props.class]}>
      <svg class="mark" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
        <path class="wall" d="M2 2h3v17h17v3H2z" />
        <path class="light" d="M7.5 16.5v-10a10 10 0 0 1 10 10z" />
      </svg>
      {props.wordmark !== false && <span class="word">Lumiose</span>}
    </span>
  );
}

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7em;
    font-family: $font.mono;
    font-size: $text.sm;
    font-weight: $weight.semibold;
    line-height: 1;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: $color.text;
  }
  .mark {
    flex: none;
    inline-size: 1.6em;
    block-size: 1.6em;
  }
  /* The wall and the floor follow the text colour; the quarter of light is the accent. */
  .wall {
    fill: currentColor;
  }
  .light {
    fill: $color.accent;
  }
  /* Letter-spacing also follows the last letter: take it back, so the logo ends at its text. */
  .word {
    margin-inline-end: -0.2em;
  }
</style>
