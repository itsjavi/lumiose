// A content card. With `href`, the whole card is a link (the title's link stretches over it) and
// its border takes the text colour on hover and focus.

import { color, focus, label, motion, radius, space, text, weight } from "./tokens.ts";

export interface CardProps {
  title: string;
  /** Makes the card a link. */
  href?: string;
  /** A short label above the title. */
  eyebrow?: string;
  /** An icon or illustration above the title (slot). */
  icon?: JSX.Element;
  children?: JSX.Element;
  class?: JSX.ClassValue;
}

export function Card(props: CardProps) {
  return (
    <article class={["card", { linked: props.href !== undefined }, props.class]}>
      {props.icon && <div class="icon">{props.icon}</div>}
      {props.eyebrow && <p class="eyebrow">{props.eyebrow}</p>}
      <h3 class="title">
        {props.href !== undefined ? <a href={props.href}>{props.title}</a> : props.title}
      </h3>
      {props.children && <div class="content">{props.children}</div>}
    </article>
  );
}

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: $space.xs;
    padding: $space.lg;
    border: 1px solid $color.border;
    border-radius: $radius.lg;
    background: $color.surface;
    transition: border-color $motion.fast $motion.ease;
  }
  .card.linked:hover,
  .card.linked:focus-within {
    border-color: $color.text;
  }

  .icon {
    display: grid;
    place-items: center;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    margin-block-end: $space.xs;
    border: 1px solid $color.border;
    color: $color.text;
  }
  .eyebrow {
    color: $color.muted;
    font-family: $label.font;
    font-size: $label.size;
    letter-spacing: $label.tracking;
    text-transform: uppercase;
  }
  .title {
    font-size: $text.xl;
    font-weight: $weight.semibold;
    letter-spacing: -0.03em;
  }
  .title a {
    color: $color.text;
    text-decoration: none;
  }
  /* The title's link covers the card, so the whole card is clickable. */
  .title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .title a:focus-visible {
    outline: none;
  }
  .card.linked:has(a:focus-visible) {
    outline: $focus.ring;
    outline-offset: $focus.offset;
  }
  .content {
    color: $color.muted;
    font-size: $text.sm;
  }
</style>
