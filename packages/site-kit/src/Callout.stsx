// An aside for notes, warnings and tips in prose. The kinds share one look (decision-90 has no
// status colours): the icon and the label tell them apart.

import { color, label, radius, space, text } from "./tokens.ts";

export type CalloutKind = "info" | "warn" | "tip";

const TITLES: Record<CalloutKind, string> = { info: "Note", warn: "Warning", tip: "Tip" };

export interface CalloutProps {
  /** Default "info". */
  kind?: CalloutKind;
  /** Default: "Note", "Warning" or "Tip". */
  title?: string;
  children?: JSX.Element;
  class?: JSX.ClassValue;
}

export function Callout(props: CalloutProps) {
  const kind = () => props.kind ?? "info";
  return (
    <div
      role="note"
      class={[
        "callout",
        { info: kind() === "info", warn: kind() === "warn", tip: kind() === "tip" },
        props.class,
      ]}
    >
      <svg class="icon" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
        {kind() === "warn" ? (
          <path d="M10 3.2 17.4 16H2.6L10 3.2Zm0 5.3v3.4m0 2.3v.1" />
        ) : kind() === "tip" ? (
          <path d="M7.4 14.2h5.2M8.2 16.8h3.6M10 2.8a5.2 5.2 0 0 0-3 9.4c.5.4.8.9.8 1.5h4.4c0-.6.3-1.1.8-1.5a5.2 5.2 0 0 0-3-9.4Z" />
        ) : (
          <path d="M10 17.2a7.2 7.2 0 1 0 0-14.4 7.2 7.2 0 0 0 0 14.4Zm0-8v4.6m0-7.2v.1" />
        )}
      </svg>
      <div class="body">
        <p class="title">{props.title ?? TITLES[kind()]}</p>
        <div class="content">{props.children}</div>
      </div>
    </div>
  );
}

<style>
  /* Every kind has the same colours: the icon and the label tell them apart. */
  .callout {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: $space.sm;
    margin-block: $space.lg;
    padding: $space.md $space.lg $space.md $space.md;
    border: 1px solid $color.border;
    border-inline-start-color: $color.text;
    border-radius: $radius.md;
    background: $color.bg;
    color: $color.text;
    font-size: $text.sm;
  }
  .icon {
    fill: none;
    stroke: $color.text;
    stroke-width: 1.4;
    stroke-linecap: square;
    stroke-linejoin: miter;
  }
  .title {
    margin-block: 0.3rem $space.xs;
    color: $color.text;
    font-family: $label.font;
    font-size: $label.size;
    line-height: 1.3;
    letter-spacing: $label.tracking;
    text-transform: uppercase;
  }
  .content {
    color: $color.muted;
  }
  .content > :deep(* + *) {
    margin-block-start: $space.xs;
  }
  .content :deep(a),
  .content :deep(code),
  .content :deep(kbd) {
    color: $color.text;
  }
</style>
