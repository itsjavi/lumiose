// Tabs: @lumiose/ui's Tabs (the WAI-ARIA tabs pattern, server-rendered with its full state, a small
// element for the keys) in the site's look. The parts are @lumiose/ui's, with automatic activation
// by default (the arrow keys select). A `Tab` and a `Panel` with the same `value` belong together.

import {
  Tabs as Ui,
  type TabsListProps,
  type TabsPanelProps,
  type TabsRootProps,
  type TabsTabProps,
} from "@lumiose/ui";
import "@lumiose/ui/tabs.css";
import { color, motion, radius, space, text, weight } from "./tokens.ts";

export type { TabsListProps, TabsPanelProps, TabsRootProps, TabsTabProps };

function Root({ class: className, ...rest }: TabsRootProps) {
  return <Ui.Root {...rest} class={["tabs", className]} />;
}

function List({ class: className, activateOnFocus = true, ...rest }: TabsListProps) {
  return <Ui.List {...rest} activateOnFocus={activateOnFocus} class={["list", className]} />;
}

function Tab({ class: className, ...rest }: TabsTabProps) {
  return <Ui.Tab {...rest} class={["tab", className]} />;
}

function Panel({ class: className, ...rest }: TabsPanelProps) {
  return <Ui.Panel {...rest} class={["panel", className]} />;
}

/**
 * Tabs in the site's look: `Root`, `List` (name it with `aria-label`), `Tab` and `Panel`.
 *
 * @example
 * <Tabs.Root>
 *   <Tabs.List aria-label="Package manager">
 *     <Tabs.Tab value="pnpm">pnpm</Tabs.Tab>
 *     <Tabs.Tab value="npm">npm</Tabs.Tab>
 *   </Tabs.List>
 *   <Tabs.Panel value="pnpm">pnpm create lumiose</Tabs.Panel>
 *   <Tabs.Panel value="npm">npm create lumiose</Tabs.Panel>
 * </Tabs.Root>
 */
export const Tabs = { Root, List, Tab, Panel };

<style>
  .tabs {
    margin-block: $space.lg;
  }
  .list {
    display: flex;
    gap: $space.xxs;
    border-block-end: 1px solid $color.border;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .tab {
    position: relative;
    padding: $space.xs $space.md;
    border: 0;
    border-radius: $radius.sm $radius.sm 0 0;
    background: transparent;
    color: $color.muted;
    font-size: $text.sm;
    font-weight: $weight.medium;
    white-space: nowrap;
    transition:
      color $motion.fast $motion.ease,
      background-color $motion.fast $motion.ease;
  }
  .tab:hover {
    color: $color.text;
    background: $color.sunken;
  }
  .tab:focus-visible {
    outline-offset: -2px;
  }
  .tab[aria-selected="true"] {
    color: $color.text;
  }
  /* The selected tab is lit from below. */
  .tab::after {
    content: "";
    position: absolute;
    inset-inline: $space.xs;
    inset-block-end: -1px;
    block-size: 2px;
    border-radius: $radius.pill;
    background: $color.accent;
    box-shadow: 0 -2px 12px $color.glowA;
    transform: scaleX(0);
    transition: transform $motion.base $motion.ease;
  }
  .tab[aria-selected="true"]::after {
    transform: scaleX(1);
  }
  .panel {
    margin-block-start: $space.md;
  }
  .panel:focus-visible {
    outline-offset: 4px;
  }
</style>
