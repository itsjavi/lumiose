// Tabs (the WAI-ARIA tabs pattern): `labels` name the tabs, and each child element is the panel of
// the label at the same position. Arrow keys, Home and End move between tabs (automatic
// activation, roving tabindex). The props are plain data plus children, so Tabs also works as an
// island (`<Tabs client:visible …>`): the panels are then a server-rendered slot, which Tabs
// labels and shows or hides once it runs.

import { effect, ref, signal } from "lumen";
import { color, motion, radius, space, text, weight } from "./tokens.ts";

export interface TabsProps {
  /** One label per panel. */
  labels: string[];
  /** The panels: one child element per label. */
  children: JSX.Element;
  /** The accessible name of the tab list. */
  label?: string;
  /** Prefix of the tab and panel ids. Pass one when the page is server-rendered (stable ids). */
  id?: string;
  /** The index of the tab selected first. Default 0. */
  initial?: number;
  class?: JSX.ClassValue;
}

let instances = 0;

export function Tabs(props: TabsProps) {
  const id = props.id ?? `tabs-${++instances}`;
  const selected = signal(props.initial ?? 0);
  const list = ref<HTMLDivElement>();
  const panels = ref<HTMLDivElement>();

  // The panels are the children's elements: label them, and show the selected one.
  effect(() => {
    const container = panels();
    if (!container) return;
    const index = selected();
    Array.from(container.children).forEach((panel, i) => {
      panel.id = `${id}-panel-${i}`;
      panel.setAttribute("role", "tabpanel");
      panel.setAttribute("aria-labelledby", `${id}-tab-${i}`);
      panel.setAttribute("tabindex", "0");
      panel.toggleAttribute("hidden", i !== index);
    });
  });

  const onKeyDown = (event: KeyboardEvent) => {
    const count = props.labels.length;
    const keys: Record<string, number> = {
      ArrowRight: (selected() + 1) % count,
      ArrowLeft: (selected() - 1 + count) % count,
      Home: 0,
      End: count - 1,
    };
    const next = keys[event.key];
    if (next === undefined) return;
    event.preventDefault();
    selected.set(next);
    list()?.querySelectorAll<HTMLElement>('[role="tab"]')[next]?.focus();
  };

  return (
    <div class={["tabs", props.class]}>
      <div ref={list} class="list" role="tablist" aria-label={props.label} onKeyDown={onKeyDown}>
        {props.labels.map((label, i) => (
          <button
            type="button"
            role="tab"
            id={`${id}-tab-${i}`}
            class={{ selected: selected() === i }}
            aria-selected={selected() === i ? "true" : "false"}
            aria-controls={`${id}-panel-${i}`}
            tabindex={selected() === i ? 0 : -1}
            onClick={() => selected.set(i)}
          >
            {label}
          </button>
        ))}
      </div>
      <div ref={panels} class="panels">
        {props.children}
      </div>

      <style>
        .tabs {
          margin-block: $space.lg;
        }
        .list {
          display: flex;
          gap: $space.xxs;
          border-block-end: 1px solid $color.border;
          overflow-x: auto;
          scrollbar-width: none;
        }
        button {
          position: relative;
          padding: $space.xs $space.md;
          border: 0;
          border-radius: $radius.sm $radius.sm 0 0;
          background: transparent;
          color: $color.muted;
          font-size: $text.sm;
          font-weight: $weight.medium;
          white-space: nowrap;
          transition:
            color $motion.fast $motion.ease,
            background-color $motion.fast $motion.ease;
        }
        button:hover {
          color: $color.text;
          background: $color.sunken;
        }
        button:focus-visible {
          outline-offset: -2px;
        }
        button.selected {
          color: $color.text;
        }
        /* The selected tab is lit from below. */
        button::after {
          content: "";
          position: absolute;
          inset-inline: $space.xs;
          inset-block-end: -1px;
          block-size: 2px;
          border-radius: $radius.pill;
          background: $color.accent;
          box-shadow: 0 -2px 12px $color.glowA;
          transform: scaleX(0);
          transition: transform $motion.base $motion.ease;
        }
        button.selected::after {
          transform: scaleX(1);
        }
        .panels > :deep(*) {
          margin-block-start: $space.md;
        }
        .panels > :deep([role="tabpanel"]:focus-visible) {
          outline-offset: 4px;
        }
      </style>
    </div>
  );
}
