// Buttons and links styled as buttons. Both share the file-level stylesheet below; variants and
// sizes are class objects, so a variant is one selector (`.btn.primary`).

import { color, motion, radius, space, text, weight } from "./tokens.ts";

export type ButtonVariant = "primary" | "secondary" | "ghost";
export type ButtonSize = "sm" | "md" | "lg";

interface ButtonBase {
  /** `primary` (default): the main action, filled with the text colour. `secondary`: outlined. `ghost`: quiet. */
  variant?: ButtonVariant;
  size?: ButtonSize;
  class?: JSX.ClassValue;
  children?: JSX.Element;
}

export interface ButtonProps extends ButtonBase {
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
  /** The accessible name, for icon-only buttons. */
  label?: string;
  onClick?: JSX.EventHandler<MouseEvent, HTMLButtonElement>;
}

export function Button(props: ButtonProps) {
  return (
    <button
      type={props.type ?? "button"}
      class={[
        "btn",
        {
          primary: (props.variant ?? "primary") === "primary",
          secondary: props.variant === "secondary",
          ghost: props.variant === "ghost",
          sm: props.size === "sm",
          lg: props.size === "lg",
        },
        props.class,
      ]}
      disabled={props.disabled}
      aria-label={props.label}
      onClick={props.onClick}
    >
      {props.children}
    </button>
  );
}

export interface LinkButtonProps extends ButtonBase {
  href: string;
  /** Opens in a new tab, with `rel="noopener"` and a hint for screen readers. */
  external?: boolean;
}

export function LinkButton(props: LinkButtonProps) {
  return (
    <a
      href={props.href}
      class={[
        "btn",
        {
          primary: (props.variant ?? "primary") === "primary",
          secondary: props.variant === "secondary",
          ghost: props.variant === "ghost",
          sm: props.size === "sm",
          lg: props.size === "lg",
        },
        props.class,
      ]}
      target={props.external ? "_blank" : undefined}
      rel={props.external ? "noopener" : undefined}
    >
      {props.children}
      {props.external && <span class="sr-only"> (opens in a new tab)</span>}
    </a>
  );
}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: $space.xs;
    min-block-size: 2.5rem;
    padding: $space.xxs $space.lg;
    border: 1px solid transparent;
    border-radius: $radius.sm;
    font-size: $text.sm;
    font-weight: $weight.medium;
    line-height: 1.25;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color $motion.fast $motion.ease,
      border-color $motion.fast $motion.ease,
      color $motion.fast $motion.ease;
  }
  .btn:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  .btn.sm {
    min-block-size: 2.125rem;
    padding-inline: $space.md;
  }
  .btn.lg {
    min-block-size: 2.875rem;
    padding-inline: $space.lg;
    font-size: $text.md;
  }

  /* The main action is the page inverted: the text colour as the fill, the background as the text. */
  .btn.primary {
    background: $color.text;
    color: $color.bg;
    border-color: $color.text;
  }
  .btn.primary:hover:not(:disabled) {
    background: color-mix(in oklab, $color.text 82%, $color.bg);
    border-color: color-mix(in oklab, $color.text 82%, $color.bg);
  }

  .btn.secondary {
    background: transparent;
    color: $color.text;
    border-color: $color.borderStrong;
  }
  .btn.secondary:hover:not(:disabled) {
    border-color: $color.text;
  }

  .btn.ghost {
    background: transparent;
    color: $color.muted;
  }
  .btn.ghost:hover:not(:disabled) {
    background: $color.sunken;
    color: $color.text;
  }
</style>
