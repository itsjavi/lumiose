// The site navigation: links with an active state and, below the `md` breakpoint, a disclosure
// menu (button + panel). It is the interactive part of SiteHeader, used as an island
// (`<SiteNav client:load … />`), so its props are plain data.

import { onMount, ref, signal } from "lumen";
import { bp, color, layout, motion, radius, shadow, space, text, weight, z } from "./tokens.ts";

export interface NavLink {
  href: string;
  label: string;
  /** Opens in a new tab. */
  external?: boolean;
}

export interface SiteNavProps {
  links: NavLink[];
  /** The current path, for the active state (`aria-current="page"`). */
  current?: string;
  /** The accessible name of the navigation landmark. Default "Main". */
  label?: string;
  /** Id of the link list (the menu button's `aria-controls`). Default "site-nav". */
  id?: string;
  class?: JSX.ClassValue;
}

/** Whether `href` is the current page or one of its ancestors (`/docs` for `/docs/signals`). */
export function isActive(href: string, current: string | undefined): boolean {
  if (current === undefined) return false;
  if (href === current) return true;
  if (href === "/" || /^[a-z]+:/i.test(href)) return false;
  return current.startsWith(href.endsWith("/") ? href : `${href}/`);
}

export function SiteNav(props: SiteNavProps) {
  const open = signal(false);
  const nav = ref<HTMLElement>();
  const button = ref<HTMLButtonElement>();

  // Escape closes the menu and returns focus to its button; so does a click outside, without focus.
  const onKeyDown = (event: KeyboardEvent) => {
    if (event.key === "Escape" && open()) {
      open.set(false);
      button()?.focus();
    }
  };
  const onPointerDown = (event: PointerEvent) => {
    if (open() && !nav()?.contains(event.target as Node)) open.set(false);
  };

  onMount(() => {
    const desktop = matchMedia(`(width >= ${bp.md})`);
    const onResize = () => {
      if (desktop.matches) open.set(false);
    };
    document.addEventListener("pointerdown", onPointerDown);
    desktop.addEventListener("change", onResize);
    return () => {
      document.removeEventListener("pointerdown", onPointerDown);
      desktop.removeEventListener("change", onResize);
    };
  });

  return (
    <nav
      ref={nav}
      class={["nav", { open: open() }, props.class]}
      aria-label={props.label ?? "Main"}
      onKeyDown={onKeyDown}
    >
      <button
        ref={button}
        type="button"
        class="menu"
        aria-expanded={open() ? "true" : "false"}
        aria-controls={props.id ?? "site-nav"}
        onClick={() => open.update((value) => !value)}
      >
        <span class="sr-only">Menu</span>
        <span class="bars" aria-hidden="true" />
      </button>
      <ul id={props.id ?? "site-nav"} class="links" role="list">
        {props.links.map((link) => (
          <li>
            <a
              href={link.href}
              class={{ active: isActive(link.href, props.current) }}
              aria-current={isActive(link.href, props.current) ? "page" : undefined}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noopener" : undefined}
              onClick={() => open.set(false)}
            >
              {link.label}
              {link.external && (
                <svg class="ext" viewBox="0 0 12 12" width="10" height="10" aria-hidden="true">
                  <path d="M4.5 2.5h5v5M9.5 2.5 3 9" />
                </svg>
              )}
              {link.external && <span class="sr-only"> (opens in a new tab)</span>}
            </a>
          </li>
        ))}
      </ul>

      <style>
        .nav {
          display: flex;
          align-items: center;
        }
        .menu {
          display: none;
        }
        .links {
          display: flex;
          align-items: center;
          gap: $space.xxs;
        }
        a {
          position: relative;
          display: inline-flex;
          align-items: center;
          gap: 0.35em;
          padding: $space.xs $space.sm;
          border-radius: $radius.pill;
          color: $color.muted;
          font-size: $text.sm;
          font-weight: $weight.medium;
          text-decoration: none;
          transition:
            color $motion.fast $motion.ease,
            background-color $motion.fast $motion.ease;
        }
        a:hover {
          color: $color.text;
          background: $color.sunken;
        }
        a.active {
          color: $color.text;
        }
        /* The active link carries a small light underneath. */
        a.active::after {
          content: "";
          position: absolute;
          inset-inline: $space.sm;
          inset-block-end: 0.2rem;
          block-size: 2px;
          border-radius: $radius.pill;
          background: $color.accent;
          box-shadow: 0 0 10px $color.glowA;
        }
        .ext {
          fill: none;
          stroke: currentColor;
          stroke-width: 1.4;
          stroke-linecap: round;
          opacity: 0.7;
        }

        @media (width < $bp.md) {
          .menu {
            display: inline-grid;
            place-items: center;
            inline-size: 2.25rem;
            block-size: 2.25rem;
            padding: 0;
            border: 1px solid $color.border;
            border-radius: $radius.pill;
            background: $color.surface;
            color: $color.text;
          }
          /* Three bars that turn into a cross. */
          .bars,
          .bars::before,
          .bars::after {
            display: block;
            inline-size: 1rem;
            block-size: 1.5px;
            border-radius: 1px;
            background: currentColor;
            transition:
              transform $motion.base $motion.ease,
              background-color $motion.fast $motion.ease;
          }
          .bars {
            position: relative;
          }
          .bars::before,
          .bars::after {
            content: "";
            position: absolute;
            inset-inline-start: 0;
          }
          .bars::before {
            transform: translateY(-5px);
          }
          .bars::after {
            transform: translateY(5px);
          }
          .open .bars {
            background: transparent;
          }
          .open .bars::before {
            transform: rotate(45deg);
          }
          .open .bars::after {
            transform: rotate(-45deg);
          }

          .links {
            position: absolute;
            inset-inline: 0;
            inset-block-start: 100%;
            z-index: $z.menu;
            display: none;
            flex-direction: column;
            align-items: stretch;
            gap: $space.xxs;
            padding: $space.sm $layout.gutter $space.lg;
            background: $color.bg;
            border-block-end: 1px solid $color.border;
            box-shadow: $shadow.lg;
          }
          .open .links {
            display: flex;
          }
          a {
            display: flex;
            padding: $space.sm $space.md;
            font-size: $text.md;
            border-radius: $radius.md;
          }
          a.active {
            background: $color.accentSoft;
            color: $color.accentText;
          }
          a.active::after {
            inset-inline: auto;
            inset-inline-start: 0.35rem;
            inset-block: 30%;
            block-size: auto;
            inline-size: 3px;
          }
        }
      </style>
    </nav>
  );
}
