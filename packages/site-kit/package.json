{
  "name": "@lumiose/site-kit",
  "version": "0.0.0",
  "private": true,
  "description": "The design system of the Lumiose websites (landing page, docs, playground): tokens, a base stylesheet and .stsx components.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens.ts",
    "./theme": "./src/theme.ts",
    "./highlight": "./src/highlight.ts"
  },
  "scripts": {
    "typecheck": "lumiose check && lumiose check --root showcase",
    "dev": "vite showcase",
    "build": "vite build showcase",
    "test:e2e": "playwright test -c showcase/playwright.config.ts",
    "screenshots": "SCREENSHOTS=1 playwright test -c showcase/playwright.config.ts -g screenshots"
  },
  "dependencies": {
    "@lumiose/ui": "workspace:*",
    "lumiose": "workspace:*"
  },
  "devDependencies": {
    "@lumiose/cli": "workspace:*",
    "@lumiose/vite": "workspace:*",
    "@playwright/test": "1.65.0",
    "@types/node": "^24.19.1",
    "vite": "^8.3.7"
  },
  "demo": {
    "title": "Site kit showcase",
    "kind": "site"
  }
}
