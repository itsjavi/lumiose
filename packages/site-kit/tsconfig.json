{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "lumiose",
    "types": ["lumiose/env"],
    // `.stsx` files are type-checked through their shadow TSX (`lumiose check`).
    "rootDirs": ["src", ".lumiose/shadow/src"]
  },
  "include": ["src", ".lumiose/shadow", ".lumiose/types"]
}
