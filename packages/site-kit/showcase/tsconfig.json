{
  // The generated Lumen tsconfig pairs the kit's directory with `.lumen/shadow`, so the showcase's
  // `.stsx` files may import `../../src/…` and the kit's `.stsx` modules type-check (`lumen check`).
  "extends": ["../../../tsconfig.base.json", "./.lumen/tsconfig.generated.json"],
  "compilerOptions": {
    "types": ["node", "lumen/env"]
  },
  "include": [
    "src",
    "tests",
    "vite.config.ts",
    "playwright.config.ts",
    ".lumen/shadow",
    ".lumen/types"
  ]
}
