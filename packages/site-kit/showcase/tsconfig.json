{
  // The generated Lumiose tsconfig pairs the kit's directory with `.lumiose/shadow`, so the showcase's
  // `.stsx` files may import `../../src/…` and the kit's `.stsx` modules type-check (`lumiose check`).
  "extends": ["../../../tsconfig.base.json", "./.lumiose/tsconfig.generated.json"],
  "compilerOptions": {
    "types": ["node", "lumiose/env"]
  },
  "include": [
    "src",
    "tests",
    "vite.config.ts",
    "playwright.config.ts",
    ".lumiose/shadow",
    ".lumiose/types"
  ]
}
