{
  "name": "@lumiose/eslint-plugin",
  "version": "0.0.0",
  "description": "Lumiose's compiler diagnostics (LUMxxxx) as lint rules for oxlint (JS plugins) and ESLint, plus a .stsx processor for ESLint.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsjavi/lumiose.git",
    "directory": "packages/eslint-plugin"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "node ../../scripts/build-package.ts",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@lumiose/compiler": "workspace:*"
  }
}
