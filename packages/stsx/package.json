{
  "name": "@lumiose/stsx",
  "version": "0.8.1",
  "description": "STSX (Styled TSX) for React, Solid and other JSX frameworks: a Vite plugin for .stsx files, TSX plus raw-CSS <style> blocks scoped by placement.",
  "keywords": [
    "jsx",
    "react",
    "scoped-css",
    "solid",
    "stsx",
    "vite-plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsjavi/lumiose.git",
    "directory": "packages/stsx"
  },
  "bin": {
    "stsx": "./src/bin.ts"
  },
  "files": [
    "dist",
    "docs"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "bin": {
      "stsx": "./dist/bin.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "node ../../scripts/build-package.ts",
    "prepack": "pnpm run build",
    "docs:gen": "node scripts/gen-llms.ts",
    "docs:check": "node scripts/gen-llms.ts --check"
  },
  "dependencies": {
    "@lumiose/compiler": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "solid-js": "1.9.17",
    "vite": "8.3.4",
    "vite-plugin-solid": "2.11.14"
  },
  "peerDependencies": {
    "vite": "^8.3.0"
  }
}
