{
  "name": "lumiose",
  "version": "0.6.0",
  "description": "Feels like React. Runs like vanilla JS. Lumiose is a web framework for everything from static sites and SPAs to full-stack apps: TSX with scoped CSS built in, signals, and 0 kB of JavaScript until a page needs it.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsjavi/lumiose.git",
    "directory": "packages/lumiose"
  },
  "files": [
    "dist",
    "docs"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "browser": "./src/index.ts",
      "node": "./src/index.server.ts",
      "default": "./src/index.ts"
    },
    "./dom": "./src/dom/index.ts",
    "./dom/hydrate": "./src/dom/hydrate.ts",
    "./dom/loader": "./src/dom/loader.ts",
    "./dom/hot": "./src/dom/hot.ts",
    "./server": "./src/server/index.ts",
    "./router": {
      "types": "./src/app/router/index.ts",
      "browser": "./src/app/router/index.ts",
      "node": "./src/app/router/index.server.ts",
      "default": "./src/app/router/index.ts"
    },
    "./jsx-runtime": "./src/jsx/jsx-runtime.ts",
    "./jsx-dev-runtime": "./src/jsx/jsx-runtime.ts",
    "./env": {
      "types": "./src/jsx/env.d.ts"
    },
    "./node": "./src/app/server/node-http.ts",
    "./internal/*": "./src/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "browser": "./dist/index.js",
        "node": "./dist/index.server.js",
        "default": "./dist/index.js"
      },
      "./dom": {
        "types": "./dist/dom/index.d.ts",
        "default": "./dist/dom/index.js"
      },
      "./dom/hydrate": {
        "types": "./dist/dom/hydrate.d.ts",
        "default": "./dist/dom/hydrate.js"
      },
      "./dom/loader": {
        "types": "./dist/dom/loader.d.ts",
        "default": "./dist/dom/loader.js"
      },
      "./dom/hot": {
        "types": "./dist/dom/hot.d.ts",
        "default": "./dist/dom/hot.js"
      },
      "./server": {
        "types": "./dist/server/index.d.ts",
        "default": "./dist/server/index.js"
      },
      "./router": {
        "types": "./dist/app/router/index.d.ts",
        "browser": "./dist/app/router/index.js",
        "node": "./dist/app/router/index.server.js",
        "default": "./dist/app/router/index.js"
      },
      "./jsx-runtime": {
        "types": "./dist/jsx/jsx-runtime.d.ts",
        "default": "./dist/jsx/jsx-runtime.js"
      },
      "./jsx-dev-runtime": {
        "types": "./dist/jsx/jsx-runtime.d.ts",
        "default": "./dist/jsx/jsx-runtime.js"
      },
      "./env": {
        "types": "./dist/jsx/env.d.ts"
      },
      "./node": {
        "types": "./dist/app/server/node-http.d.ts",
        "default": "./dist/app/server/node-http.js"
      },
      "./internal/*.ts": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:properties": "node scripts/properties.ts",
    "size": "node scripts/size.ts",
    "size:apps": "node scripts/size-apps.ts",
    "docs:gen": "node scripts/gen-error-docs.ts && node scripts/gen-llms.ts",
    "docs:check": "node scripts/gen-error-docs.ts --check && node scripts/gen-llms.ts --check",
    "build": "node ../../scripts/build-package.ts",
    "prepack": "pnpm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@lumiose/cli": "workspace:*",
    "@lumiose/compiler": "workspace:*",
    "@lumiose/vite": "workspace:*",
    "fast-check": "4.10.2",
    "parse5": "8.0.1",
    "vite": "^8.3.4"
  }
}
