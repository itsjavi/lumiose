{
  "name": "lumiose",
  "version": "0.0.0",
  "private": true,
  "description": "Lumiose runtime: signals, the DOM and server renderers, the router and the app runtime.",
  "license": "MIT",
  "files": [
    "src",
    "docs"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "browser": "./src/index.ts",
      "node": "./src/index.server.ts",
      "default": "./src/index.ts"
    },
    "./dom": "./src/dom/index.ts",
    "./dom/hydrate": "./src/dom/hydrate.ts",
    "./dom/loader": "./src/dom/loader.ts",
    "./dom/hot": "./src/dom/hot.ts",
    "./server": "./src/server/index.ts",
    "./router": {
      "types": "./src/app/router/index.ts",
      "browser": "./src/app/router/index.ts",
      "node": "./src/app/router/index.server.ts",
      "default": "./src/app/router/index.ts"
    },
    "./jsx-runtime": "./src/jsx/jsx-runtime.ts",
    "./jsx-dev-runtime": "./src/jsx/jsx-runtime.ts",
    "./env": {
      "types": "./src/jsx/env.d.ts"
    },
    "./node": "./src/app/server/node-http.ts",
    "./internal/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "size": "node scripts/size.ts",
    "size:apps": "node scripts/size-apps.ts",
    "docs:gen": "node scripts/gen-error-docs.ts && node scripts/gen-llms.ts",
    "docs:check": "node scripts/gen-error-docs.ts --check && node scripts/gen-llms.ts --check"
  },
  "dependencies": {},
  "devDependencies": {
    "@lumiose/cli": "workspace:*",
    "@lumiose/compiler": "workspace:*",
    "@lumiose/vite": "workspace:*",
    "vite": "^8.3.4"
  }
}
