{
  "name": "@lumiose/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Accessible, unstyled UI primitives for Lumiose: native elements first (dialog, popover, invoker commands, anchor positioning), light-DOM custom elements only where the platform falls short.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsjavi/lumiose.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist",
    "docs"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.script.ts"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./dialog": "./src/dialog/dialog.tsx",
    "./styles.css": "./src/styles.css",
    "./dialog.css": "./src/dialog/dialog.css",
    "./popover": "./src/popover/popover.tsx",
    "./popover.css": "./src/popover/popover.css",
    "./tooltip": "./src/tooltip/tooltip.tsx",
    "./tooltip.css": "./src/tooltip/tooltip.css",
    "./tabs": "./src/tabs/tabs.tsx",
    "./tabs.css": "./src/tabs/tabs.css",
    "./menu": "./src/menu/menu.tsx",
    "./menu.css": "./src/menu/menu.css",
    "./combobox": "./src/combobox/combobox.tsx",
    "./combobox.css": "./src/combobox/combobox.css",
    "./select": "./src/select/select.tsx",
    "./select.css": "./src/select/select.css",
    "./field": "./src/field/field.tsx",
    "./field.css": "./src/field/field.css",
    "./fieldset": "./src/fieldset/fieldset.tsx",
    "./form": "./src/form/form.tsx",
    "./input": "./src/input/input.tsx",
    "./checkbox": "./src/checkbox/checkbox.tsx",
    "./checkbox-group": "./src/checkbox-group/checkbox-group.tsx",
    "./radio-group": "./src/radio-group/radio-group.tsx",
    "./switch": "./src/switch/switch.tsx",
    "./collapsible": "./src/collapsible/collapsible.tsx",
    "./collapsible.css": "./src/collapsible/collapsible.css",
    "./accordion": "./src/accordion/accordion.tsx",
    "./accordion.css": "./src/accordion/accordion.css",
    "./toast": "./src/toast/toast.tsx",
    "./toast.css": "./src/toast/toast.css",
    "./themes/default.css": "./src/themes/default.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.ts",
      "./dialog": "./dist/dialog/dialog.tsx",
      "./styles.css": "./dist/styles.css",
      "./dialog.css": "./dist/dialog/dialog.css",
      "./popover": "./dist/popover/popover.tsx",
      "./popover.css": "./dist/popover/popover.css",
      "./tooltip": "./dist/tooltip/tooltip.tsx",
      "./tooltip.css": "./dist/tooltip/tooltip.css",
      "./tabs": "./dist/tabs/tabs.tsx",
      "./tabs.css": "./dist/tabs/tabs.css",
      "./menu": "./dist/menu/menu.tsx",
      "./menu.css": "./dist/menu/menu.css",
      "./combobox": "./dist/combobox/combobox.tsx",
      "./combobox.css": "./dist/combobox/combobox.css",
      "./select": "./dist/select/select.tsx",
      "./select.css": "./dist/select/select.css",
      "./field": "./dist/field/field.tsx",
      "./field.css": "./dist/field/field.css",
      "./fieldset": "./dist/fieldset/fieldset.tsx",
      "./form": "./dist/form/form.tsx",
      "./input": "./dist/input/input.tsx",
      "./checkbox": "./dist/checkbox/checkbox.tsx",
      "./checkbox-group": "./dist/checkbox-group/checkbox-group.tsx",
      "./radio-group": "./dist/radio-group/radio-group.tsx",
      "./switch": "./dist/switch/switch.tsx",
      "./collapsible": "./dist/collapsible/collapsible.tsx",
      "./collapsible.css": "./dist/collapsible/collapsible.css",
      "./accordion": "./dist/accordion/accordion.tsx",
      "./accordion.css": "./dist/accordion/accordion.css",
      "./toast": "./dist/toast/toast.tsx",
      "./toast.css": "./dist/toast/toast.css",
      "./themes/default.css": "./dist/themes/default.css",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "size": "node scripts/size.ts",
    "docs:gen": "node scripts/gen-llms.ts",
    "docs:check": "node scripts/gen-llms.ts --check",
    "build": "node scripts/build.ts",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@lumiose/compiler": "workspace:*",
    "@lumiose/vite": "workspace:*",
    "@types/node": "^24.0.0",
    "happy-dom": "^20.14.5",
    "lumiose": "workspace:*",
    "vite": "^8.3.4"
  },
  "peerDependencies": {
    "lumiose": "workspace:^"
  }
}
