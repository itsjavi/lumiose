{
  "name": "@lumiose/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Accessible, unstyled UI primitives for Lumiose: native elements first (dialog, popover, invoker commands, anchor positioning), light-DOM custom elements only where the platform falls short.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsjavi/lumiose.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist",
    "docs"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.script.ts"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./dialog": "./src/dialog/dialog.tsx",
    "./styles.css": "./src/styles.css",
    "./dialog.css": "./src/dialog/dialog.css",
    "./themes/default.css": "./src/themes/default.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.ts",
      "./dialog": "./dist/dialog/dialog.tsx",
      "./styles.css": "./dist/styles.css",
      "./dialog.css": "./dist/dialog/dialog.css",
      "./themes/default.css": "./dist/themes/default.css",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "size": "node scripts/size.ts",
    "docs:gen": "node scripts/gen-llms.ts",
    "docs:check": "node scripts/gen-llms.ts --check",
    "build": "node scripts/build.ts",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@lumiose/compiler": "workspace:*",
    "@lumiose/vite": "workspace:*",
    "@types/node": "^24.0.0",
    "happy-dom": "^20.14.5",
    "lumiose": "workspace:*",
    "vite": "^8.3.4"
  },
  "peerDependencies": {
    "lumiose": "workspace:^"
  }
}
