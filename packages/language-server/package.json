{
  "name": "@lumiose/language-server",
  "version": "0.8.0",
  "description": "The Lumiose language server: a TypeScript 7 takeover proxy for .ts/.tsx/.stsx plus CSS features for .stsx style blocks.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsjavi/lumiose.git",
    "directory": "packages/language-server"
  },
  "bin": {
    "lumiose-language-server": "./src/bin.ts"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "bin": {
      "lumiose-language-server": "./dist/bin.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "node ../../scripts/build-package.ts",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@lumiose/cli": "workspace:*",
    "@lumiose/compiler": "workspace:*",
    "lumiose": "workspace:*",
    "typescript": "^7.0.2",
    "vscode-css-languageservice": "^6.3.10",
    "vscode-languageserver": "^10.1.2",
    "vscode-languageserver-textdocument": "^1.0.15"
  }
}
