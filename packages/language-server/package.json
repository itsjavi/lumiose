    "test": "vitest run"
  },
  "dependencies": {
    "@lumiose/cli": "workspace:*",
    "@lumiose/compiler": "workspace:*",
    "lumiose": "workspace:*",
    "typescript": "^7.0.2",
    "vscode-css-languageservice": "^6.3.10",
    "vscode-languageserver": "^10.1.2",
    "vscode-languageserver-textdocument": "^1.0.15"
  }
