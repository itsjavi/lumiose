// A form that works without JavaScript: it posts to the `sign` action, which validates the input
// and redirects back (or returns the errors, which the page reads with actionData()).
import { actionData, fail, redirect, Title, type ActionContext } from "lumiose";
import { addEntry, listEntries } from "../server/guestbook.server.ts";

interface Errors {
  name?: string;
  message?: string;
}

export const actions = {
  async sign(ctx: ActionContext<"/guestbook">) {
    const form = await ctx.formData();
    const name = String(form.get("name") ?? "").trim();
    const message = String(form.get("message") ?? "").trim();
    const errors: Errors = {};
    if (name === "") errors.name = "Your name is required.";
    if (message === "") errors.message = "Write a message.";
    if (errors.name || errors.message) return fail(400, errors);
    addEntry(name, message);
    redirect("/guestbook");
  },
};

export default function Guestbook() {
  const errors = actionData<typeof actions>();

  return (
    <main>
      <Title>Guestbook · {{name}}</Title>
      <h1>Guestbook</h1>
      <form method="post" action="?/sign">
        <label>
          Name <input name="name" />
        </label>
        <p class="error">{errors?.name}</p>
        <label>
          Message <textarea name="message" />
        </label>
        <p class="error">{errors?.message}</p>
        <button>Sign</button>
      </form>
      <ul class="entries">
        {listEntries().map((entry) => (
          <li key={entry.id}>
            <strong>{entry.name}</strong>: {entry.message}
          </li>
        ))}
      </ul>

      <style>
        form {
          display: grid;
          gap: 0.25rem;
          max-width: 24rem;
        }
        label {
          display: grid;
        }
        .error {
          margin: 0;
          color: crimson;
        }
        .entries {
          padding: 0;
          list-style: none;
        }
      </style>
    </main>
  );
}
