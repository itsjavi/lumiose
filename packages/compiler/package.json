{
  "name": "@lumen/compiler",
  "version": "0.0.0",
  "private": true,
  "description": "Native bindings (napi-rs) of the Lumen Rust compiler: the .stsx scanner and masking.",
  "license": "MIT",
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "napi build --platform --release --esm --no-const-enum --manifest-path ../../crates/lumen_napi/Cargo.toml --output-dir . && oxfmt index.js index.d.ts",
    "build:debug": "napi build --platform --esm --no-const-enum --manifest-path ../../crates/lumen_napi/Cargo.toml --output-dir . && oxfmt index.js index.d.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.0"
  },
  "napi": {
    "binaryName": "compiler",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  }
}
