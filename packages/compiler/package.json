{
  "name": "@lumiose/compiler",
  "version": "0.7.1",
  "description": "Native bindings (napi-rs) of the Lumiose Rust compiler, with a WebAssembly (WASI) fallback.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsjavi/lumiose.git",
    "directory": "packages/compiler"
  },
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "napi build --platform --release --esm --no-const-enum --manifest-path ../../crates/lumiose_napi/Cargo.toml --output-dir . && oxfmt index.js index.d.ts",
    "build:debug": "napi build --platform --esm --no-const-enum --manifest-path ../../crates/lumiose_napi/Cargo.toml --output-dir . && oxfmt index.js index.d.ts",
    "build:wasm": "napi build --platform --release --esm --no-const-enum --target wasm32-wasip1-threads --manifest-path ../../crates/lumiose_napi/Cargo.toml --output-dir . && oxfmt index.js index.d.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@emnapi/core": "2.0.0-alpha.5",
    "@emnapi/runtime": "2.0.0-alpha.5",
    "@napi-rs/cli": "^3.10.0",
    "@napi-rs/wasm-runtime": "1.2.4",
    "emnapi": "2.0.0-alpha.5"
  },
  "optionalDependencies": {
    "@lumiose/compiler-darwin-arm64": "workspace:*",
    "@lumiose/compiler-darwin-x64": "workspace:*",
    "@lumiose/compiler-linux-arm64-gnu": "workspace:*",
    "@lumiose/compiler-linux-arm64-musl": "workspace:*",
    "@lumiose/compiler-linux-x64-gnu": "workspace:*",
    "@lumiose/compiler-linux-x64-musl": "workspace:*",
    "@lumiose/compiler-wasm32-wasi": "workspace:*",
    "@lumiose/compiler-win32-x64-msvc": "workspace:*"
  },
  "napi": {
    "binaryName": "compiler",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "x86_64-pc-windows-msvc",
      "wasm32-wasip1-threads"
    ]
  }
}
