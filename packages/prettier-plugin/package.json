{
  "name": "@lumiose/prettier-plugin",
  "version": "0.0.0",
  "private": true,
  "description": "Prettier support for Lumiose .stsx files: the TSX with Prettier's TypeScript printer, each <style> block with its CSS printer, re-indented at its placement (like lumiose fmt).",
  "license": "MIT",
  "files": [
    "src"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@lumiose/cli": "workspace:*",
    "lumiose": "workspace:*"
  },
  "devDependencies": {
    "@lumiose/compiler": "workspace:*",
    "prettier": "^3.9.9"
  },
  "peerDependencies": {
    "prettier": "^3.0.0"
  }
}
