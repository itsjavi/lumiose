{
  "name": "@lumiose/cli",
  "version": "0.4.0",
  "description": "The lumiose command: dev, build, preview, check, lint, fmt, docs and the MCP server.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsjavi/lumiose.git",
    "directory": "packages/cli"
  },
  "bin": {
    "lumiose": "./src/bin.ts"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./tooling": "./src/tooling.ts",
    "./agents": "./src/agents/index.ts",
    "./internal/*": "./src/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "bin": {
      "lumiose": "./dist/bin.js"
    },
    "exports": {
      "./tooling": {
        "types": "./dist/tooling.d.ts",
        "default": "./dist/tooling.js"
      },
      "./agents": {
        "types": "./dist/agents/index.d.ts",
        "default": "./dist/agents/index.js"
      },
      "./internal/*.ts": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "node ../../scripts/build-package.ts",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@lumiose/compiler": "workspace:*",
    "@lumiose/vite": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "lumiose": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@sanity/client": "8.9.0",
    "@sanity/webhook": "4.0.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/user-event": "14.6.7",
    "stripe": "23.0.0",
    "vite": "^8.3.4"
  },
  "peerDependencies": {
    "vite": "^8.3.0"
  }
}
