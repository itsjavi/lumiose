{
  "name": "@lumiose/cli",
  "version": "0.8.1",
  "description": "The lumiose command: dev, build, preview, check, lint, fmt, docs and the MCP server.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsjavi/lumiose.git",
    "directory": "packages/cli"
  },
  "bin": {
    "lumiose": "./src/bin.ts"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./tooling": "./src/tooling.ts",
    "./agents": "./src/agents/index.ts",
    "./internal/*": "./src/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "bin": {
      "lumiose": "./dist/bin.js"
    },
    "exports": {
      "./tooling": {
        "types": "./dist/tooling.d.ts",
        "default": "./dist/tooling.js"
      },
      "./agents": {
        "types": "./dist/agents/index.d.ts",
        "default": "./dist/agents/index.js"
      },
      "./internal/*.ts": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "node ../../scripts/build-package.ts",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@lumiose/compiler": "workspace:*",
    "@lumiose/vite": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "lumiose": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-web": "2.12.0",
    "@opentelemetry/semantic-conventions": "1.45.0",
    "@playwright/test": "1.65.0",
    "@sanity/client": "8.15.0",
    "@sanity/webhook": "4.0.4",
    "@sentry/browser": "11.11.0",
    "@sentry/node": "11.11.0",
    "@sentry/vite-plugin": "11.11.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/user-event": "14.6.8",
    "posthog-js": "1.447.4",
    "posthog-node": "5.63.2",
    "stripe": "23.1.0",
    "vite": "^8.3.7"
  },
  "peerDependencies": {
    "vite": "^8.3.0"
  }
}
