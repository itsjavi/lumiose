{
  "name": "lumen",
  "version": "0.0.0",
  "private": true,
  "description": "Lumen: a TypeScript 7-first web framework with .stsx components (TSX + raw CSS), signals and server-first islands.",
  "license": "MIT",
  "bin": {
    "lumen": "./src/cli/bin.ts"
  },
  "files": [
    "src",
    "docs"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "browser": "./src/index.ts",
      "node": "./src/index.server.ts",
      "default": "./src/index.ts"
    },
    "./dom": "./src/dom/index.ts",
    "./dom/hydrate": "./src/dom/hydrate.ts",
    "./dom/loader": "./src/dom/loader.ts",
    "./server": "./src/server/index.ts",
    "./router": {
      "types": "./src/app/router/index.ts",
      "browser": "./src/app/router/index.ts",
      "node": "./src/app/router/index.server.ts",
      "default": "./src/app/router/index.ts"
    },
    "./jsx-runtime": "./src/jsx/jsx-runtime.ts",
    "./jsx-dev-runtime": "./src/jsx/jsx-runtime.ts",
    "./env": {
      "types": "./src/jsx/env.d.ts"
    },
    "./vite": "./src/vite/index.ts",
    "./dev": "./src/app/dev/index.ts",
    "./build": "./src/app/production/index.ts",
    "./node": "./src/app/server/node-http.ts",
    "./tooling": "./src/cli/tooling.ts",
    "./agents": "./src/cli/agents/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "size": "node scripts/size.ts",
    "docs:gen": "node scripts/gen-error-docs.ts && node scripts/gen-llms.ts",
    "docs:check": "node scripts/gen-error-docs.ts --check && node scripts/gen-llms.ts --check"
  },
  "dependencies": {
    "@lumen/compiler": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "svgo": "^4.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "vite": "^8.3.4"
  },
  "peerDependencies": {
    "vite": "^8.3.0"
  }
}
