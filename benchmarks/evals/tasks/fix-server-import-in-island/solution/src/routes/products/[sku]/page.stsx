import { notFound, params, Title } from "lumiose";
import { StockBadge } from "../../../components/StockBadge.stsx";
import { getStock } from "../../../server/stock.server.ts";

export default function Product() {
  const { sku } = params<"/products/[sku]">();
  const stock = getStock(sku);
  if (stock === undefined) notFound();
  return (
    <main>
      <Title>{sku}</Title>
      <h1>Product {sku}</h1>
      <StockBadge client:load sku={sku} initial={stock} />
    </main>
  );
}
