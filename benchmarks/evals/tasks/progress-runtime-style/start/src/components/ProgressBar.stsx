export function ProgressBar({ value }: { value: number }) {
  return (
    <div class="progress" role="progressbar" aria-valuemin={0} aria-valuemax={100}>
      <div class="fill" />

      <style>
        .progress {
          height: 0.75rem;
          background: #e5e7eb;
          border-radius: 999px;
          overflow: hidden;
        }
        .fill {
          height: 100%;
          background: #16a34a;
          width: calc($value * 1%);
        }
      </style>
    </div>
  );
}
