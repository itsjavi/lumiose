{
  "name": "@bench/app-lumen",
  "version": "0.0.0",
  "private": true,
  "description": "The Tracker app of the fullstack comparison benchmark (doc-4) in Lumen: server routes, async components with Suspense, form actions and islands.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "seed": "bench-seed",
    "dev": "lumen dev --port 4101 --host 127.0.0.1",
