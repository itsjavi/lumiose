    "typecheck": "lumen check",
    "clean": "rm -rf dist .lumen node_modules/.vite"
  },
  "dependencies": {
    "@bench/data": "workspace:*",
    "@bench/ui-css": "workspace:*",
    "@lumen/adapter-node": "workspace:*",
    "lumen": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.19.1"
  }
}
