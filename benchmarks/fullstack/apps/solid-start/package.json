{
  "name": "@bench/app-solid-start",
  "version": "0.0.0",
  "private": true,
  "description": "The Tracker app (doc-4) in SolidStart 2 with SSR, on Nitro's Node server.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "seed": "bench-seed",
    "dev": "vite dev --host 127.0.0.1 --port ${PORT:-4104} --strictPort",
    "build": "vite build",
    "start": "NODE_ENV=production node .output/server/index.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "rm -rf .output .nitro node_modules/.nitro node_modules/.vite"
  },
  "dependencies": {
    "@bench/data": "workspace:*",
    "@bench/ui-css": "workspace:*",
    "@solidjs/meta": "0.29.8",
    "@solidjs/router": "1.0.1",
    "@solidjs/start": "2.2.2",
    "nitro": "3.0.261103-rc",
    "solid-js": "1.9.18"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "7.0.2",
    "vite": "8.3.7"
  },
  "demo": {
    "name": "tracker-solid-start",
    "title": "Tracker in SolidStart (fullstack bench)",
    "kind": "benchmark",
    "setup": [
      "seed"
    ]
  }
}
