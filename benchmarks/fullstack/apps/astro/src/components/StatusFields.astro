---
import { STATUSES, STATUS_LABELS, type Status } from "@bench/data/format";

/** The status form's controls; the issue page renders the `<form>` around them. */
interface Props {
  status: Status;
}

const { status } = Astro.props;
---

<label class="field">
  <span class="field-label">Status</span>
  <select name="status" data-testid="status-select">
    {
      STATUSES.map((value) => (
        <option value={value} selected={value === status}>
          {STATUS_LABELS[value]}
        </option>
      ))
    }
  </select>
</label>
<button type="submit" class="btn" data-testid="status-submit">Update status</button>
