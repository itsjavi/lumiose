---
import {
  PRIORITIES,
  PRIORITY_LABELS,
  SORTS,
  SORT_LABELS,
  STATUSES,
  STATUS_LABELS,
  type IssueFilters,
  type Label,
} from "@bench/data/format";

/** The controls of the project page's GET filter form; the page renders the `<form>`. */
interface Props {
  filters: IssueFilters;
  labels: Label[];
}

const { filters, labels } = Astro.props;
---

<label class="filter">
  <span>Status</span>
  <select name="status">
    <option value="">Any</option>
    {
      STATUSES.map((status) => (
        <option value={status} selected={filters.status === status}>
          {STATUS_LABELS[status]}
        </option>
      ))
    }
  </select>
</label>
<label class="filter">
  <span>Priority</span>
  <select name="priority">
    <option value="">Any</option>
    {
      PRIORITIES.map((priority) => (
        <option value={priority} selected={filters.priority === priority}>
          {PRIORITY_LABELS[priority]}
        </option>
      ))
    }
  </select>
</label>
<label class="filter">
  <span>Label</span>
  <select name="label">
    <option value="">Any</option>
    {
      labels.map((label) => (
        <option value={label.name} selected={filters.label === label.name}>
          {label.name}
        </option>
      ))
    }
  </select>
</label>
<label class="filter">
  <span>Sort</span>
  <select name="sort">
    {
      SORTS.map((sort) => (
        <option value={sort} selected={filters.sort === sort}>
          {SORT_LABELS[sort]}
        </option>
      ))
    }
  </select>
</label>
<label class="filter filter-q">
  <span>Title</span>
  <input type="search" name="q" value={filters.q ?? ""} placeholder="Filter by title" />
</label>
<button type="submit" class="btn" data-testid="filter-submit">Apply</button>
