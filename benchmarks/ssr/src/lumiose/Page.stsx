import { formatPrice, type Item, type PageData } from "../data.ts";

function Badge(props: { kind: string; children?: JSX.Element }) {
  return <span class={`badge ${props.kind}`}>{props.children}</span>;
}

function Tags(props: { tags: string[] }) {
  return (
    <ul class="tags">
      {props.tags.map((tag) => (
        <li class="tag">{tag}</li>
      ))}
    </ul>
  );
}

function Row(props: { item: Item }) {
  return (
    <tr class={props.item.active ? "row active" : "row"} data-id={props.item.id}>
      <td class="id">{props.item.id}</td>
      <td class="label">
        <a href={props.item.url} title={props.item.label}>
          {props.item.label}
        </a>
        <p>{props.item.description}</p>
      </td>
      <td class="price">{formatPrice(props.item.price)}</td>
      <td class="tags">
        <Tags tags={props.item.tags} />
      </td>
      <td class="status">
        {props.item.active ? <Badge kind="ok">active</Badge> : <Badge kind="off">inactive</Badge>}
      </td>
    </tr>
  );
}

function Summary(props: { items: Item[] }) {
  let active = 0;
  let total = 0;
  for (const item of props.items) {
    if (item.active) active++;
    total += item.price;
  }
  return (
    <p>
      {props.items.length} items, {active} active, total {formatPrice(total)}
    </p>
  );
}

export function Page(props: { data: PageData }) {
  return (
    <div class="page">
      <header class="header">
        <h1>{props.data.title}</h1>
        <nav>
          {props.data.links.map((link) => (
            <a href={link.href}>{link.text}</a>
          ))}
        </nav>
      </header>
      <main>
        <table class="table">
          <thead>
            <tr>
              <th>#</th>
              <th>Label</th>
              <th>Price</th>
              <th>Tags</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            {props.data.items.map((item) => (
              <Row item={item} />
            ))}
          </tbody>
        </table>
      </main>
      <footer class="footer">
        <Summary items={props.data.items} />
      </footer>
    </div>
  );
}
