=== css
.card[data-l-qdse9v4z] {
  color: notacolor;
  width: 10 px;
  background-color: notacolor;
  margin: 8 px;
  padding: calc(8 px + 1px);
  rotate: 45;
  transition: opacity 200;
  grid-template-columns: 2fr repeat(auto-fit, minmax(9rem, 1fr));
  gap: 8px;
  width: calc(8 + 1px);
  max-width: min(100%, 600);
  font-size: 16px;
  display: flexbox !important;
}

.card[data-l-qdse9v4z] {
  @media print {
    color: nope;
  }

  display: grid-lanes;
  color: var(--c, notacolor);
  box-shadow: none;
  width: inherit;
  grid-template-columns: repeat(3, 1fr) repeat(auto-fill, 10rem);
  margin: 8px 0;
  line-height: 1.5;
}

@font-face {
  font-family: x;
  font-weight: 100 900;
}
