// @ref gap = 8
// @ref turn = 45
// @ref ratio = 3
// Constant math. Regular properties: Lightning CSS reduces math functions over compatible
// values (documented here so a Lightning CSS upgrade that changes it shows up). Custom
// properties: lumiose_css folds each math function that reduces to a single value, keeping
// `calc()` around values whose bare form could mean something else at the use site.
<style>
  .regular {
    padding: calc($gap * 2px);
    margin: min(10px, 20px) max(1rem, 2rem) clamp(4px, $gap * 1px, 12px);
    width: calc(100% - $gap * 2px);
    height: calc(1em + 2px);
    inset: calc(2px - 7px);
    padding-left: calc(2px - 7px);
    transform: rotate(calc($turn * 2deg));
    transition-duration: calc(2 * 150ms);
    opacity: calc(1 / 2);
    z-index: calc($ratio * 2);
    max-width: calc(var(--w) + 8 * 2px);
  }
  .custom {
    --space: calc($gap * 2px);
    --spaces: calc($gap * 1px) calc($gap * 2px), min(10px, 20px);
    --size: clamp(4px, $gap * 1px, 12px);
    --abs: calc(1in + 4px);
    --em: calc($gap * 0.25em);
    --percent: calc(50% * 2);
    --angle: rotate(calc($turn * 2deg)) skew(calc(1turn / 8));
    --sine: sin(30deg);
    --time: calc(2 * 150ms);
    --count: calc($ratio * 2);
    --ratio: calc(1 / $ratio);
    --negative: calc(2px - 7px);
    --zero: calc(0px * -1);
    --fallback: var(--missing, calc($gap * 3px));
    --nested: calc(calc($gap * 1px) * 2);
    --adjacent: calc(2px * 2)calc(1px);
    --upper: CALC(2px * 2);
  }
  .functions {
    --round: round(up, 2.5px, 1px);
    --mod: mod(10px, 3px);
    --rem: rem(-10px, 3px);
    --abs: abs(-50%);
    --sign-length: sign(-2px);
    --sign-percent: sign(50%);
    --pow: pow(2, 3);
    --sqrt: sqrt(16);
    --hypot: hypot(3px, 4px);
    --log: log(8, 2);
    --exp: exp(0);
    --atan2: atan2(1px, 1px);
    --atan2-percent: atan2(50%, 50%);
    --clamp-percent: clamp(1%, 50%, 10%);
    --pi: calc(pi * 1deg);
  }
  .untouched {
    --mixed: calc(100% - $gap * 2px);
    --relative: calc(1em + 2px);
    --viewport: min(10vw, 100px);
    --var: calc(var(--gap) * 2);
    --env: calc(env(safe-area-inset-top) + 4px);
    --incompatible: calc(2 + 2px);
    --divide-by-zero: calc(1px / 0);
    --infinite: calc(infinity * 1px);
    --partial: calc(100% - min(4px, 8px));
    --not-math: translate(10px, 20px);
    unknown-property: calc(8 * 2px);
  }
</style>
