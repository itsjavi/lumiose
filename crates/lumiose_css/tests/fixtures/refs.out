=== css
.profile[data-l-uk1rwesc] {
  opacity: .5;
  --gap: 4;
  border-radius: 8px;
  padding: 4px 8px;
  font-family: Inter, sans-serif;
}

@media (width < 48rem) {
  .profile[data-l-uk1rwesc] {
    padding: 0;
  }
}

@container (width >= 20rem) {
  .profile[data-l-uk1rwesc] {
    display: grid;
  }
}

@supports (aspect-ratio: 0.5) {
  .profile[data-l-uk1rwesc] {
    aspect-ratio: 1;
  }
}

a[href$=".pdf"][data-l-uk1rwesc] {
  color: red;
}

.profile[data-l-uk1rwesc]:after {
  content: "$gap";
  background: url("$gap.png");
}

.missing[data-l-uk1rwesc] {
  width: $unknown;
}

.bad[data-l-uk1rwesc] {
  color: $brand-primary;
  margin: calc($gap2-1px);
}
