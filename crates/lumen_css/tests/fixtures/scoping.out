.card[data-l-ek2xlvuu] {
  padding: 1rem;
}

.card > h2 + p ~ span[data-l-ek2xlvuu], a[href$=".pdf"][data-l-ek2xlvuu] {
  color: var(--accent, red);
}

.card[data-l-ek2xlvuu]:before, .card:hover[data-l-ek2xlvuu]:after, [data-l-ek2xlvuu]::selection {
  content: "";
}

.card[data-l-ek2xlvuu] {
  --accent: tomato;

  &:hover {
    color: var(--accent);
  }

  & .title[data-l-ek2xlvuu] {
    font-weight: bold;
  }

  & .meta[data-l-ek2xlvuu]:after {
    content: "→";
