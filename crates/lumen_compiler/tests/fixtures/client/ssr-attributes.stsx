// Server attribute order follows the client DOM: static and baked attributes, scope tokens, then
// dynamic ones. Properties: innerHTML/textContent/textarea value become content on the server.
import { signal } from "lumen";

export function Field(props: { class?: string; size: number; rest: Record<string, unknown> }) {
  const name = signal('Ada "the" <first>');
  const on = signal(true);
  return (
    <form title={name()} method="post" class={props.class} aria-busy={on()} hidden={!on()}>
      <input value={name()} disabled={on()} readonly={false} onInput={() => {}} />
      <input bind:value={name} ref={() => {}} />
      <p class={{ on: on(), base: true }} style={{ width: props.size + "px", color: "red" }} />
      <div innerHTML={"<i>" + props.size + "</i>"}>ignored</div>
      <span textContent={name()} />
      <textarea value={name()} />
      <textarea value="literal" />
      <b {...props.rest} id="last" onClick={() => {}} />
      <style>.on { color: green; }</style>
    </form>
  );
}
