import { Suspense } from "lumen";

export function InComponent() {
  return (
    <Suspense>
      <style>.a { color: red }</style>
    </Suspense>
  );
}

export function InContainer(props: { show: boolean; items: string[] }) {
  return (
    <div>
      {props.show && <p><style>.b { color: blue }</style></p>}
      {props.items.map((item) => (
        <li>
          {item}
          <style>.c { color: $item }</style>
        </li>
      ))}
    </div>
  );
}

export function InTernary(props: { ok: boolean }) {
  return props.ok ? (
    <p>
      ok<style>.d {}</style>
    </p>
  ) : null;
}

export function Returned() {
  return <style>.e { color: red }</style>;
}

export const Arrow = () => <style>.f {}</style>;

export const OnlyStyle = () => (
  <>
    <style>.g {}</style>
  </>
);

export function AsStatement() {
  <style>.h {}</style>;
  return <div />;
}

export const InAttribute = () => <div title=<style>.i {}</style> />;
