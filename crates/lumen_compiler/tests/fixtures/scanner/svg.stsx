export function Logo() {
  return (
    <svg viewBox="0 0 10 10">
      <style type="text/css">
        .st0 { fill: $notARef; }
        [id$="x"] { opacity: .5 }
      </style>
      <g>
        <style>.nested { fill: red }</style>
      </g>
      <foreignObject>
        <div>
          <style>.html { color: $color }</style>
        </div>
      </foreignObject>
      <circle class="st0" r="4" />
    </svg>
  );
}

const color = "red";
