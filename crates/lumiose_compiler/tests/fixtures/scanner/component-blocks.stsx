import { signal } from "lumiose";

const gap = 8;

export function Counter() {
  const count = signal(0);
  const accent = "tomato";
  return (
    <div class="counter">
      <button onClick={() => count.update((n) => n + 1)}>Don't click {count()}</button>
      <style>
        .counter { display: flex; gap: $gap; }
        button { color: $accent }
      </style>
    </div>
  );
}

export const Badge = (props: { label: string }) => (
  <>
    <span class="badge">{props.label}</span>
    <style>
      .badge { border: 1px solid $accent.dark; }
    </style>
  </>
);

export function Deep() {
  return (
    <main>
      <section>
        <ul>
          <li>
            text<style>li { margin: 0 }</style>more text
          </li>
        </ul>
      </section>
    </main>
  );
}
