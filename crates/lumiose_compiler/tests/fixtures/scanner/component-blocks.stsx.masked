import { signal } from "lumiose";

const gap = 8;

export function Counter() {
  const count = signal(0);
  const accent = "tomato";
  return (
    <div class="counter">
      <button onClick={() => count.update((n) => n + 1)}>Don't click {count()}</button>
             
                                       {gap}  
                        {accent} 
              
    </div>
  );
}

export const Badge = (props: { label: string }) => (
  <>
    <span class="badge">{props.label}</span>
           
                                 {accent.dark}  
            
  </>
);

export function Deep() {
  return (
    <main>
      <section>
        <ul>
          <li>
            text                               more text
          </li>
        </ul>
      </section>
    </main>
  );
}
