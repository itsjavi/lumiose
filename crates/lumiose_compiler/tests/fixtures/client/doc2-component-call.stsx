// Contract doc-2 §5.3: component call with props, children and class passthrough.
import type { JSX } from "lumiose/jsx-runtime";

export function Card(props: { title: string; class?: string; children?: JSX.Element }) {
  return (
    <article class={props.class}>
      <h2>{props.title}</h2>
      {props.children}
      <style>h2 { margin: 0; }</style>
    </article>
  );
}

export function Page({ post }: { post: () => { title: string; body: string } }) {
  return (
    <main>
      <Card title={post().title} class="featured">{post().body}</Card>
      <style>.featured { color: teal; }</style>
    </main>
  );
}
