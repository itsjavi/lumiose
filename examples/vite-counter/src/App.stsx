import { Counter } from "./Counter.stsx";
import { Todos } from "./Todos.stsx";
import { vars } from "./vars.ts";

/** The Lumiose website, when this app is published on it (scripts/site.ts sets the variable). */
const LUMIOSE_SITE: string | undefined = import.meta.env.PUBLIC_LUMIOSE_SITE;

export function App() {
  return (
    <main>
      <h1>Lumiose + Vite</h1>
      <Counter start={0} class="panel" />
      <Todos class="panel" />
      {LUMIOSE_SITE && (
        <footer>
          Made with <a href={LUMIOSE_SITE}>Lumiose</a>
        </footer>
      )}
    </main>
  );
}

<style>
  main {
    max-width: 40rem;
    margin: 0 auto;
    padding: calc(var($vars.space) * 4);
  }
  h1 {
    color: var($vars.accent);
  }
  footer {
    font-size: 0.875rem;
    color: #666;
  }
  footer a {
    color: var($vars.accent);
  }

  /* Class passthrough: lands on the element where Counter and Todos apply `props.class`. */
  .panel {
    border: 1px solid var($vars.border);
    border-radius: var($vars.radius);
    padding: calc(var($vars.space) * 3);
    margin-block: calc(var($vars.space) * 4);
  }
</style>

<style global>
  /* The design tokens: custom properties, named in vars.ts. */
  :root {
    --accent: #4f46e5;
    --danger: #dc2626;
    --border: #d4d4d8;
    --radius: 8px;
    --space: 4px;
  }
  body {
    margin: 0;
    font-family: system-ui, sans-serif;
  }
</style>
