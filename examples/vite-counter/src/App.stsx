import { Counter } from "./Counter.stsx";
import { Todos } from "./Todos.stsx";
import { theme } from "./tokens.ts";

/** The Lumiose website, when this app is published on it (scripts/site.ts sets the variable). */
const LUMIOSE_SITE: string | undefined = import.meta.env.PUBLIC_LUMIOSE_SITE;

export function App() {
  return (
    <main>
      <h1>Lumiose + Vite</h1>
      <Counter start={0} class="panel" />
      <Todos class="panel" />
      {LUMIOSE_SITE && (
        <footer>
          Made with <a href={LUMIOSE_SITE}>Lumiose</a>
        </footer>
      )}
    </main>
  );
}

<style>
  main {
    max-width: 40rem;
    margin: 0 auto;
    padding: calc($theme.space * 4px);
  }
  h1 {
    color: $theme.accent;
  }
  footer {
    font-size: 0.875rem;
    color: #666;
  }
  footer a {
    color: $theme.accent;
  }

  /* Class passthrough: lands on the element where Counter and Todos apply `props.class`. */
  .panel {
    border: 1px solid $theme.border;
    border-radius: calc($theme.radius * 1px);
    padding: calc($theme.space * 3px);
    margin-block: calc($theme.space * 4px);
  }
</style>

<style global>
  body {
    margin: 0;
    font-family: system-ui, sans-serif;
  }
</style>
