import { signal } from "lumiose";
import { vars } from "./vars.ts";

export function Counter({ start = 0, class: className }: { start?: number; class?: string }) {
  const count = signal(start);
  return (
    <section class={["counter", className]}>
      <h2>Counter</h2>
      <button class={{ hot: count() > 5 }} onClick={() => count.update((c) => c + 1)}>
        Clicked {count()} times
      </button>
      <button onClick={() => count.set(start)}>Reset</button>
    </section>
  );
}

<style>
  h2 {
    color: var($vars.accent);
  }
  button {
    background: var($vars.accent);
    color: white;
    border: 0;
    border-radius: var($vars.radius);
    padding: var($vars.space) calc(var($vars.space) * 3);
  }
  button + button {
    margin-inline-start: calc(var($vars.space) * 2);
  }
  .hot {
    background: var($vars.danger);
  }
</style>
