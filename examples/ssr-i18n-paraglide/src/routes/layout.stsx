// The root layout: the site name, the navigation and the language switcher, in the page's locale.
import { alternates, href, locale, type LayoutProps, type Locale } from "lumiose";
import { LocaleSwitcher } from "../islands/LocaleSwitcher.stsx";
import { m } from "../lib/i18n.ts";

/** The locales of /about (its `export const locales`): other locales link to the English page. */
const ABOUT_LOCALES: readonly Locale[] = ["en", "es"];

/** /about in the current locale when it has one, else in English. */
function aboutHref(): string {
  return href("/about", { locale: ABOUT_LOCALES.includes(locale()) ? locale() : "en" });
}

export default function Layout(props: LayoutProps<"/">) {
  return (
    <div class="site">
      <header>
        <a class="brand" href={href("/")}>
          {m.site_name()}
        </a>
        <nav>
          <a href={aboutHref()}>{m.nav_about()}</a>
        </nav>
        <LocaleSwitcher client:load label={m.nav_language()} alternates={alternates()} />
      </header>
      {props.children}
    </div>
  );
}

<style>
  .site {
    max-width: 40rem;
    margin: 0 auto;
    padding: 1.5rem 1rem;
  }
  header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-bottom: 2rem;
  }
  .brand {
    font-weight: 700;
    margin-right: auto;
  }
</style>

<style global>
  body {
    margin: 0;
    font:
      16px/1.5 system-ui,
      sans-serif;
    color: #2b2118;
    background: #fffaf2;
  }
  a {
    color: #8a4b12;
  }
  button {
    font: inherit;
    padding: 0.4rem 0.8rem;
  }
</style>
