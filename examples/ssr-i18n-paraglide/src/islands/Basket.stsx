// An island with messages: the same m.*() calls render on the server and run again in the browser,
// in the page's locale. The island's chunk holds only the two messages it uses.
import { signal } from "lumiose";
import { m } from "../lib/i18n.ts";

export function Basket() {
  const count = signal(0);
  return (
    <div class="basket">
      <p aria-live="polite">{m.basket_count({ count: count() })}</p>
      <button type="button" onClick={() => count.update((n) => n + 1)}>
        {m.basket_add()}
      </button>
    </div>
  );
}

<style>
  .basket {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 1rem;
    border: 1px solid #e4d8c4;
    border-radius: 0.5rem;
  }
  p {
    margin: 0;
  }
</style>
