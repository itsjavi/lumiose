{
  "name": "@lumiose-examples/ssr-i18n-paraglide",
  "version": "0.0.0",
  "private": true,
  "description": "Lumiose sample: a translated site with locale routing and Paraglide JS compile-time messages.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "lumiose dev",
    "build": "lumiose build",
    "start": "node server.ts",
    "typecheck": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations --silent && lumiose check",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@lumiose/adapter-node": "workspace:*",
    "lumiose": "workspace:*"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.27.0",
    "@inlang/plugin-message-format": "4.5.0",
    "@lumiose/cli": "workspace:*",
    "@lumiose/vite": "workspace:*",
    "@playwright/test": "1.63.0"
  },
  "demo": {
    "title": "i18n with Paraglide JS (server-rendered)",
    "kind": "example"
  }
}
