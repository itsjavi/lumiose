// Learn: the four channels and their tricks, each with buttons to hear it, then how songs are put
// together, and credits.
import { href } from "lumiose";
import { Link } from "lumiose/router";
import { noteData, sfxData } from "../../audio/driver.ts";
import { playOnce } from "../../audio/player.ts";
import { WAVES } from "../../audio/tables.ts";
import { DRUMS, DUTY_NAMES, instrument } from "../../model/instruments.ts";
import type {
  ChannelIndex,
  Instrument,
  Sfx,
  SfxNote,
  Track,
  WaveShape,
} from "../../model/types.ts";
import { say } from "../../state.ts";

const note = (fields: Partial<SfxNote>): SfxNote => ({
  frames: 30,
  volume: 12,
  env: 0,
  pitch: 72,
  duty: 2,
  sweep: 0,
  noise: 0,
  ...fields,
});

function hearSfx(notes: SfxNote[]) {
  const sfx: Sfx = { id: "learn", name: "learn", blurb: "", voices: [{ channel: 0, notes }] };
  void playOnce(sfxData(sfx)).catch((error: unknown) => say(`Audio failed: ${String(error)}`));
}

function hearTrack(ch: ChannelIndex, inst: Instrument, pitch: number, steps: number) {
  const track: Track = { inst, notes: [], mute: false, solo: false, pan: "C" };
  void playOnce(noteData(track, ch, pitch, steps, { bpm: 120 })).catch((error: unknown) =>
    say(`Audio failed: ${String(error)}`),
  );
}

const melody = (fields: Partial<SfxNote>) =>
  [67, 71, 74, 79].map((pitch) => note({ ...fields, pitch, frames: 12 }));

export default function Learn() {
  return (
    <article class="learn">
      <header class="intro">
        <h1>How a pocket console makes music</h1>
        <p>
          The handheld has just four sound channels, and every song and sound effect is built from
          them. They are simple, so each trick below is something you can hear in a second. Press
          the buttons.
        </p>
      </header>

      <section class="panel card c0">
        <h2>Pulse 1 and Pulse 2: square waves</h2>
        <p>
          The two pulse channels play square waves. The <b>duty cycle</b> is how much of each wave
          is "on": thin and nasal at 12.5%, round and hollow at 50%. Leads and harmonies live here.
        </p>
        <div class="hear">
          {[0, 1, 2, 3].map((duty) => (
            <button type="button" class="btn" onClick={() => hearSfx(melody({ duty }))}>
              ▶ {DUTY_NAMES[duty]}
            </button>
          ))}
        </div>
        <p>
          The <b>envelope</b> changes the volume by itself: hold it, let it fade (pianos, bells), or
          swell in (brass).
        </p>
        <div class="hear">
          <button type="button" class="btn" onClick={() => hearSfx([note({ frames: 50 })])}>
            ▶ Hold
          </button>
          <button type="button" class="btn" onClick={() => hearSfx([note({ frames: 50, env: 5 })])}>
            ▶ Fade
          </button>
          <button
            type="button"
            class="btn"
            onClick={() => hearSfx([note({ frames: 50, volume: 2, env: -5 })])}
          >
            ▶ Swell
          </button>
        </div>
        <p>
          <b>Vibrato</b> wobbles the pitch, usually after a short delay so quick notes stay clean.
          The sound driver does it by nudging the frequency once per frame, 60 times a second.
        </p>
        <div class="hear">
          <button
            type="button"
            class="btn"
            onClick={() =>
              hearTrack(
                0,
                { ...instrument("pulse", "hero"), vibrato: { delay: 0, depth: 0, rate: 3 } },
                76,
                12,
              )
            }
          >
            ▶ Plain
          </button>
          <button
            type="button"
            class="btn"
            onClick={() => hearTrack(0, instrument("pulse", "hero"), 76, 12)}
          >
            ▶ Late vibrato
          </button>
          <button
            type="button"
            class="btn"
            onClick={() => hearTrack(0, instrument("pulse", "arp"), 72, 12)}
          >
            ▶ Arpeggio
          </button>
        </div>
        <p>
          Pulse 1 also has a hardware <b>pitch sweep</b> that slides the pitch up or down on its
          own: jumps, lasers and falling sounds.
        </p>
        <div class="hear">
          <button
            type="button"
            class="btn"
            onClick={() => hearSfx([note({ frames: 20, pitch: 60, sweep: 3, env: 2 })])}
          >
            ▶ Sweep up
          </button>
          <button
            type="button"
            class="btn"
            onClick={() => hearSfx([note({ frames: 40, pitch: 84, sweep: -2, env: 1 })])}
          >
            ▶ Sweep down
          </button>
        </div>
      </section>

      <section class="panel card c2">
        <h2>Wave: draw your own shape</h2>
        <p>
          The wave channel plays a tiny table of 32 samples, each 0 to 15, so it can sound soft,
          buzzy or hollow. It has no envelope, only four volume levels, so it shines as bass and
          soft pads.
        </p>
        <div class="hear">
          {(Object.keys(WAVES) as WaveShape[]).map((shape) => (
            <button
              type="button"
              class="btn"
              onClick={() => hearTrack(2, { ...instrument("wave", "round"), shape }, 45, 8)}
            >
              ▶ {WAVES[shape].name}
            </button>
          ))}
        </div>
      </section>

      <section class="panel card c3">
        <h2>Noise: the drum kit</h2>
        <p>
          The noise channel plays hiss. Changing how fast and how "metallic" the hiss is, frame by
          frame, turns it into kicks, snares and hats. Each drum here is a few frames of noise
          settings.
        </p>
        <div class="hear">
          {DRUMS.map((drum, i) => (
            <button
              type="button"
              class="btn"
              onClick={() => hearTrack(3, instrument("noise", "kit"), i, 4)}
            >
              ▶ {drum.name}
            </button>
          ))}
        </div>
      </section>

      <section class="panel card">
        <h2>Creature voices</h2>
        <p>
          A creature's cry is a short sound effect on the two pulses and the noise channel. Games
          kept only a few base voices and gave each creature two numbers: a pitch added to every
          note's frequency register, and a length that stretches the notes. Meet twenty in the{" "}
          <Link class="link" href={href("/creatures")}>
            Creatures
          </Link>{" "}
          room, then remix them.
        </p>
        <p>
          Want to write your own music, effects and voices? The{" "}
          <Link class="link" href={href("/learn/composing")}>
            composing guide
          </Link>{" "}
          walks through all of it, with recipes.
        </p>
      </section>

      <section class="panel card">
        <h2>From notes to a song</h2>
        <ul>
          <li>
            A bar has 16 steps. A step is a sixteenth note; the tempo (BPM) says how many quarter
            notes (4 steps) play per minute.
          </li>
          <li>
            Each channel plays one note at a time: two notes on the same channel never overlap.
          </li>
          <li>
            Songs loop. The bars before the loop bar are an <b>intro</b> that plays once; the rest
            repeats forever, like in a game. Pick a bar and press "Loop from here".
          </li>
          <li>
            The key and scale decide the rows of the grid, so every note you place fits. Pick
            "Chromatic" for every semitone.
          </li>
          <li>
            Start from a{" "}
            <Link class="link" href={href("/songs")}>
              demo song
            </Link>
            : change a preset, mute a channel, move a few notes. Undo is always there.
          </li>
        </ul>
      </section>

      <section class="panel card credits">
        <h2>Credits</h2>
        <ul>
          <li>
            Sound: <b>gbapu</b>, the author's Game Boy APU emulator and offline renderer (MIT), a
            TypeScript port of stoneface's gbapu; vendored in <code>vendor/gbapu</code>.
          </li>
          <li>
            The sound driver (notes, vibrato, slides, arpeggios, drums), the instrument presets,
            wave tables, drum kit, demo songs, sound effects, base voices and creatures were written
            for this sample. No game music, sound effects or data are used.
          </li>
          <li>
            Fonts: Silkscreen by Jason Kottke and Space Grotesk by Florian Karsten, both under the
            SIL Open Font License.
          </li>
          <li>Built with Lumiose, as a client-rendered single-page app.</li>
        </ul>
      </section>
    </article>
  );
}

<style>
  .learn {
    display: grid;
    gap: 16px;
    max-inline-size: 920px;
    margin-inline: auto;
  }
  .intro h1 {
    font-size: 24px;
    color: var(--indigo);
  }
  .intro p {
    margin: 6px 0 0;
    color: var(--dim);
    max-inline-size: 70ch;
  }
  .card {
    display: grid;
    gap: 10px;
    border-inline-start: 6px solid var(--edge);
  }
  .c0 {
    border-inline-start-color: var(--c0);
  }
  .c2 {
    border-inline-start-color: var(--c2);
  }
  .c3 {
    border-inline-start-color: var(--c3);
  }
  h2 {
    font-size: 16px;
  }
  p,
  ul {
    margin: 0;
    max-inline-size: 72ch;
  }
  ul {
    display: grid;
    gap: 6px;
    padding-inline-start: 20px;
  }
  .hear {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .link {
    color: var(--indigo);
  }
  code {
    font-size: 13px;
  }
  .credits {
    font-size: 14px;
  }
</style>
