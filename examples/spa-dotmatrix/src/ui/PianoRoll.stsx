// The screen: a dot-matrix piano roll for the selected channel. Rows are the song's scale (or the
// drum kit on the noise channel), columns are 16th-note steps. Click an empty cell to add a note
// (drag to make it longer), click a note to remove it, drag a note's row to resize it. With focus,
// the arrow keys move a cursor and Enter adds or removes a note.
import { computed, effect, onCleanup, signal, untrack } from "lumiose";
import { noteData } from "../audio/driver.ts";
import { nowPlaying, playOnce, playStep } from "../audio/player.ts";
import { setGridFocused } from "../keys.ts";
import { DRUMS, presetName } from "../model/instruments.ts";
import { noteName, scaleRows } from "../model/music.ts";
import { noteAt, placeNote, removeNote } from "../model/song.ts";
import {
  CHANNELS,
  NOTE_OVERRIDES,
  STEPS_PER_BAR,
  type ChannelIndex,
  type Note,
} from "../model/types.ts";
import { doc, edit, editor, plainSong, prefs } from "../state.ts";
import { tokens } from "../tokens.ts";
import { StudioCode } from "./StudioCode.stsx";

const SPAN = 24;

/** Noise settings offered as rows on a sound sheet (NR43: clock shift, width, divisor), bright to dark. */
const NOISE_ROWS = [
  0x00, 0x01, 0x02, 0x11, 0x12, 0x21, 0x22, 0x23, 0x31, 0x33, 0x41, 0x45, 0x51, 0x55, 0x61, 0x66,
  0x71, 0x77,
];
const hex2 = (n: number) => `$${n.toString(16).toUpperCase().padStart(2, "0")}`;
const hasOwn = (n: Note) => NOTE_OVERRIDES.some((k) => n[k] !== undefined);
let gesture = 0;

export function audition(ch: ChannelIndex, pitch: number, steps: number): void {
  const song = plainSong();
  void playOnce(noteData(song.tracks[ch], ch, pitch, Math.min(steps, 8), song)).catch(() => {});
}

const ch = () => editor.channel;
const total = () => doc.song.bars * STEPS_PER_BAR;
const ticks = () => doc.song.sheet?.ticks ?? 0;
const playing = () => nowPlaying() === "editor" && playStep() >= 0;

export function PianoRoll() {
  const kind = () => CHANNELS[ch()].kind;
  const track = () => doc.song.tracks[ch()];
  /** The noise channel plays the drum kit in songs, and raw noise settings on sound sheets. */
  const drums = () => kind() === "noise" && !doc.song.sheet;

  const rows = computed((): number[] => {
    if (drums()) return DRUMS.map((_, i) => i);
    if (kind() === "noise") {
      const set = new Set([...NOISE_ROWS, ...track().notes.map((n) => n.p)]);
      return [...set].toSorted((a, b) => (a >> 4) - (b >> 4) || (a & 15) - (b & 15));
    }
    const used = track().notes.map((n) => n.p);
    const low = Math.min(editor.low[ch()]!, ...used);
    const high = Math.max(editor.low[ch()]! + SPAN, ...used);
    return scaleRows(low, high, doc.song.key, doc.song.scale, used);
  });
  const rowOf = computed(() => new Map(rows().map((p, i) => [p, i])));

  /** Notes of the other pitched channels, drawn faintly on this channel's rows. */
  const ghosts = computed(() => {
    if (kind() === "noise") return [];
    const map = rowOf();
    return doc.song.tracks.flatMap((t, c) =>
      c === ch() || c === 3
        ? []
        : t.notes.filter((n) => map.has(n.p)).map((n) => ({ n, c, row: map.get(n.p)! })),
    );
  });

  const focused = signal(false);
  const live = signal("");

  let lane: HTMLDivElement | undefined;
  let roll: HTMLDivElement | undefined;

  const narrow = matchMedia("(width < 720px)");
  const wide = signal(!narrow.matches);
  const onWidth = () => wide.set(!narrow.matches);
  narrow.addEventListener("change", onWidth);
  onCleanup(() => narrow.removeEventListener("change", onWidth));
  const cellW = () => (wide() ? 22 : 26);
  const cellH = 18;

  function cellAt(event: PointerEvent): { step: number; row: number } {
    const rect = lane!.getBoundingClientRect();
    const w = rect.width / total();
    return {
      step: Math.min(total() - 1, Math.max(0, Math.floor((event.clientX - rect.left) / w))),
      row: Math.min(rows().length - 1, Math.max(0, Math.floor((event.clientY - rect.top) / cellH))),
    };
  }

  const hitAt = (step: number, pitch: number): Note | undefined =>
    track().notes.find((n) => n.p === pitch && n.s <= step && step < n.s + n.l);

  function setNotes(label: string, notes: Note[], key?: string) {
    const c = ch();
    edit(label, (song) => (song.tracks[c].notes = notes), key);
  }

  function addNote(step: number, pitch: number, len: number, key?: string): Note {
    const note = { s: step, l: drums() ? 1 : Math.min(len, total() - step), p: pitch };
    setNotes(
      drums() ? `Add ${DRUMS[pitch]!.name.toLowerCase()}` : "Add note",
      placeNote(track().notes, note, total()),
      key,
    );
    audition(ch(), pitch, note.l);
    return note;
  }

  function resize(note: Note, len: number, key: string) {
    const l = Math.max(1, Math.min(len, total() - note.s));
    const without = removeNote(track().notes, note);
    setNotes("Change note length", placeNote(without, { ...note, l }, total()), key);
  }

  // --- Pointer ---

  type Drag =
    | { mode: "resize"; note: Note; key: string }
    | { mode: "maybe-remove"; note: Note; step: number; key: string }
    | { mode: "paint"; key: string; row: number; last: number };
  let drag: Drag | undefined;

  function onPointerDown(event: PointerEvent) {
    if (event.button !== 0 || !lane) return;
    event.preventDefault();
    lane.focus({ preventScroll: true });
    lane.setPointerCapture(event.pointerId);
    const { step, row } = cellAt(event);
    const pitch = rows()[row]!;
    const key = `pen:${++gesture}`;
    editor.cursor = { step, pitch };
    const hit = hitAt(step, pitch);
    if (drums()) {
      if (hit)
        setNotes(`Remove ${DRUMS[pitch]!.name.toLowerCase()}`, removeNote(track().notes, hit), key);
      else addNote(step, pitch, 1, key);
      drag = hit ? undefined : { mode: "paint", key, row, last: step };
      return;
    }
    if (hit) drag = { mode: "maybe-remove", note: hit, step, key };
    else drag = { mode: "resize", note: addNote(step, pitch, prefs.noteLength, key), key };
  }

  function onPointerMove(event: PointerEvent) {
    if (!drag) return;
    const { step } = cellAt(event);
    if (drag.mode === "paint") {
      if (step === drag.last) return;
      drag.last = step;
      const pitch = rows()[drag.row]!;
      if (!hitAt(step, pitch)) addNote(step, pitch, 1, drag.key);
      return;
    }
    if (drag.mode === "maybe-remove") {
      if (step === drag.step) return;
      drag = { mode: "resize", note: drag.note, key: drag.key };
    }
    const len = step - drag.note.s + 1;
    if (len === drag.note.l || len < 1) return;
    resize(drag.note, len, drag.key);
    drag.note = { ...drag.note, l: Math.max(1, Math.min(len, total() - drag.note.s)) };
  }

  function onPointerUp() {
    if (drag?.mode === "maybe-remove")
      setNotes("Remove note", removeNote(track().notes, drag.note), drag.key);
    drag = undefined;
  }

  // --- Keyboard ---

  function describe() {
    const { step, pitch } = editor.cursor;
    const hit =
      hitAt(step, pitch) ??
      noteAt(
        track().notes.filter((n) => n.p === pitch),
        step,
      );
    const name = rowLabel(pitch);
    const bar = Math.floor(step / STEPS_PER_BAR) + 1;
    live.set(
      `Bar ${bar}, step ${(step % STEPS_PER_BAR) + 1}, ${name}${hit ? `, note of ${hit.l} steps` : ""}`,
    );
  }

  function moveCursor(dStep: number, dRow: number) {
    const list = rows();
    const { step, pitch } = editor.cursor;
    const at = rowOf().get(pitch) ?? 0;
    const row = Math.min(list.length - 1, Math.max(0, at + dRow));
    editor.cursor = { step: Math.min(total() - 1, Math.max(0, step + dStep)), pitch: list[row]! };
    describe();
    scrollToStep(editor.cursor.step, false);
  }

  function onKeyDown(event: KeyboardEvent) {
    const { step, pitch } = editor.cursor;
    const hit = hitAt(step, pitch);
    const key = event.key;
    let handled = true;
    if (key === "ArrowLeft" && event.shiftKey) {
      if (hit && !drums()) resize(hit, hit.l - 1, `key:${hit.s}:${hit.p}`);
    } else if (key === "ArrowRight" && event.shiftKey) {
      if (hit && !drums()) resize(hit, hit.l + 1, `key:${hit.s}:${hit.p}`);
    } else if (key === "ArrowLeft")
      moveCursor(event.ctrlKey || event.metaKey ? -STEPS_PER_BAR : -1, 0);
    else if (key === "ArrowRight")
      moveCursor(event.ctrlKey || event.metaKey ? STEPS_PER_BAR : 1, 0);
    else if (key === "ArrowUp") moveCursor(0, -1);
    else if (key === "ArrowDown") moveCursor(0, 1);
    else if (key === "Home") moveCursor(-step, 0);
    else if (key === "End") moveCursor(total() - 1 - step, 0);
    else if (key === "Enter") {
      if (hit) setNotes("Remove note", removeNote(track().notes, hit));
      else addNote(step, pitch, prefs.noteLength);
      describe();
    } else if (key === "Delete" || key === "Backspace") {
      if (hit) setNotes("Remove note", removeNote(track().notes, hit));
      describe();
    } else handled = false;
    if (handled) event.preventDefault();
  }

  // --- Scrolling ---

  function scrollToStep(step: number, lead: boolean) {
    if (!roll) return;
    const x = step * cellW();
    const keys = 52;
    const view = roll.clientWidth - keys;
    const left = roll.scrollLeft;
    if (x < left || x > left + view - cellW() * 2) {
      roll.scrollTo({
        left: lead ? Math.max(0, x - view / 4) : Math.max(0, x - view / 2),
        behavior: "auto",
      });
    }
  }

  // Follow the playhead while the studio song plays.
  effect(() => {
    const step = playStep();
    if (nowPlaying() !== "editor" || step < 0) return;
    untrack(() => scrollToStep(step, true));
  });

  // Keep the cursor on a visible row when the channel or the rows change.
  effect(() => {
    const list = rows();
    untrack(() => {
      if (!rowOf().has(editor.cursor.pitch)) {
        const mid = list[Math.floor(list.length / 2)] ?? 0;
        editor.cursor = { step: Math.min(editor.cursor.step, total() - 1), pitch: mid };
      }
    });
  });

  onCleanup(() => setGridFocused(false));

  const rowLabel = (p: number) =>
    drums() ? DRUMS[p]!.short : kind() === "noise" ? hex2(p) : noteName(p);
  const isRoot = (p: number) => kind() !== "noise" && (((p - doc.song.key) % 12) + 12) % 12 === 0;

  return (
    <section class="screen" aria-label="Piano roll">
      <div class="bezel">
        <div class="lcd">
          <div class="top">
            <div class="status" aria-hidden="true">
              <span class="chan">{CHANNELS[ch()].short}</span>
              <span>{presetName(kind(), track().inst.preset).toUpperCase()}</span>
              <span class="grow" />
              {doc.song.sheet ? (
                <span>
                  FRAME{" "}
                  {String(
                    Math.max(0, playing() ? playStep() : editor.cursor.step) * ticks(),
                  ).padStart(3, "0")}
                </span>
              ) : null}
              <span class={{ hidden: !!doc.song.sheet }}>
                BAR{" "}
                {String(
                  Math.floor(
                    Math.max(0, playing() ? playStep() : editor.cursor.step) / STEPS_PER_BAR,
                  ) + 1,
                ).padStart(2, "0")}
                /{String(doc.song.bars).padStart(2, "0")}
              </span>
              <span>{doc.song.sheet ? `${ticks()} F/STEP` : `${doc.song.bpm} BPM`}</span>
            </div>
            <div class="views" role="radiogroup" aria-label="Screen view">
              {(["grid", "code"] as const).map((v) => (
                <button
                  type="button"
                  role="radio"
                  class="view"
                  aria-checked={editor.view === v}
                  onClick={() => (editor.view = v)}
                >
                  {v === "grid" ? "Grid" : "Code"}
                </button>
              ))}
            </div>
          </div>
          {editor.view === "code" ? (
            <StudioCode />
          ) : (
            <div
              class="roll"
              ref={(el) => (roll = el)}
              style={{ "--cw": `${cellW()}px`, "--chh": `${cellH}px` }}
            >
              <div
                class="sheet"
                style={{ "--steps": String(total()), "--rows": String(rows().length) }}
              >
                <div class="corner" />
                <div class="ruler" aria-hidden="true">
                  {Array.from({ length: doc.song.bars }, (_, bar) => (
                    <span
                      class={["barno", { picked: bar === editor.bar }]}
                      style={{ "--b": String(bar) }}
                      onClick={() => (editor.bar = bar)}
                    >
                      {doc.song.sheet ? `${bar * STEPS_PER_BAR * ticks()}f` : bar + 1}
                      {bar === doc.song.loop && doc.song.loop > 0 ? (
                        <span class="flag">LOOP</span>
                      ) : null}
                    </span>
                  ))}
                </div>
                <div class="keys" aria-hidden="true">
                  {rows().map((p) => (
                    <span class={["key", { root: isRoot(p) }]}>{rowLabel(p)}</span>
                  ))}
                </div>
                <div
                  class={["lane", kind()]}
                  ref={(el) => (lane = el)}
                  tabindex="0"
                  role="application"
                  aria-roledescription="piano roll"
                  aria-label={`${CHANNELS[ch()].name} notes. Arrow keys move, Enter adds or removes a note, Shift with arrows changes its length.`}
                  onPointerDown={onPointerDown}
                  onPointerMove={onPointerMove}
                  onPointerUp={onPointerUp}
                  onPointerCancel={onPointerUp}
                  onKeyDown={onKeyDown}
                  on:focus={() => {
                    focused.set(true);
                    setGridFocused(true);
                    describe();
                  }}
                  on:blur={() => {
                    focused.set(false);
                    setGridFocused(false);
                  }}
                >
                  {rows().map((p, i) => (
                    <div class={["row", { root: isRoot(p) }]} style={{ "--r": String(i) }} />
                  ))}
                  {doc.song.loop > 0 ? (
                    <div class="intro" style={{ "--w": String(doc.song.loop * STEPS_PER_BAR) }}>
                      <span>INTRO</span>
                    </div>
                  ) : null}
                  <div class="picked-bar" style={{ "--b": String(editor.bar) }} />
                  {ghosts().map((g) => (
                    <div
                      class={["ghost", `c${g.c}`]}
                      style={{ "--s": String(g.n.s), "--l": String(g.n.l), "--r": String(g.row) }}
                    />
                  ))}
                  {track().notes.map((n) => (
                    <div
                      class={[
                        "note",
                        {
                          drum: drums(),
                          own: hasOwn(n),
                          lit: playing() && n.s <= playStep() && playStep() < n.s + n.l,
                        },
                      ]}
                      data-step={n.s}
                      data-pitch={n.p}
                      style={{
                        "--s": String(n.s),
                        "--l": String(n.l),
                        "--r": String(rowOf().get(n.p) ?? 0),
                      }}
                    />
                  ))}
                  {focused() ? (
                    <div
                      class="cursor"
                      style={{
                        "--s": String(editor.cursor.step),
                        "--r": String(rowOf().get(editor.cursor.pitch) ?? 0),
                      }}
                    />
                  ) : null}
                  {playing() ? (
                    <div class="playhead" style={{ "--s": String(playStep()) }} />
                  ) : null}
                </div>
              </div>
            </div>
          )}
        </div>
        <div class="led-row" aria-hidden="true">
          <span class={["led", { on: playing() }]} />
          <span class="power">{playing() ? "PLAYING" : "POWER"}</span>
        </div>
      </div>
      <p class="sr-only" aria-live="polite">
        {live()}
      </p>
    </section>
  );
}

<style>
  .screen {
    min-inline-size: 0;
  }
  .bezel {
    padding: 14px 14px 10px;
    background: var(--bezel);
    border-radius: 14px 14px 40px 14px;
    box-shadow:
      inset 0 2px 0 rgb(255 255 255 / 0.08),
      inset 0 -3px 0 rgb(0 0 0 / 0.3);
  }
  .lcd {
    display: grid;
    grid-template-rows: auto 1fr;
    background: var(--l0);
    color: var(--l3);
    border-radius: 4px;
    box-shadow:
      inset 0 0 0 2px var(--l1),
      inset 0 6px 14px -8px rgb(0 0 0 / 0.5);
    overflow: hidden;
  }
  .top {
    display: flex;
    align-items: stretch;
    border-block-end: 2px solid var(--l1);
  }
  .top .status {
    flex: 1;
    min-inline-size: 0;
    border-block-end: 0;
  }
  .views {
    display: flex;
    gap: 2px;
    padding: 3px 6px;
    border-inline-start: 2px solid var(--l1);
  }
  .view {
    padding: 0 8px;
    border: 0;
    background: transparent;
    color: var(--l2);
    font-family: $tokens.font.pixel;
    font-size: 11px;
    cursor: pointer;
  }
  .view[aria-checked="true"] {
    background: var(--l3);
    color: var(--l0);
  }
  .status {
    display: flex;
    gap: 14px;
    align-items: center;
    padding: 6px 10px 5px;
    font-family: $tokens.font.pixel;
    font-size: 12px;
    border-block-end: 2px solid var(--l1);
    white-space: nowrap;
    overflow: hidden;
  }
  .chan {
    padding: 0 5px;
    background: var(--l3);
    color: var(--l0);
  }
  .grow {
    flex: 1;
  }
  .roll {
    overflow: auto;
    max-block-size: min(62vh, 560px);
    overscroll-behavior: contain;
    scrollbar-color: var(--l2) var(--l0);
  }
  .sheet {
    display: grid;
    grid-template-columns: 52px calc(var(--steps) * var(--cw));
    grid-template-rows: 20px calc(var(--rows) * var(--chh));
    inline-size: max-content;
  }
  .corner {
    position: sticky;
    inset-inline-start: 0;
    inset-block-start: 0;
    z-index: 3;
    background: var(--l0);
  }
  .ruler {
    position: sticky;
    inset-block-start: 0;
    z-index: 2;
    background: var(--l0);
    border-block-end: 2px solid var(--l1);
  }
  .barno {
    position: absolute;
    inset-inline-start: calc(var(--b) * 16 * var(--cw));
    inline-size: calc(16 * var(--cw));
    padding-inline-start: 4px;
    font-family: $tokens.font.pixel;
    font-size: 11px;
    line-height: 18px;
    border-inline-start: 2px solid var(--l2);
    cursor: pointer;
  }
  .barno.picked {
    background: var(--l1);
  }
  .flag {
    margin-inline-start: 6px;
    padding: 0 4px;
    background: var(--l3);
    color: var(--l0);
  }
  .keys {
    position: sticky;
    inset-inline-start: 0;
    z-index: 2;
    display: grid;
    grid-auto-rows: var(--chh);
    background: var(--l0);
    border-inline-end: 2px solid var(--l1);
  }
  .key {
    padding-inline: 6px;
    font-family: $tokens.font.pixel;
    font-size: 10px;
    line-height: var(--chh);
    color: var(--l2);
  }
  .key.root {
    color: var(--l3);
    background: var(--l1);
  }
  .lane {
    position: relative;
    touch-action: none;
    cursor: crosshair;
    background-image:
      linear-gradient(90deg, var(--l2) 2px, transparent 2px),
      linear-gradient(90deg, var(--l1) 1px, transparent 1px),
      radial-gradient(circle, var(--l1) 1.2px, transparent 1.6px);
    background-size:
      calc(var(--cw) * 16) 100%,
      calc(var(--cw) * 4) 100%,
      var(--cw) var(--chh);
  }
  .lane:focus-visible {
    outline: 3px solid var(--l3);
    outline-offset: -3px;
  }
  .row {
    position: absolute;
    inset-inline: 0;
    inset-block-start: calc(var(--r) * var(--chh));
    block-size: var(--chh);
    pointer-events: none;
  }
  .row.root {
    background: color-mix(in srgb, var(--l1) 35%, transparent);
  }
  .intro {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    inline-size: calc(var(--w) * var(--cw));
    background: repeating-linear-gradient(
      135deg,
      transparent 0 6px,
      color-mix(in srgb, var(--l1) 30%, transparent) 6px 8px
    );
    pointer-events: none;
  }
  .intro span {
    position: sticky;
    inset-inline-start: 60px;
    display: inline-block;
    margin: 4px;
    padding: 0 4px;
    font-family: $tokens.font.pixel;
    font-size: 10px;
    background: var(--l0);
    color: var(--l2);
  }
  .picked-bar {
    position: absolute;
    inset-block: 0;
    inset-inline-start: calc(var(--b) * 16 * var(--cw));
    inline-size: calc(16 * var(--cw));
    box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--l2) 60%, transparent);
    pointer-events: none;
  }
  .note,
  .ghost,
  .cursor {
    position: absolute;
    inset-inline-start: calc(var(--s) * var(--cw) + 1px);
    inset-block-start: calc(var(--r) * var(--chh) + 2px);
    block-size: calc(var(--chh) - 4px);
    pointer-events: none;
  }
  .note {
    inline-size: calc(var(--l) * var(--cw) - 2px);
    background: var(--l3);
    border-radius: 3px;
    box-shadow:
      inset 0 -3px 0 rgb(0 0 0 / 0.25),
      inset 2px 2px 0 color-mix(in srgb, var(--l0) 25%, transparent);
  }
  .note.drum {
    inline-size: calc(var(--cw) - 4px);
    inset-inline-start: calc(var(--s) * var(--cw) + 2px);
    border-radius: 50%;
  }
  .note.own::after {
    content: "";
    position: absolute;
    inset-block-start: 3px;
    inset-inline-start: 3px;
    inline-size: 4px;
    block-size: 4px;
    background: var(--l0);
  }
  .hidden {
    display: none;
  }
  .note.lit {
    background: var(--l2);
    outline: 2px solid var(--l3);
  }
  .ghost {
    inline-size: calc(var(--l) * var(--cw) - 2px);
    inset-block-start: calc(var(--r) * var(--chh) + 7px);
    block-size: 4px;
    border-radius: 2px;
    background: var(--l1);
  }
  .ghost.c0 {
    background: var(--l2);
    opacity: 0.55;
  }
  .cursor {
    inline-size: calc(var(--cw) - 2px);
    outline: 2px dashed var(--l3);
    outline-offset: 1px;
    border-radius: 3px;
  }
  .playhead {
    position: absolute;
    inset-block: 0;
    inset-inline-start: calc(var(--s) * var(--cw));
    inline-size: var(--cw);
    background: color-mix(in srgb, var(--l3) 18%, transparent);
    border-inline-start: 2px solid var(--l3);
    pointer-events: none;
  }
