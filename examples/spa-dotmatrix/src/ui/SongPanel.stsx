// Song settings: length, key and scale (which decide the grid rows), the length of new notes and
// the loop point. Bar and channel actions live in the toolbar under the screen (GridTools).
import { KEYS, SCALES } from "../model/music.ts";
import { tidy } from "../model/song.ts";
import { MAX_BARS, STEPS_PER_BAR, type ScaleId } from "../model/types.ts";
import { doc, edit, editor, prefs } from "../state.ts";
import { tokens } from "../tokens.ts";

const LENGTHS = [
  { steps: 1, name: "1/16" },
  { steps: 2, name: "1/8" },
  { steps: 4, name: "1/4" },
  { steps: 8, name: "1/2" },
];

function setBars(bars: number) {
  const next = Math.min(MAX_BARS, Math.max(1, bars));
  if (next === doc.song.bars) return;
  edit(next > doc.song.bars ? "Add a bar" : "Remove the last bar", (song) => {
    song.bars = next;
    song.loop = Math.min(song.loop, next - 1);
    for (const track of song.tracks) track.notes = tidy(track.notes, next * STEPS_PER_BAR);
  });
  editor.bar = Math.min(editor.bar, next - 1);
}

export function SongPanel() {
  return (
    <section class="panel song" aria-labelledby="song-title-h">
      <h2 id="song-title-h">{doc.song.sheet ? "Sound sheet" : "Song"}</h2>
      <div class="rows">
        <div class="field">
          <span class="label">Bars</span>
          <div class="stepper">
            <button
              type="button"
              aria-label="Remove the last bar"
              onClick={() => setBars(doc.song.bars - 1)}
            >
              −
            </button>
            <output aria-live="polite">{doc.song.bars}</output>
            <button type="button" aria-label="Add a bar" onClick={() => setBars(doc.song.bars + 1)}>
              +
            </button>
          </div>
        </div>
        <label class="field">
          <span class="label">Key</span>
          <select
            value={String(doc.song.key)}
            onChange={(event) => {
              const key = Number(event.currentTarget.value);
              edit("Change key", (song) => (song.key = key));
            }}
          >
            {KEYS.map((name, i) => (
              <option value={String(i)} selected={doc.song.key === i}>
                {name}
              </option>
            ))}
          </select>
        </label>
        <label class="field">
          <span class="label">Scale</span>
          <select
            value={doc.song.scale}
            onChange={(event) => {
              const scale = event.currentTarget.value as ScaleId;
              edit("Change scale", (song) => (song.scale = scale));
            }}
          >
            {(Object.keys(SCALES) as ScaleId[]).map((id) => (
              <option value={id} selected={doc.song.scale === id}>
                {SCALES[id].name}
              </option>
            ))}
          </select>
        </label>
        <div class="field">
          <span class="label">New notes</span>
          <div class="seg" role="radiogroup" aria-label="Length of new notes">
            {LENGTHS.map((l) => (
              <button
                type="button"
                role="radio"
                aria-checked={prefs.noteLength === l.steps}
                onClick={() => (prefs.noteLength = l.steps)}
              >
                {l.name}
              </button>
            ))}
          </div>
        </div>
        {doc.song.sheet ? null : (
          <label class="field">
            <span class="label">Loop from</span>
            <select
              value={String(doc.song.loop)}
              onChange={(event) => {
                const loop = Number(event.currentTarget.value);
                edit(`Loop from bar ${loop + 1}`, (song) => (song.loop = loop));
              }}
            >
              {Array.from({ length: doc.song.bars }, (_, b) => (
                <option value={String(b)} selected={doc.song.loop === b}>
                  Bar {b + 1}
                  {b === 0 ? " (no intro)" : ""}
                </option>
              ))}
            </select>
          </label>
        )}
      </div>
      <style>
        .song {
          display: grid;
          gap: 14px;
          align-content: start;
        }
        h2 {
          font-size: 15px;
          color: var(--indigo);
        }
        .rows {
          display: grid;
          grid-template-columns: repeat(auto-fill, minmax(min(130px, 100%), 1fr));
          gap: 12px;
        }
        .field {
          display: grid;
          gap: 4px;
          align-content: start;
          min-inline-size: 0;
        }
        select {
          inline-size: 100%;
        }
        .stepper {
          display: flex;
          align-items: center;
          gap: 6px;
        }
        .stepper button {
          inline-size: 32px;
          block-size: 32px;
          border: 0;
          border-radius: 50%;
          background: var(--shell-low);
          font-size: 18px;
          cursor: pointer;
        }
        .stepper output {
          min-inline-size: 2.5ch;
          text-align: center;
          font-family: $tokens.font.pixel;
          font-size: 16px;
        }
        .seg {
          display: flex;
          gap: 3px;
        }
        .seg button {
          flex: 1;
          padding: 6px 4px;
          border: 2px solid transparent;
          border-radius: 9px;
          background: var(--shell-low);
          font-size: 12px;
          cursor: pointer;
        }
        .seg button[aria-checked="true"] {
          border-color: var(--accent);
        }
      </style>
    </section>
  );
}
