// The maker panel shared by the SFX and Creatures pages: title, play button, waveform, sliders,
// actions and the driver-code view.
import { signal } from "lumiose";
import type { SoundSheet } from "../model/types.ts";
import { CodeEditor } from "./CodeEditor.stsx";
import { Waveform } from "./Waveform.stsx";

export interface Slider {
  label: string;
  value: () => number;
  min: number;
  max: number;
  step: number;
  show: () => string;
  enabled?: () => boolean;
  onInput: (value: number) => void;
}

export interface Action {
  label: string;
  onClick: () => void;
  primary?: boolean;
  disabled?: () => boolean;
  title?: () => string;
}

export function Maker(props: {
  title: string;
  blurb: string;
  caption: string;
  pcm: Float32Array | null;
  onFire: () => void;
  sliders: Slider[];
  actions: Action[];
  /** Shown above the sliders, e.g. why they are off. */
  notice?: string;
  code: string | null;
  codeNote: string;
  /** Which shelf code saved from the code view goes to. */
  kind: SoundSheet["kind"];
  /** Code from the code view was played: show its waveform. */
  onPcm: (pcm: Float32Array) => void;
  /** The saved sound on show (its code is editable), or undefined for a built-in one. */
  customId?: string;
  /** Copies the built-in sound into My sounds / My voices. */
  onCopy: () => void;
  /** Code from the code view was saved over this My sounds id. */
  onSaved: (id: string) => void;
  children?: JSX.Element;
}) {
  const showCode = signal(false);
  return (
    <section class="panel maker" aria-labelledby="maker-title">
      <div class="head">
        {props.children}
        <div class="titles">
          <h2 id="maker-title">{props.title}</h2>
          <p class="blurb">{props.blurb}</p>
        </div>
        <button
          type="button"
          class="fire"
          aria-label={`Play ${props.title}`}
          onClick={() => props.onFire()}
        >
          <svg viewBox="0 0 10 10" aria-hidden="true">
            <path d="M3 1.5v7l5.5-3.5z" />
          </svg>
        </button>
      </div>
      <Waveform pcm={props.pcm} label={`Waveform of ${props.title}`} caption={props.caption} />
      {props.notice ? (
        <p class="notice" role="note">
          {props.notice}
        </p>
      ) : null}
      <div class="sliders">
        {props.sliders.map((s) => (
          <label class={["field", { off: s.enabled ? !s.enabled() : false }]}>
            <span class="label">{s.label}</span>
            <input
              type="range"
              min={s.min}
              max={s.max}
              step={s.step}
              value={s.value()}
              disabled={s.enabled ? !s.enabled() : false}
              onInput={(event) => s.onInput(event.currentTarget.valueAsNumber)}
            />
            <output>{s.show()}</output>
          </label>
        ))}
      </div>
      <div class="actions">
        {props.actions.map((a) => (
          <button
            type="button"
            class={["btn", { primary: a.primary === true }]}
            disabled={a.disabled ? a.disabled() : false}
            title={a.title ? a.title() : undefined}
            onClick={() => a.onClick()}
          >
            {a.label}
          </button>
        ))}
        <button
          type="button"
          class="btn"
          aria-expanded={showCode()}
          onClick={() => showCode.set(!showCode())}
        >
          {showCode() ? "Hide code" : "Show code"}
        </button>
      </div>
      {showCode() ? (
        <CodeEditor
          code={props.code}
          note={props.codeNote}
          kind={props.kind}
          title={props.title}
          onPcm={(pcm) => props.onPcm(pcm)}
          customId={props.customId}
          onCopy={() => props.onCopy()}
          onSaved={(id) => props.onSaved(id)}
        />
      ) : null}
      <style>
        .maker {
          display: grid;
          gap: 14px;
        }
        .head {
          display: flex;
          gap: 14px;
          align-items: start;
        }
        .titles {
          flex: 1;
          min-inline-size: 0;
        }
        h2 {
          font-size: 20px;
          color: var(--indigo);
        }
        .blurb {
          margin: 4px 0 0;
          color: var(--dim);
        }
        .fire {
          flex: none;
          display: grid;
          place-items: center;
          inline-size: 54px;
          block-size: 54px;
          border: 0;
          border-radius: 50%;
          background: var(--accent);
          color: var(--accent-ink);
          cursor: pointer;
          box-shadow:
            inset 0 -4px 0 rgb(0 0 0 / 0.25),
            0 4px 10px -4px rgb(0 0 0 / 0.5);
        }
        .fire:active {
          transform: translateY(2px);
        }
        .fire svg {
          inline-size: 22px;
          fill: currentColor;
        }
        .notice {
          margin: 0;
          padding: 8px 12px;
          border-radius: 10px;
          background: color-mix(in srgb, var(--indigo) 12%, var(--shell-low));
          font-size: 13px;
        }
        .sliders {
          display: grid;
          grid-template-columns: repeat(auto-fill, minmax(min(180px, 100%), 1fr));
          gap: 12px 18px;
        }
        .field {
          display: grid;
          grid-template-columns: minmax(0, 1fr) auto;
          gap: 4px 8px;
          align-items: center;
          min-inline-size: 0;
        }
        .field .label {
          grid-column: 1 / -1;
        }
        .field.off {
          opacity: 0.45;
        }
        output {
          min-inline-size: 6ch;
          text-align: end;
          font-size: 12px;
          color: var(--dim);
        }
        .actions {
          display: flex;
          flex-wrap: wrap;
          gap: 8px;
        }
      </style>
    </section>
  );
}
