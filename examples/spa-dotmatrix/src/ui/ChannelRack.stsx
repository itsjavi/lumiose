// The four channels as cartridge-like cards: pick one to edit, mute or solo it, pan it, and watch
// its scope while the song plays.
import { effect, onCleanup } from "lumen";
import { nowPlaying, scope } from "../audio/player.ts";
import { presetName } from "../model/instruments.ts";
import { CHANNELS, type ChannelIndex, type Pan } from "../model/types.ts";
import { doc, editor, mix, prefs } from "../state.ts";
import { tokens } from "../tokens.ts";

const ICONS: Record<string, string> = {
  pulse: "M0 6h2V1h3v5h3V1h3v5h2",
  wave: "M0 4c2-5 4-5 6 0s4 5 6 0 2-3 3-2",
  noise: "M0 4h1V1h1v6h1V2h1v4h1V0h1v8h1V3h1v3h1V1h1v5h1V3h1v2h1",
};

function Scope(props: { ch: ChannelIndex }) {
  let canvas: HTMLCanvasElement | undefined;
  const samples = new Float32Array(256);
  let frame = 0;

  function draw() {
    const c = canvas;
    if (!c) return;
    const g = c.getContext("2d")!;
    const style = getComputedStyle(c);
    const w = c.width;
    const h = c.height;
    g.fillStyle = style.getPropertyValue("--l0");
    g.fillRect(0, 0, w, h);
    scope(props.ch, samples);
    g.fillStyle = style.getPropertyValue("--l3");
    // A dot-matrix trace: one 2×2 dot per column.
    for (let x = 0; x < w; x += 2) {
      const s = samples[Math.floor((x / w) * samples.length)]!;
      const y = Math.round(h / 2 - s * h * 2.6);
      g.fillRect(x, Math.min(h - 2, Math.max(0, y)), 2, 2);
    }
    if (nowPlaying()) frame = requestAnimationFrame(draw);
  }

  // Draw while playing, and once more when playback stops or the screen palette changes.
  effect(() => {
    nowPlaying();
    void prefs.lcd;
    void prefs.theme;
    cancelAnimationFrame(frame);
    frame = requestAnimationFrame(draw);
  });
  onCleanup(() => cancelAnimationFrame(frame));

  return (
    <canvas class="scope" width="96" height="28" ref={(el) => (canvas = el)} aria-hidden="true" />
  );
}

const INDICES: ChannelIndex[] = [0, 1, 2, 3];

const setPan = (ch: ChannelIndex, pan: Pan) => mix((song) => (song.tracks[ch].pan = pan));

export function ChannelRack() {
  return (
    <div class="rack" role="radiogroup" aria-label="Channels">
      {INDICES.map((ch) => {
        const info = CHANNELS[ch];
        const track = () => doc.song.tracks[ch];
        return (
          <div class={["card", `c${ch}`, { active: editor.channel === ch, quiet: track().mute }]}>
            <button
              type="button"
              class="pick"
              role="radio"
              aria-checked={editor.channel === ch}
              aria-label={`${info.name}: ${info.role}`}
              onClick={() => (editor.channel = ch)}
            >
              <span class="tab" aria-hidden="true">
                <svg viewBox="0 0 16 8">
                  <path d={ICONS[info.kind]} />
                </svg>
              </span>
              <span class="names">
                <span class="name">{info.name}</span>
                <span class="role">
                  {info.role} · {presetName(info.kind, track().inst.preset)}
                </span>
              </span>
              <kbd aria-hidden="true">{ch + 1}</kbd>
            </button>
            <div class="controls">
              <Scope ch={ch} />
              <button
                type="button"
                class={["toggle", { on: track().mute }]}
                aria-pressed={track().mute}
                aria-label={`Mute ${info.name}`}
                title="Mute"
                onClick={() => mix((song) => (song.tracks[ch].mute = !song.tracks[ch].mute))}
              >
                M
              </button>
              <button
                type="button"
                class={["toggle", "solo", { on: track().solo }]}
                aria-pressed={track().solo}
                aria-label={`Solo ${info.name}`}
                title="Solo"
                onClick={() => mix((song) => (song.tracks[ch].solo = !song.tracks[ch].solo))}
              >
                S
              </button>
              <div class="pan" role="group" aria-label={`${info.name} panning`}>
                {(["L", "C", "R"] as const).map((pan) => (
                  <button
                    type="button"
                    class={{ on: track().pan === pan }}
                    aria-pressed={track().pan === pan}
                    aria-label={{ L: "Left", C: "Center", R: "Right" }[pan]}
                    onClick={() => setPan(ch, pan)}
                  >
                    {pan}
                  </button>
                ))}
              </div>
            </div>
          </div>
        );
      })}
      <style>
        .rack {
          display: grid;
          gap: 10px;
          align-content: start;
        }
        .card {
          --c: var(--c0);
          position: relative;
          display: grid;
          gap: 8px;
          padding: 10px 10px 10px 14px;
          background: var(--shell-low);
          border-radius: 14px;
          box-shadow: inset 0 0 0 2px transparent;
          transition: box-shadow 0.15s;
        }
        .card::before {
          content: "";
          position: absolute;
          inset-block: 10px;
          inset-inline-start: 0;
          inline-size: 5px;
          border-radius: 0 4px 4px 0;
          background: var(--c);
        }
        .c1 {
          --c: var(--c1);
        }
        .c2 {
          --c: var(--c2);
        }
        .c3 {
          --c: var(--c3);
        }
        .card.active {
          background: var(--shell);
          box-shadow:
            inset 0 0 0 2px var(--c),
            0 6px 16px -10px rgb(0 0 0 / 0.5);
        }
        .card.quiet .pick {
          opacity: 0.55;
        }
        .pick {
          display: grid;
          grid-template-columns: auto 1fr auto;
          gap: 10px;
          align-items: center;
          padding: 0;
          border: 0;
          background: none;
          text-align: start;
          cursor: pointer;
        }
        .tab {
          display: grid;
          place-items: center;
          inline-size: 34px;
          block-size: 34px;
          border-radius: 10px;
          background: var(--c);
        }
        .tab svg {
          inline-size: 22px;
          fill: none;
          stroke: white;
          stroke-width: 1.4;
          stroke-linejoin: round;
        }
        .names {
          display: grid;
          min-inline-size: 0;
        }
        .name {
          font-family: $tokens.font.pixel;
          font-size: 13px;
        }
        .role {
          font-size: 12px;
          color: var(--dim);
          white-space: nowrap;
          overflow: hidden;
          text-overflow: ellipsis;
        }
        kbd {
          font-family: $tokens.font.pixel;
          font-size: 10px;
          color: var(--dim);
          border: 1px solid var(--edge);
          border-radius: 4px;
          padding: 0 4px;
        }
        .controls {
          display: flex;
          align-items: center;
          gap: 6px;
        }
        .scope {
          flex: 1;
          min-inline-size: 0;
          block-size: 28px;
          border-radius: 4px;
          image-rendering: pixelated;
          box-shadow: inset 0 0 0 1px var(--l1);
        }
        .toggle,
        .pan button {
          inline-size: 28px;
          block-size: 28px;
          padding: 0;
          border: 0;
          border-radius: 8px;
          background: var(--groove);
          font-family: $tokens.font.pixel;
          font-size: 11px;
          cursor: pointer;
        }
        .toggle.on {
          background: var(--accent);
          color: var(--accent-ink);
        }
        .solo.on {
          background: var(--indigo);
          color: var(--shell);
        }
        .pan {
          display: flex;
          gap: 2px;
          padding: 2px;
          border-radius: 10px;
          background: var(--groove);
        }
        .pan button {
          inline-size: 22px;
          block-size: 24px;
          background: transparent;
          color: var(--dim);
        }
        .pan button.on {
          background: var(--shell);
          color: var(--ink);
        }
        @media (width < 1100px) {
          .rack {
            grid-template-columns: repeat(2, minmax(0, 1fr));
          }
        }
        @media (width < 560px) {
          .card:not(.active) .controls {
            display: none;
          }
          .card.active {
            grid-column: 1 / -1;
          }
        }
      </style>
    </div>
  );
}
