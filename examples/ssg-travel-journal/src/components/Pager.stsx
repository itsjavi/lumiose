import { Link } from "lumen/router";
import { pageHref } from "../lib/paginate.ts";
import * as theme from "../theme.ts";

/**
 * Links between the journal's pages: newer, each page number, older. `<Link prefetch>` sets their
 * prefetch apart from the site's `lumen({ prefetch: "hover" })`: readers page on with the steps,
 * which prefetch early, while the row of numbers is not worth prefetching. The page is still MPA:
 * `<Link>` renders a plain `<a>` and ships no JavaScript. Its `class` carries this file's scope,
 * so the styles below reach it.
 */
export function Pager(props: { page: number; count: number }) {
  const numbers = () => Array.from({ length: props.count }, (_, index) => index + 1);

  return (
    <nav class="pager" aria-label="Journal pages">
      {props.page > 1 ? (
        <Link class="step" rel="prev" href={pageHref(props.page - 1)} prefetch="viewport">
          ← Newer
        </Link>
      ) : (
        <span class="step" />
      )}
      <ol>
        {numbers().map((number) => (
          <li>
            <Link class="number" href={pageHref(number)} prefetch="none">
              {number}
            </Link>
          </li>
        ))}
      </ol>
      {props.page < props.count ? (
        <Link class="step" rel="next" href={pageHref(props.page + 1)} prefetch="viewport">
          Older →
        </Link>
      ) : (
        <span class="step" />
      )}

      <style>
        .pager {
          display: grid;
          grid-template-columns: 1fr auto 1fr;
          align-items: center;
          gap: $theme.space.md;
          margin-top: $theme.space.xxl;
        }
        .step:last-child {
          justify-self: end;
        }
        ol {
          display: flex;
          gap: $theme.space.xs;
          margin: 0;
          padding: 0;
          list-style: none;
        }
        .step,
        .number {
          font-weight: 500;
          text-decoration: none;
        }
        .number {
          display: grid;
          place-items: center;
          min-width: 2.25rem;
          height: 2.25rem;
          border-radius: $theme.radius.pill;
          color: $theme.color.ink;
          font-variant-numeric: tabular-nums;
        }
        .number:hover {
          background: $theme.color.chip;
        }
        .number[aria-current="page"] {
          background: $theme.color.accent;
          color: $theme.color.accentInk;
        }
      </style>
    </nav>
  );
}
