// Island (client:idle): search as you type, over the prebuilt `/search.json` index (fetched once,
// on first focus). Arrow keys move through the results, Enter opens one, Escape closes the list.
// Without JavaScript it is a plain form that opens the archive, which lists every post.
import { computed, fetchJSON, onMount, signal } from "lumiose";
import { formatShortDate } from "../lib/format.ts";
import { searchEntries, type SearchEntry } from "../lib/search.ts";
import * as theme from "../theme.ts";

export function Search(props: { index: string }) {
  const query = signal("");
  const entries = signal<SearchEntry[] | undefined>(undefined);
  const failed = signal(false);
  const open = signal(false);
  const active = signal(-1);
  const ready = signal(false);
  const results = computed(() => searchEntries(entries() ?? [], query()));
  let loading: Promise<void> | undefined;

  onMount(() => ready.set(true));

  function loadIndex() {
    loading ??= fetchJSON<SearchEntry[]>(props.index).then(
      (data) => entries.set(data),
      () => {
        failed.set(true);
        loading = undefined;
      },
    );
  }

  function onInput(value: string) {
    loadIndex();
    query.set(value);
    active.set(-1);
    open.set(value.trim() !== "");
  }

  function go(index: number) {
    const entry = results()[index];
    if (entry !== undefined) location.assign(entry.url);
  }

  function onKeyDown(event: KeyboardEvent) {
    const count = results().length;
    if (event.key === "ArrowDown" && count > 0) {
      event.preventDefault();
      open.set(true);
      active.set((active() + 1) % count);
    } else if (event.key === "ArrowUp" && count > 0) {
      event.preventDefault();
      active.set(active() <= 0 ? count - 1 : active() - 1);
    } else if (event.key === "Escape") {
      open.set(false);
      active.set(-1);
    }
  }

  function onSubmit(event: SubmitEvent) {
    // With results, Enter opens the highlighted (or best) one; otherwise the archive opens.
    if (results().length === 0) return;
    event.preventDefault();
    go(Math.max(0, active()));
  }

  const status = () =>
    failed()
      ? "Search is unavailable right now."
      : entries() === undefined
        ? "Loading…"
        : `No posts match “${query().trim()}”.`;

  return (
    <form
      class="search"
      role="search"
      method="get"
      action="/archive"
      data-ready={ready() ? "" : undefined}
      onSubmit={onSubmit}
    >
      <label class="visually-hidden" for="search-input">
        Search the journal
      </label>
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="11" cy="11" r="6.5" />
        <path d="m16 16 4.5 4.5" />
      </svg>
      <input
        id="search-input"
        type="search"
        name="q"
        placeholder="Search…"
        autocomplete="off"
        role="combobox"
        aria-autocomplete="list"
        aria-controls="search-results"
        aria-expanded={open() && results().length > 0 ? "true" : "false"}
        aria-activedescendant={active() >= 0 ? `search-result-${active()}` : undefined}
        onInput={(event) => onInput(event.currentTarget.value)}
        onKeyDown={onKeyDown}
        onFocus={() => {
          loadIndex();
          open.set(query().trim() !== "");
        }}
        onBlur={() => setTimeout(() => open.set(false), 150)}
      />
      <div class="panel" hidden={!open()}>
        <ul id="search-results" role="listbox" aria-label="Posts" hidden={results().length === 0}>
          {results().map((entry, index) => (
            <li
              id={`search-result-${index}`}
              role="option"
              aria-selected={index === active() ? "true" : "false"}
            >
              <a href={entry.url} tabindex="-1">
                <strong>{entry.title}</strong>
                <span>
                  {formatShortDate(entry.date)} · {entry.tags.join(", ")}
                </span>
              </a>
            </li>
          ))}
        </ul>
        <p class="status" role="status" hidden={results().length > 0}>
          {status()}
        </p>
      </div>
    </form>
  );
}

<style>
  .search {
    position: relative;
    width: 15rem;
  }
  .icon {
    position: absolute;
    left: 0.7rem;
    top: 50%;
    width: 1rem;
    height: 1rem;
    translate: 0 -50%;
    fill: none;
    stroke: $theme.color.muted;
    stroke-width: 2;
    stroke-linecap: round;
    pointer-events: none;
  }
  input {
    width: 100%;
    padding: 0.45rem 0.9rem 0.45rem 2.1rem;
    border: 1px solid $theme.color.line;
    border-radius: $theme.radius.pill;
    background: $theme.color.card;
    color: inherit;
    font: inherit;
    font-size: $theme.font.small;
    transition:
      border-color $theme.motion.fast,
      box-shadow $theme.motion.fast;
  }
  input:focus {
    outline: none;
    border-color: $theme.color.accent;
    box-shadow: 0 0 0 3px $theme.color.mark;
  }
  .panel {
    position: absolute;
    z-index: 30;
    right: 0;
    top: calc(100% + $theme.space.sm);
    width: min(24rem, calc(100vw - 2rem));
    padding: $theme.space.xs;
    border: 1px solid $theme.color.line;
    border-radius: $theme.radius.md;
    background: $theme.color.card;
    box-shadow: $theme.shadow.popup;
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li a {
    display: grid;
    gap: 0.1rem;
    padding: $theme.space.sm $theme.space.md;
    border-radius: $theme.radius.sm;
    color: inherit;
    text-decoration: none;
  }
  li a strong {
    font-family: $theme.font.display;
    font-weight: 600;
  }
  li a span,
  .status {
    color: $theme.color.muted;
    font-size: $theme.font.tiny;
  }
  li[aria-selected="true"] a,
  li a:hover {
    background: $theme.color.chip;
  }
  .status {
    margin: 0;
    padding: $theme.space.sm $theme.space.md;
  }
  @media (width < $theme.layout.narrow) {
    .search {
      width: 11rem;
    }
  }
</style>
