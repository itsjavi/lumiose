// Every tag, sized by how many posts use it.
import { href, Meta, Title } from "lumiose";
import { allTags } from "../../content.ts";
import { tagLabel } from "../../lib/format.ts";
import { site } from "../../lib/site.ts";
import * as theme from "../../theme.ts";

export default function Tags() {
  const max = () => Math.max(...allTags().map((tag) => tag.count));

  return (
    <section class="tags-page">
      <Title>Tags · {site.title}</Title>
      <Meta name="description" content={`Browse ${site.title} by tag.`} />
      <h1>Tags</h1>
      <p class="lead">Browse the journal by place, season and way of travelling.</p>
      <ul class="cloud">
        {allTags().map((tag) => (
          <li style={{ "--weight": String(tag.count / max()) }}>
            <a href={href("/tags/[tag]", { tag: tag.tag })}>
              {tagLabel(tag.tag)}
              <span>
                {tag.count} {tag.count === 1 ? "post" : "posts"}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  );
}

<style>
  .tags-page {
    max-width: 48rem;
  }
  .lead {
    margin: 0 0 $theme.space.xl;
    color: $theme.color.muted;
    font-size: $theme.font.lead;
  }
  .cloud {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: $theme.space.md;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    display: inline-flex;
    align-items: baseline;
    gap: $theme.space.sm;
    padding: $theme.space.sm $theme.space.lg;
    border: 1px solid $theme.color.line;
    border-radius: $theme.radius.pill;
    background: $theme.color.card;
    color: $theme.color.ink;
    font-family: $theme.font.display;
    font-size: calc(1rem + var(--weight) * 0.9rem);
    text-decoration: none;
    transition: border-color $theme.motion.fast;
  }
  a:hover {
    border-color: $theme.color.accent;
  }
  span {
    color: $theme.color.muted;
    font-family: $theme.font.body;
    font-size: $theme.font.tiny;
  }
</style>
