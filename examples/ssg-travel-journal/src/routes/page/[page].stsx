// Journal pages 2 and up, one prerendered file each. `/page/1` is prerendered as a redirect to `/`
// (a static build writes a redirect page for it).
import { notFound, redirect, type RouteProps } from "lumen";
import { Journal } from "../../components/Journal.stsx";
import { allPosts } from "../../content.ts";
import { pageCount, paginate, pageHref } from "../../lib/paginate.ts";
import { site } from "../../lib/site.ts";

export function staticPaths() {
  const count = pageCount(allPosts().length, site.pageSize);
  return Array.from({ length: count }, (_, index) => ({ params: { page: String(index + 1) } }));
}

export default function JournalPage(props: RouteProps<"/page/[page]">) {
  return (
    <Journal
      page={journalPage(props.params.page)}
      path={pageHref(Number(props.params.page))}
    />
  );
}

function journalPage(param: string) {
  if (param === "1") redirect("/", 301);
  return (/^\d+$/.test(param) && paginate(allPosts(), site.pageSize, Number(param))) || notFound();
}
