{
  // Lumiose's options (JSX, rootDirs for the shadow TSX) come from the generated config.
  "extends": ["../../tsconfig.base.json", "./.lumiose/tsconfig.generated.json"],
  "compilerOptions": {
    // `vite/client` types `import.meta.glob` in src/content.ts.
    "types": ["node", "lumiose/env", "vite/client"]
  },
  "include": [
    "src",
    "e2e",
    "serve.ts",
    "vite.config.ts",
    "playwright.config.ts",
    ".lumiose/shadow",
    ".lumiose/types"
  ]
}
