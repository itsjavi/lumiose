// The main view: arrangement and instruments on the left, the pattern editor, the mixer.
import { InstrumentList } from "./InstrumentList.stsx";
import { Mixer } from "./Mixer.stsx";
import { OrderList } from "./OrderList.stsx";
import { PatternEditor } from "./PatternEditor.stsx";

export function TrackerView() {
  return (
    <div class="tracker">
      <div class="side">
        <OrderList />
        <InstrumentList compact />
      </div>
      <PatternEditor />
      <Mixer />
      <style>
        .tracker {
          display: grid;
          grid-template-columns: minmax(170px, 200px) minmax(0, 1fr) minmax(240px, 300px);
          gap: 10px;
          block-size: 100%;
          min-block-size: 0;
        }
        .side { display: grid; grid-template-rows: 1fr 1fr; gap: 10px; min-block-size: 0; }
        @media (width < 1100px) {
          .tracker { grid-template-columns: 170px minmax(0, 1fr); }
          .tracker > :last-child { grid-column: 1 / -1; }
        }
      </style>
    </div>
  );
}
