// The main view: arrangement and instruments on the left, the pattern editor (the mixer is in the
// root layout, next to every view).
import { InstrumentList } from "./InstrumentList.stsx";
import { OrderList } from "./OrderList.stsx";
import { PatternEditor } from "./PatternEditor.stsx";

export function TrackerView() {
  return (
    <div class="tracker">
      <div class="side">
        <OrderList />
        <InstrumentList compact />
      </div>
      <PatternEditor />
      <style>
        .tracker {
          display: grid;
          grid-template-columns: minmax(170px, 200px) minmax(0, 1fr);
          gap: 10px;
          block-size: 100%;
          min-block-size: 0;
        }
        .side {
          display: grid;
          grid-template-rows: 1fr 1fr;
          gap: 10px;
          min-block-size: 0;
        }
      </style>
    </div>
  );
}
