// The bottom line: messages, the edit position and (optionally) frame timing.
import { telemetryMode } from "../audio/engine.ts";
import { COLUMNS } from "../editor.ts";
import { fps, frameWork } from "../frame.ts";
import { CHANNELS } from "../model/types.ts";
import { cursor, history, message, prefs } from "../state.ts";

const FIELDS = ["Note", "Instrument", "Instrument", "Volume", "Effect", "Parameter", "Parameter"];

export function StatusBar() {
  return (
    <footer class="status">
      <span class="message" role="status" aria-live="polite">
        {message() || "Type notes with Z-M and Q-P · Space plays · F1-F4 switch views"}
      </span>
      <span>
        {CHANNELS[cursor.channel]!.short} · {FIELDS[cursor.column]} ·{" "}
        {COLUMNS[cursor.column]!.field}
      </span>
      <span>{history.size()} edits</span>
      <span title="How the audio thread reports levels and scopes">
        {telemetryMode() === "shared"
          ? "SAB"
          : telemetryMode() === "message"
            ? "postMessage"
            : "idle"}
      </span>
      {prefs.perf && (
        <span
          class="perf"
          title="Frames per second · main-thread work per frame for meters, scopes and the playing row"
        >
          {fps()} FPS · {frameWork().toFixed(2)} ms
        </span>
      )}
      <style>
        .status {
          display: flex;
          gap: 16px;
          padding: 4px 12px;
          font-size: 11px;
          color: var(--dim);
          background: var(--panel);
          border-block-start: 2px solid var(--line);
          white-space: nowrap;
        }
        .message {
          flex: 1;
          color: var(--text);
          overflow: hidden;
          text-overflow: ellipsis;
        }
        .perf {
          color: var(--green);
        }
      </style>
    </footer>
  );
}
