// Unknown URLs and songs that are not in the library (a deep link from another browser).
import { href, onMount, type ErrorPageProps } from "lumiose";
import { Link, navigate, params, route } from "lumiose/router";
import { loadSaved } from "../model/library.ts";

export default function NotFound(props: ErrorPageProps) {
  // Songs live in the browser: the build only prerenders the demo's page, so a static host serves
  // 404.html (this page, prerendered) for every other song URL, and `lumiose dev` renders it too.
  // A song saved in this browser then opens client-side.
  onMount(() => {
    const id = route() === "/songs/[id]" ? params<"/songs/[id]">().id : undefined;
    if (id !== undefined && loadSaved(id)) void navigate(location.href, { replace: true });
  });
  return (
    <section class="not-found panel">
      <h2>{props.status} · Not here</h2>
      <p>This song or page is not in this browser's library.</p>
      <Link class="library" href={href("/songs")}>
        Open the song library
      </Link>
    </section>
  );
}

<style>
  .not-found {
    max-inline-size: 60ch;
  }
  p {
    color: var(--dim);
  }
  .library {
    color: var(--cyan);
  }
</style>
