// Unknown URLs and songs that are not in the library (a deep link from another browser).
import { href, type ErrorPageProps } from "lumiose";
import { Link } from "lumiose/router";

// Songs live in the browser, so the build prerenders the demo's page only: a static host serves
// 404.html (this page, prerendered) for every other song URL, and `lumiose dev` renders it there
// too. The router then renders the song page in the browser, which opens a song saved here or
// shows this page.
export default function NotFound(props: ErrorPageProps) {
  return (
    <section class="not-found panel">
      <h2>{props.status} · Not here</h2>
      <p>This song or page is not in this browser's library.</p>
      <Link class="library" href={href("/songs")}>
        Open the song library
      </Link>
    </section>
  );
}

<style>
  .not-found {
    max-inline-size: 60ch;
  }
  p {
    color: var(--dim);
  }
  .library {
    color: var(--cyan);
  }
</style>
