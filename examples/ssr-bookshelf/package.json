{
  "name": "@lumiose-examples/ssr-bookshelf",
  "version": "0.0.0",
  "private": true,
  "description": "Lumiose sample: a multi-page, server-rendered bookshelf backed by node:sqlite.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node src/server/seed.server.ts --if-empty && lumiose dev",
