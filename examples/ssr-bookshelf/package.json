    "preview": "lumiose preview",
    "seed": "node src/server/seed.server.ts",
    "typecheck": "lumiose check",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@lumiose/adapter-node": "workspace:*",
    "lumiose": "workspace:*"
  },
  "devDependencies": {
    "@lumiose/cli": "workspace:*",
