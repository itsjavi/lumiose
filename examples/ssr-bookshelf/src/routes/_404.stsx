import { Title, type ErrorPageProps } from "lumen";
import "../styles.css";
import { Footer, Header } from "../components/Header.stsx";

export default function NotFound(props: ErrorPageProps) {
  return (
    <>
      <Header />
      <main>
        <Title>Not found · Bookshelf</Title>
        <h1>Page not found</h1>
        <p>{props.error.message}</p>
        <p>
          <a href="/books">Browse the books</a>
        </p>
      </main>
      <Footer />
    </>
  );
}
