import { href, Title, url } from "lumen";
import { BookGrid } from "../../../components/BookCard.stsx";
import { Pager } from "../../../components/Pager.stsx";
import { BOOK_SORTS, bookFiltersToParams, parseBookFilters } from "../../../lib/search-params.ts";
import { queries } from "../../../server/queries.server.ts";
import { readingListToggles } from "../../../server/toggles.server.ts";
import * as theme from "../../../theme.ts";
import type { BookFilters, BookSort, BookSummary, Genre, Page } from "../../../types.ts";

const SORT_LABELS: Record<BookSort, string> = {
  relevance: "Best match",
  title: "Title",
  rating: "Top rated",
  newest: "Newest",
  oldest: "Oldest",
};

function booksHref(filters: BookFilters): string {
  const search = bookFiltersToParams(filters).toString();
  return search === "" ? href("/books") : `${href("/books")}?${search}`;
}

export default function Books() {
  const filters = parseBookFilters(url().searchParams);
  return (
    <BookList
      filters={filters}
      result={queries().listBooks({ ...filters, pageSize: 24 })}
      genres={queries().listGenres()}
    />
  );
}

function BookList(props: { filters: BookFilters; result: Page<BookSummary>; genres: Genre[] }) {
  const genreName = () => props.genres.find((genre) => genre.slug === props.filters.genre)?.name;
  const filtered = () => Boolean(props.filters.q || props.filters.genre || props.filters.sort);
  return (
    <main>
      <Title>{props.filters.q ? `“${props.filters.q}” · Books` : "Books"} · Bookshelf</Title>
      <h1>Books</h1>
      <form class="filters" method="get" action={href("/books")}>
        <input
          type="search"
          name="q"
          value={props.filters.q ?? ""}
          placeholder="Title, author or topic"
          aria-label="Search"
        />
        <select name="genre" aria-label="Genre">
          <option value="">All genres</option>
          {props.genres.map((genre) => (
            <option value={genre.slug} selected={genre.slug === props.filters.genre}>
              {genre.name} ({genre.bookCount})
            </option>
          ))}
        </select>
        <select name="sort" aria-label="Sort">
          <option value="">Default order</option>
          {BOOK_SORTS.map((sort) => (
            <option value={sort} selected={sort === props.filters.sort}>
              {SORT_LABELS[sort]}
            </option>
          ))}
        </select>
        <button>Apply</button>
      </form>
      <p class="summary" role="status">
        <span>
          {props.result.total === 1 ? "1 book" : `${props.result.total} books`}
          {props.filters.q ? ` matching “${props.filters.q}”` : ""}
          {genreName() === undefined ? "" : ` in ${genreName()}`}
        </span>
        {filtered() ? <a href={href("/books")}>Clear filters</a> : null}
      </p>
      {props.result.total === 0 ? (
        <p class="empty">No books match. Try fewer words, or another genre.</p>
      ) : (
        <BookGrid books={props.result.items} toggle={readingListToggles(props.result.items)} />
      )}
      <Pager
        info={props.result}
        href={(page) => booksHref({ ...props.filters, page })}
        label="Book pages"
      />
    </main>
  );
}

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: $theme.space.sm;
    margin-bottom: $theme.space.md;
  }
  .filters input {
    flex: 1 1 16rem;
  }
  .summary {
    display: flex;
    gap: $theme.space.md;
    margin: 0 0 $theme.space.lg;
    color: $theme.color.muted;
  }
  .empty {
    padding: $theme.space.xl;
    border-radius: $theme.radius.md;
    background: $theme.color.surface;
    text-align: center;
  }
</style>
