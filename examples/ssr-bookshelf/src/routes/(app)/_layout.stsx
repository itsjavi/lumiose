// Layout of the server-rendered routes: they show the signed-in user, so they render per request.
import { locals } from "lumen";
// Base styles first: component styles come after them in the cascade.
import "../../styles.css";
import { Footer, Header } from "../../components/Header.stsx";

export const mode = "server";

export default function AppLayout(props: { children?: JSX.Element }) {
  return (
    <>
      <Header user={locals().user ?? null} />
      {props.children}
      <Footer />
    </>
  );
}
