import {
  actionData,
  fail,
  href,
  redirect,
  Title,
  url,
  type ActionContext,
  type ActionData,
} from "lumiose";
import { validateLogin, type LoginInput } from "../../../lib/validation.ts";
import { auth, safeRedirectPath } from "../../../server/auth.server.ts";
import type { FieldErrors } from "../../../types.ts";

export const action = async (ctx: ActionContext<"/login">) => {
  const form = await ctx.formData();
  const email = String(form.get("email") ?? "");
  const parsed = validateLogin(form);
  if (!parsed.ok) return fail(400, { email, errors: parsed.errors });
  const user = await auth().authenticate(parsed.value.email, parsed.value.password);
  if (user === null) {
    // Typed as the field errors, so `failed.errors` has one shape for both failures.
    const errors: FieldErrors<keyof LoginInput> = { password: "Wrong email or password." };
    return fail(400, { email, errors });
  }
  await auth().login(ctx.cookies, user.id);
  redirect(safeRedirectPath(ctx.url.searchParams.get("next")));
};

export default function Login() {
  return <LoginForm failed={actionData<typeof action>()} next={url().searchParams.get("next")} />;
}

function LoginForm(props: { failed: ActionData<typeof action> | undefined; next: string | null }) {
  return (
    <main>
      <Title>Sign in · Bookshelf</Title>
      <h1>Sign in</h1>
      {/* No action attribute: the form posts to this URL, `?next=` included. */}
      <form class="form" method="post">
        <label>
          Email
          <input
            type="email"
            name="email"
            value={props.failed?.email ?? ""}
            autocomplete="username"
            required
          />
        </label>
        <p class="error">{props.failed?.errors.email}</p>
        <label>
          Password
          <input type="password" name="password" autocomplete="current-password" required />
        </label>
        <p class="error">{props.failed?.errors.password}</p>
        <button>Sign in</button>
      </form>
      <p>
        New here?{" "}
        <a
          href={
            props.next === null
              ? href("/register")
              : `${href("/register")}?next=${encodeURIComponent(props.next)}`
          }
        >
          Create an account
        </a>
      </p>
      <p class="byline">
        Every seeded account has the password <code>bookshelf</code>, for example
        reader@example.com.
      </p>
    </main>
  );
}
