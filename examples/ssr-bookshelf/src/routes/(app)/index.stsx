import { href, lifetime, locals, Meta, Suspense, Title } from "lumiose";
import { BookGrid } from "../../components/BookCard.stsx";
import { queries } from "../../server/queries.server.ts";
import * as theme from "../../theme.ts";

/** Slow on purpose (BOOKSHELF_SLOW_MS): the shell is sent first and this streams in. */
async function Recommendations(props: { userId: number | null }) {
  const books = await queries().recommendationsFor(props.userId, { signal: lifetime() });
  return <BookGrid books={books} />;
}

function Placeholder() {
  return (
    <div class="placeholder" aria-busy="true">
      <p>Finding books you might like…</p>
      <div class="shelf">
        {[1, 2, 3, 4, 5, 6].map(() => (
          <span />
        ))}
      </div>
    </div>
  );
}

export default function Home() {
  return (
    <main>
      <Title>Bookshelf</Title>
      <Meta name="description" content="A catalog of books with reviews and reading lists." />
      <section class="hero">
        <h1>Find your next book</h1>
        <p>
          Browse {queries().listBooks({ pageSize: 1 }).total} books by{" "}
          {queries().listAuthors({ pageSize: 1 }).total} authors, read what other readers think, and
          keep a reading list.
        </p>
        <p class="actions">
          <a class="primary" href={href("/books")}>
            Browse books
          </a>
          <a href={href("/genres")}>Explore genres</a>
        </p>
      </section>
      <section>
        <h2>{locals().user == null ? "Recommended" : `Picked for ${locals().user!.name}`}</h2>
        <Suspense fallback={<Placeholder />}>
          <Recommendations userId={locals().user?.id ?? null} />
        </Suspense>
      </section>
      <section>
        <h2>Featured</h2>
        <BookGrid books={queries().featuredBooks(6)} />
      </section>
      <section>
        <h2>Trending this month</h2>
        <BookGrid books={queries().trendingBooks({ limit: 6 })} />
      </section>
    </main>
  );
}

<style>
  .hero {
    padding: $theme.space.xl $theme.space.lg;
    border-radius: $theme.radius.md;
    background:
      radial-gradient(
        circle at 85% 20%,
        color-mix(in srgb, $theme.color.accent 22%, transparent),
        transparent 55%
      ),
      $theme.color.surface;
  }
  .hero h1 {
    margin-top: 0;
    font-size: $theme.font.title;
  }
  .hero p {
    max-width: 36rem;
    font-size: $theme.font.lead;
  }
  .actions {
    display: flex;
    gap: $theme.space.md;
    align-items: center;
  }
  .primary {
    padding: $theme.space.sm $theme.space.md;
    border-radius: $theme.radius.sm;
    background: $theme.color.accent;
    color: $theme.color.accentInk;
    text-decoration: none;
  }
  .placeholder p {
    color: $theme.color.muted;
  }
  .shelf {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    gap: $theme.space.md;
  }
  .shelf span {
    aspect-ratio: 2 / 3;
    border-radius: $theme.radius.sm;
    background: $theme.color.surface;
    animation: pulse 1.2s ease-in-out infinite alternate;
  }
  @keyframes pulse {
    to {
      opacity: 0.4;
    }
  }
</style>
