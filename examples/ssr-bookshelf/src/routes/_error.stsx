import { href, Title, type ErrorPageProps } from "lumiose";
import "../styles.css";
import { Footer, Header } from "../components/Header.stsx";

/** Errors other than 404: a forbidden review edit (403), a broken form (400), a crash (500). */
export default function ErrorPage(props: ErrorPageProps) {
  return (
    <>
      <Header />
      <main>
        <Title>Error {props.status} · Bookshelf</Title>
        <h1>{props.status === 403 ? "Not allowed" : "Something went wrong"}</h1>
        <p>{props.error.message}</p>
        <p>
          <a href={href("/")}>Back to the home page</a>
        </p>
      </main>
      <Footer />
    </>
  );
}
