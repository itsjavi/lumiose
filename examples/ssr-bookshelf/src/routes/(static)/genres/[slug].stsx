// Prerendered at build time for every genre (`staticPaths`): its top-rated books, with a link to
// the full, filterable list (a `server` route).
import { href, notFound, Title, type PageProps } from "lumiose";
import { BookGrid } from "../../../components/BookCard.stsx";
import { queries } from "../../../server/queries.server.ts";
import * as theme from "../../../theme.ts";
import type { BookSummary, Genre } from "../../../types.ts";

export function staticPaths() {
  return queries()
    .listGenres()
    .map((genre) => ({ params: { slug: genre.slug } }));
}

export default function GenrePage(props: PageProps<"/genres/[slug]">) {
  return (
    <GenreDetail
      genre={queries().getGenre(props.params.slug) ?? notFound(`No genre "${props.params.slug}".`)}
      books={queries().listBooks({ genre: props.params.slug, sort: "rating", pageSize: 12 }).items}
    />
  );
}

function GenreDetail(props: { genre: Genre; books: BookSummary[] }) {
  return (
    <main>
      <Title>{props.genre.name} · Bookshelf</Title>
      <p class="crumbs">
        <a href={href("/genres")}>Genres</a> /
      </p>
      <h1>{props.genre.name}</h1>
      <p class="lead">
        The top-rated {props.genre.name.toLowerCase()} books.{" "}
        <a href={`${href("/books")}?genre=${props.genre.slug}`}>
          Browse all {props.genre.bookCount} →
        </a>
      </p>
      <BookGrid books={props.books} />
    </main>
  );
}

<style>
  .crumbs {
    margin: 0;
    color: $theme.color.muted;
    font-size: $theme.font.small;
  }
  .lead {
    margin-bottom: $theme.space.lg;
    font-size: $theme.font.lead;
  }
</style>
