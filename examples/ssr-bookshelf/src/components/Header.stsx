import { href } from "lumen";
import { AccountMenu } from "../islands/AccountMenu.stsx";
import { SearchBox } from "../islands/SearchBox.stsx";
import * as theme from "../theme.ts";
import type { User } from "../types.ts";
import { AccountLinks } from "./AccountLinks.stsx";

/**
 * Site header. `user` is `undefined` on prerendered pages, which cannot know who is signed in:
 * there the account menu island asks the server once the page is idle.
 */
export function Header(props: { user?: User | null }) {
  return (
    <header class="site-header">
      <a class="brand" href={href("/")}>
        <span class="logo" aria-hidden="true" />
        Bookshelf
      </a>
      <nav aria-label="Main">
        <a href={href("/books")}>Books</a>
        <a href={href("/authors")}>Authors</a>
        <a href={href("/genres")}>Genres</a>
        <a href={href("/about")}>About</a>
      </nav>
      <SearchBox client:load />
      {props.user === undefined ? <AccountMenu client:idle /> : <AccountLinks user={props.user} />}

      <style>
        .site-header {
          display: flex;
          flex-wrap: wrap;
          gap: $theme.space.sm $theme.space.lg;
          align-items: center;
          padding: $theme.space.sm $theme.space.md;
          border-bottom: 1px solid $theme.color.line;
        }
        .brand {
          display: flex;
          gap: $theme.space.sm;
          align-items: center;
          color: inherit;
          font-weight: 700;
          font-size: $theme.font.lead;
          text-decoration: none;
        }
        .logo {
          width: 0.9rem;
          height: 1.2rem;
          border-radius: 2px;
          background: linear-gradient(
            90deg,
            $theme.color.accent 30%,
            color-mix(in srgb, $theme.color.accent 60%, white) 30%
          );
        }
        nav {
          display: flex;
          gap: $theme.space.md;
          flex: 1;
        }
        nav a {
          color: inherit;
          text-decoration: none;
        }
        nav a:hover {
          color: $theme.color.accent;
        }
      </style>
    </header>
  );
}

export function Footer() {
  return (
    <footer class="site-footer">
      <p>
        Bookshelf is a sample app of the Lumen framework. Books, authors, readers and reviews are
        generated. <a href={href("/about")}>How it is built</a>
      </p>

      <style>
        .site-footer {
          padding: $theme.space.lg $theme.space.md;
          border-top: 1px solid $theme.color.line;
          color: $theme.color.muted;
          font-size: $theme.font.small;
          text-align: center;
        }
        p {
          margin: 0;
        }
      </style>
    </footer>
  );
}
