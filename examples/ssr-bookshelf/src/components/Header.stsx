import { href } from "lumiose";
import { AccountMenu } from "../islands/AccountMenu.stsx";
import { SearchBox } from "../islands/SearchBox.stsx";
import * as theme from "../theme.ts";

/**
 * Site header. `account` is its account area. Server pages pass a per-reader hole (see
 * `(app)/layout.stsx`); the default is the account menu island, for prerendered pages, which
 * cannot know who is signed in: it asks the server once the page is idle.
 */
export function Header(props: { account?: JSX.Element }) {
  return (
    <header class="site-header">
      <a class="brand" href={href("/")}>
        <span class="logo" aria-hidden="true" />
        Bookshelf
      </a>
      <nav aria-label="Main">
        <a href={href("/books")}>Books</a>
        <a href={href("/authors")}>Authors</a>
        <a href={href("/genres")}>Genres</a>
        <a href={href("/about")}>About</a>
      </nav>
      <SearchBox client:load />
      {props.account ?? <AccountMenu client:idle />}
    </header>
  );
}

export function Footer() {
  return (
    <footer class="site-footer">
      <p>
        Bookshelf is a sample app of the Lumiose framework. Books, authors, readers and reviews are
        generated. <a href={href("/about")}>How it is built</a>
      </p>
    </footer>
  );
}

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    gap: $theme.space.sm $theme.space.lg;
    align-items: center;
    padding: $theme.space.sm $theme.space.md;
    border-bottom: 1px solid $theme.color.line;
  }
  .brand {
    display: flex;
    gap: $theme.space.sm;
    align-items: center;
    color: inherit;
    font-weight: 700;
    font-size: $theme.font.lead;
    text-decoration: none;
  }
  .logo {
    width: 0.9rem;
    height: 1.2rem;
    border-radius: 2px;
    background: linear-gradient(
      90deg,
      $theme.color.accent 30%,
      color-mix(in srgb, $theme.color.accent 60%, white) 30%
    );
  }
  nav {
    display: flex;
    gap: $theme.space.md;
    flex: 1;
  }
  nav a {
    color: inherit;
    text-decoration: none;
  }
  nav a:hover {
    color: $theme.color.accent;
  }
  .site-footer {
    padding: $theme.space.lg $theme.space.md;
    border-top: 1px solid $theme.color.line;
    color: $theme.color.muted;
    font-size: $theme.font.small;
    text-align: center;
  }
  .site-footer p {
    margin: 0;
  }
</style>
