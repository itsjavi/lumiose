// Island (client:idle) for prerendered pages, which cannot know who is signed in: it renders the
// sign-in links on the server, then asks /api/me in the browser and shows the reader's links.
import { fetchJSON, href, onMount, signal } from "lumiose";
import { AccountLinks } from "../components/AccountLinks.stsx";
import type { User } from "../types.ts";

export function AccountMenu() {
  const user = signal<User | null>(null);

  onMount(() => {
    const controller = new AbortController();
    fetchJSON<{ user: User | null }>(href("/api/me"), { signal: controller.signal })
      .then((data) => user.set(data.user))
      .catch(() => {});
    return () => controller.abort();
  });

  return (
    <div class="account-menu">
      <AccountLinks user={user()} />
    </div>
  );
}
