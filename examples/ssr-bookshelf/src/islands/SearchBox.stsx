// Island (client:load): the header search. Without JavaScript it is a GET form to /books?q=;
// once hydrated, typing shows live suggestions from /api/search (debounced, earlier requests
// aborted). Arrow keys move through them, Enter opens the highlighted book, Escape closes them.
import { fetchJSON, onCleanup, signal } from "lumen";
import * as theme from "../theme.ts";

interface Suggestion {
  isbn: string;
  title: string;
  authors: string[];
}

const DEBOUNCE_MS = 150;

export function SearchBox(props: { q?: string }) {
  const results = signal<Suggestion[]>([]);
  const open = signal(false);
  const active = signal(-1);
  let timer: ReturnType<typeof setTimeout> | undefined;
  let pending: AbortController | undefined;

  onCleanup(() => {
    clearTimeout(timer);
    pending?.abort();
  });

  function search(q: string) {
    clearTimeout(timer);
    pending?.abort();
    if (q.trim() === "") {
      results.set([]);
      open.set(false);
      return;
    }
    timer = setTimeout(async () => {
      const controller = (pending = new AbortController());
      try {
        const data = await fetchJSON<{ results: Suggestion[] }>(
          `/api/search?q=${encodeURIComponent(q)}`,
          { signal: controller.signal },
        );
        results.set(data.results);
        active.set(-1);
        open.set(true);
      } catch {
        // Aborted by a newer query, or offline: the form still submits.
      }
    }, DEBOUNCE_MS);
  }

  function onKeyDown(event: KeyboardEvent) {
    const count = results().length;
    if (event.key === "ArrowDown" && count > 0) {
      event.preventDefault();
      open.set(true);
      active.set((active() + 1) % count);
    } else if (event.key === "ArrowUp" && count > 0) {
      event.preventDefault();
      active.set(active() <= 0 ? count - 1 : active() - 1);
    } else if (event.key === "Escape") {
      open.set(false);
      active.set(-1);
    } else if (event.key === "Enter" && open() && active() >= 0) {
      event.preventDefault();
      location.assign(`/books/${results()[active()]!.isbn}`);
    }
  }

  return (
    <form class="search" method="get" action="/books" role="search">
      <input
        type="search"
        name="q"
        value={props.q ?? ""}
        placeholder="Search books"
        aria-label="Search books"
        autocomplete="off"
        role="combobox"
        aria-autocomplete="list"
        aria-controls="search-suggestions"
        aria-expanded={open() ? "true" : "false"}
        aria-activedescendant={active() >= 0 ? `suggestion-${active()}` : undefined}
        onInput={(event) => search(event.currentTarget.value)}
        onKeyDown={onKeyDown}
        onFocus={() => open.set(results().length > 0)}
        onBlur={() => setTimeout(() => open.set(false), 150)}
      />
      <ul
        id="search-suggestions"
        class="suggestions"
        role="listbox"
        aria-label="Suggestions"
        hidden={!open() || results().length === 0}
      >
        {results().map((book, index) => (
          <li
            id={`suggestion-${index}`}
            role="option"
            aria-selected={index === active() ? "true" : "false"}
          >
            <a href={`/books/${book.isbn}`} tabindex="-1">
              <strong>{book.title}</strong>
              <span>{book.authors.join(", ")}</span>
            </a>
          </li>
        ))}
      </ul>

      <style>
        .search {
          position: relative;
          flex: 0 1 18rem;
        }
        input {
          box-sizing: border-box;
          width: 100%;
        }
        .suggestions {
          position: absolute;
          z-index: 10;
          inset: calc(100% + $theme.space.xs) 0 auto;
          margin: 0;
          padding: $theme.space.xs 0;
          list-style: none;
          border: 1px solid $theme.color.line;
          border-radius: $theme.radius.md;
          background: Canvas;
          box-shadow: $theme.shadow.popup;
        }
        li a {
          display: grid;
          padding: $theme.space.xs $theme.space.md;
          color: inherit;
          text-decoration: none;
        }
        li a span {
          color: $theme.color.muted;
          font-size: $theme.font.small;
        }
        li[aria-selected="true"] a,
        li a:hover {
          background: $theme.color.hover;
        }
      </style>
    </form>
  );
}
