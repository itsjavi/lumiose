{
  // Lumen's options (JSX, rootDirs for the shadow TSX) come from the generated config.
  "extends": ["../../tsconfig.base.json", "./.lumen/tsconfig.generated.json"],
  "compilerOptions": {
    "types": ["node", "lumen/env", "vite/client"]
  },
  "include": [
    "src",
    "server.ts",
    "vite.config.ts",
    "playwright.config.ts",
    "e2e",
    ".lumen/shadow",
    ".lumen/types"
  ]
}
