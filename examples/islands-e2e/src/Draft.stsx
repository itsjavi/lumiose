import { signal } from "lumiose";
import { beforeNavigate } from "lumiose/router";

/**
 * TASK-549: on an MPA page, beforeNavigate sees same-origin link clicks as "link", and a cancel
 * keeps the page, so the island asks with its own dialog; for "leave" the browser asks. Each
 * hook call is logged in sessionStorage (`hooks`), which the next page of the origin can read.
 */
export function Draft() {
  const dirty = signal(false);
  const leaving = signal<URL | undefined>(undefined);
  beforeNavigate((navigation) => {
    const log = JSON.parse(sessionStorage.getItem("hooks") ?? "[]") as string[];
    sessionStorage.setItem("hooks", JSON.stringify([...log, navigation.type]));
    if (!dirty()) return;
    navigation.cancel();
    if (navigation.type === "link") leaving.set(navigation.to?.url);
  });
  return (
    <section class="draft" ref={(el: HTMLElement) => (el.dataset.hydrated = "")}>
      <textarea id="draft" onInput={() => dirty.set(true)} />
      {leaving() !== undefined && (
        <p role="alert">
          Unsaved changes before {leaving()!.pathname}.{" "}
          <button
            id="discard"
            onClick={() => {
              dirty.set(false);
              location.assign(leaving()!);
            }}
          >
            Discard
          </button>
        </p>
      )}
    </section>
  );
}
