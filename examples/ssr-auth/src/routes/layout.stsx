// The root layout. The account area is an island: the home page is prerendered, so only the
// browser knows who is signed in there.
import { href, type LayoutProps } from "lumiose";
import { AccountMenu } from "../islands/AccountMenu.stsx";

export default function Layout(props: LayoutProps<"/">) {
  return (
    <div class="app">
      <header>
        <nav>
          <a class="brand" href={href("/")}>
            Accounts
          </a>
          <a href={href("/dashboard")}>Dashboard</a>
        </nav>
        <AccountMenu client:load />
      </header>
      {props.children}
    </div>
  );
}

<style>
  .app {
    max-width: 40rem;
    margin: 0 auto;
    padding: 1.5rem 1rem;
  }
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  nav {
    display: flex;
    gap: 1rem;
  }
  .brand {
    font-weight: 700;
  }
</style>

<style global>
  body {
    margin: 0;
    font:
      16px/1.5 system-ui,
      sans-serif;
  }
  form.stack {
    display: grid;
    gap: 0.75rem;
    max-width: 22rem;
  }
  label {
    display: grid;
    gap: 0.25rem;
  }
  input,
  button {
