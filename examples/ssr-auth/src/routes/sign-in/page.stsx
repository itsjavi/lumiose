import { actionData, fail, href, Title, url, type ActionContext, type ActionData } from "lumiose";
import { authError, authRequest, redirectWithCookies, safeNext } from "../../server/auth.server.ts";

export const action = async (ctx: ActionContext<"/sign-in">) => {
  const form = await ctx.formData();
  const email = String(form.get("email") ?? "").trim();
  const password = String(form.get("password") ?? "");
  // Through Better Auth's handler, so its rate limiter counts the attempt (3 per 10 s per client).
  const response = await authRequest(ctx, "/sign-in/email", { email, password });
  // A wrong password (401) or too many attempts (429): Better Auth's message.
  if (!response.ok) return fail(response.status, { email, message: await authError(response) });
  return redirectWithCookies(safeNext(ctx.url.searchParams.get("next")), response.headers);
};

export default function SignIn() {
  return <SignInForm failed={actionData<typeof action>()} next={url().searchParams.get("next")} />;
}

function SignInForm(props: { failed: ActionData<typeof action> | undefined; next: string | null }) {
  return (
    <main>
      <Title>Sign in</Title>
      <h1>Sign in</h1>
      <form class="stack" method="post">
        <label>
          Email
          <input
            type="email"
            name="email"
            value={props.failed?.email ?? ""}
            autocomplete="username"
            required
          />
        </label>
        <label>
          Password
          <input type="password" name="password" autocomplete="current-password" required />
        </label>
        <p class="error" role="alert">
          {props.failed?.message}
        </p>
        <button>Sign in</button>
      </form>
      <p>
        New here?{" "}
        <a
          href={
            props.next === null
              ? href("/sign-up")
              : `${href("/sign-up")}?next=${encodeURIComponent(props.next)}`
          }
        >
          Create an account
        </a>
      </p>
    </main>
  );
}
