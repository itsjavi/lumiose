import { Autocomplete, Combobox, Field } from "@lumiose/ui";
import { Title } from "lumiose";

const TAGS = ["accessibility", "animation", "api", "docs", "forms", "performance", "ui"];
const COUNTRIES = ["Germany", "Greece", "Portugal", "Spain", "Sweden", "Switzerland"];

// Server-rendered, no island: `lu-combobox`'s script runs the autocompletes (free text) and the
// combobox on the server HTML. The text is the value: the inputs submit what is typed. The form
// submits to this page (GET), so the values show in the URL; the fields below show Field's
// validation on a Combobox and an Autocomplete (TASK-404). Styled with the default theme.
export default function AutocompletePage() {
  return (
    <>
      <Title>Autocomplete</Title>
      <h1>Autocomplete</h1>
      <form method="get" action="/autocomplete" class="grid">
        <section aria-labelledby="list-heading">
          <h2 id="list-heading">Suggestions</h2>
          <Autocomplete.Root name="tag" class="lu-combobox">
            <Autocomplete.Label>Tag</Autocomplete.Label>
            <Autocomplete.Input placeholder="Any tag" />
            <Autocomplete.Clear aria-label="Clear tag" />
            <Autocomplete.Popup>
              <Autocomplete.List>
                {TAGS.map((tag) => (
                  <Autocomplete.Item value={tag}>{tag}</Autocomplete.Item>
                ))}
              </Autocomplete.List>
              <Autocomplete.Empty>No suggestions: any tag works.</Autocomplete.Empty>
            </Autocomplete.Popup>
          </Autocomplete.Root>
          <Autocomplete.Root
            name="country"
            mode="both"
            filter="startsWith"
            keepHighlight
            class="lu-combobox"
          >
            <Autocomplete.Label>Country</Autocomplete.Label>
            <Autocomplete.Input />
            <Autocomplete.List>
              {COUNTRIES.map((country) => (
                <Autocomplete.Item value={country}>{country}</Autocomplete.Item>
              ))}
            </Autocomplete.List>
          </Autocomplete.Root>
        </section>

        <section aria-labelledby="field-heading">
          <h2 id="field-heading">In a Field</h2>
          <Field.Root name="city" class="lu-field">
            <Field.Label>City</Field.Label>
            <Combobox.Root required class="lu-combobox">
              <Combobox.Input />
              <Combobox.List>
                <Combobox.Item value="ber">Berlin</Combobox.Item>
                <Combobox.Item value="lis">Lisbon</Combobox.Item>
                <Combobox.Item value="mad">Madrid</Combobox.Item>
              </Combobox.List>
            </Combobox.Root>
            <Field.Description>One of the cities we ship to.</Field.Description>
            <Field.Error />
          </Field.Root>
          <Field.Root name="topic" class="lu-field">
            <Field.Label>Topic</Field.Label>
            <Autocomplete.Root required class="lu-combobox">
              <Autocomplete.Input />
              <Autocomplete.List>
                {TAGS.map((tag) => (
                  <Autocomplete.Item value={tag}>{tag}</Autocomplete.Item>
                ))}
              </Autocomplete.List>
            </Autocomplete.Root>
            <Field.Description>Anything, or a suggestion.</Field.Description>
            <Field.Error />
          </Field.Root>
        </section>

        <footer>
          <button type="submit" class="lu-button" data-variant="primary">
            Save
          </button>
          <button type="reset" class="lu-button">
            Reset
          </button>
        </footer>
      </form>

      <form method="get" action="/autocomplete" role="search" aria-label="Tags">
        {/* The first match highlighted as you type, three at most, and a click searches. */}
        <Autocomplete.Root name="q" autoHighlight limit={3} submitOnItemClick class="lu-combobox">
          <Autocomplete.Label>Search</Autocomplete.Label>
          <Autocomplete.Input />
          <Autocomplete.List>
            {TAGS.map((tag) => (
              <Autocomplete.Item value={tag}>{tag}</Autocomplete.Item>
            ))}
          </Autocomplete.List>
        </Autocomplete.Root>
      </form>
    </>
  );
}

<style>
  form footer {
    display: flex;
    gap: 0.5rem;
    align-self: end;
  }
</style>
