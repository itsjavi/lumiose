import "@lumiose/ui/styles.css";
import "@lumiose/ui/themes/default.css";
import "../example.css";
import type { LayoutProps } from "lumiose";

export default function Root(props: LayoutProps<"/">) {
  return (
    <div class="shell">
      {/* One link: the home page lists every fixture. A long nav pushed the fixtures below a 720px
          viewport, where anchored popups flip (TASK-414). */}
      <nav aria-label="Components">
        <a href="/">All @lumiose/ui fixtures</a>
      </nav>
      <main>{props.children}</main>
    </div>
  );
}

<style>
  .shell {
    max-inline-size: 64rem;
    margin-inline: auto;
    padding: 1rem;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-block-end: 1rem;
  }
  :global(.grid) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 2rem;
    align-items: start;
  }
  :global(.grid > section) {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
  }
  :global(.grid > section > h2) {
    margin: 0;
    font-size: 1rem;
  }
</style>
