import { ContextMenu } from "@lumiose/ui";
import { Title } from "lumiose";

// Server-rendered, no island: <lu-context-menu>'s script opens Menu's popup at the pointer.
export default function ContextMenuPage() {
  return (
    <>
      <Title>Context Menu</Title>
      <h1>Context Menu</h1>
      <ContextMenu.Root>
        <ContextMenu.Trigger
          class="area"
          tabindex={0}
          aria-label="Project files"
          data-testid="area"
        >
          Right-click, long-press, or press Shift+F10 here.
        </ContextMenu.Trigger>
        <ContextMenu.Popup class="lu-menu" aria-label="File actions">
          <ContextMenu.Item>Rename</ContextMenu.Item>
          <ContextMenu.Item>Duplicate</ContextMenu.Item>
          <ContextMenu.Item disabled>Share</ContextMenu.Item>
          <ContextMenu.Separator />
          <ContextMenu.LinkItem href="#history">History</ContextMenu.LinkItem>
          <ContextMenu.SubmenuRoot>
            <ContextMenu.SubmenuTrigger>Move to</ContextMenu.SubmenuTrigger>
            <ContextMenu.Popup class="lu-menu">
              <ContextMenu.Item>Archive</ContextMenu.Item>
              <ContextMenu.Item>Trash</ContextMenu.Item>
            </ContextMenu.Popup>
          </ContextMenu.SubmenuRoot>
        </ContextMenu.Popup>
      </ContextMenu.Root>
      <ContextMenu.Root disabled>
        <ContextMenu.Trigger class="area" data-testid="disabled">
          The browser's own menu here.
        </ContextMenu.Trigger>
        <ContextMenu.Popup class="lu-menu" aria-label="Unused">
          <ContextMenu.Item>Never</ContextMenu.Item>
        </ContextMenu.Popup>
      </ContextMenu.Root>
      {/* A context menu inside another's area: the inner one opens there (TASK-437 M15). */}
      <ContextMenu.Root>
        <ContextMenu.Trigger class="area" tabindex={0} aria-label="Board" data-testid="board">
          Board
          <ContextMenu.Root>
            <ContextMenu.Trigger class="area" tabindex={0} aria-label="Card" data-testid="card">
              Card
            </ContextMenu.Trigger>
            <ContextMenu.Popup class="lu-menu" aria-label="Card actions">
              <ContextMenu.Item>Edit card</ContextMenu.Item>
            </ContextMenu.Popup>
          </ContextMenu.Root>
        </ContextMenu.Trigger>
        <ContextMenu.Popup class="lu-menu" aria-label="Board actions">
          <ContextMenu.Item>Add card</ContextMenu.Item>
        </ContextMenu.Popup>
      </ContextMenu.Root>
      <p id="history">History.</p>
    </>
  );
}

<style>
  :global(.area) {
    display: grid;
    place-items: center;
    min-block-size: 8rem;
    margin-block-end: 1rem;
    border: 2px dashed currentColor;
    border-radius: 0.5rem;
  }
  /* The card inside the board, with room around it for the board's own right-click. */
  :global(.area .area) {
    inline-size: 60%;
    min-block-size: 4rem;
    margin-block-end: 0;
  }
</style>
