// The virtualizer's components in an island (TASK-565): VirtualTable in its own scroller and
// VirtualList on the window. The server renders the first rows of each.
export default function VirtualComponentsPage() {
  return (
    <>
      <Title>Virtualizer components</Title>
      <h1>Virtualizer components</h1>
      <VirtualComponents client:load />
    </>
  );
}

