import { Field, Form, Select } from "@lumiose/ui";
import { Title } from "lumiose";

// Submit attempts (TASK-439, M28 and M29): a field with an Error, then a required input without
// a field. Only a submit attempt shows the field's error; a silent checkValidity() shows nothing.
export default function FormAttemptPage() {
  return (
    <>
      <Title>Submit attempts</Title>
      <h1>Submit attempts</h1>
      <Form method="get" action="/form/attempt" class="lu-fieldset">
        <Field.Root name="email" class="lu-field">
          <Field.Label>Email</Field.Label>
          <Field.Control type="email" required class="lu-input" />
          <Field.Error />
        </Field.Root>
        <input name="nickname" aria-label="Nickname" required class="lu-input" />
        {/* TASK-446: a required select shows nothing on a Tab through, and two descriptions. */}
        <Field.Root name="plan" validationMode="onBlur" class="lu-field">
          <Field.Label>Plan</Field.Label>
          <Select.Root required class="lu-select">
            <Select.Item value="">Choose a plan</Select.Item>
            <Select.Item value="pro">Pro</Select.Item>
          </Select.Root>
          <Field.Description>Billed monthly.</Field.Description>
          <Field.Description>Cancel any time.</Field.Description>
          <Field.Error match="valueMissing">Choose a plan.</Field.Error>
          <Field.Error match="valueMissing">A plan is required.</Field.Error>
        </Field.Root>
        <button type="submit" class="lu-button">
          Send
        </button>
      </Form>
    </>
  );
}
