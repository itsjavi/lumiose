import { href, Title } from "lumen";
import { Counter } from "../components/Counter.stsx";
import { posts } from "../lib/posts.ts";

export default function Home() {
  return (
    <main>
      <Title>eval-app</Title>
      <h1>Posts</h1>
      <p>
        Likes: <Counter client:visible start={10} step={5} />
      </p>
      <ul class="posts">
        {posts.map((post) => (
          <li key={post.slug}>
            <a href={href("/blog/[slug]", { slug: post.slug })}>{post.title}</a>
            <time>{post.date}</time>
          </li>
        ))}
      </ul>

      <style>
        .posts {
          padding: 0;
          list-style: none;
        }
        time {
          margin-left: 0.5rem;
          color: #666;
        }
      </style>
    </main>
  );
}
