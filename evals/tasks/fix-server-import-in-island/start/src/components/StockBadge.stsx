import { signal } from "lumiose";
import { getStock } from "../server/stock.server.ts";

export function StockBadge({ sku }: { sku: string }) {
  const stock = signal(getStock(sku) ?? 0);
  return (
    <p class="stock">
      In stock: {stock()}{" "}
      <button type="button" onClick={() => stock.set(getStock(sku) ?? 0)}>
        Refresh
      </button>
    </p>
  );
}
