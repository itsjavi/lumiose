export function ProgressBar({ value }: { value: number }) {
  const clamped = () => Math.min(100, Math.max(0, value));
  return (
    <div
      class="progress"
      role="progressbar"
      aria-valuemin={0}
      aria-valuemax={100}
      aria-valuenow={clamped()}
      style={{ "--progress": `${clamped()}%` }}
    >
      <div class="fill" />

      <style>
        .progress {
          height: 0.75rem;
          background: #e5e7eb;
          border-radius: 999px;
          overflow: hidden;
        }
        .fill {
          height: 100%;
          background: #16a34a;
          width: var(--progress);
        }
      </style>
    </div>
  );
}
