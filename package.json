{
  "name": "lumiose-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "pnpm -r --parallel --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "fmt:examples": "node scripts/fmt-examples.ts",
    "cargo:build": "cargo build --workspace",
    "cargo:test": "cargo test --workspace",
    "check": "pnpm build:compiler && pnpm typecheck && pnpm lint && pnpm fmt:examples && pnpm test && node --test scripts/*.test.ts && pnpm --filter lumiose size && cargo test --workspace",
    "build:compiler": "pnpm --filter @lumiose/compiler build",
    "pack:check": "node scripts/pack.ts",
    "release:version": "node scripts/release.ts",
    "build:site": "node scripts/site.ts build",
    "preview:site": "node scripts/site.ts preview",
    "demo": "node scripts/demo.ts"
  },
  "devDependencies": {
    "@lumiose/cli": "workspace:*",
    "@types/node": "^24.0.0",
    "happy-dom": "^20.14.5",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0"
}
