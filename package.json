{
  "name": "lumen-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "pnpm -r --parallel --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "fmt:examples": "pnpm --filter \"./examples/*\" exec lumen fmt --check",
    "cargo:build": "cargo build --workspace",
    "cargo:test": "cargo test --workspace",
    "check": "pnpm build:compiler && pnpm typecheck && pnpm lint && pnpm fmt:examples && pnpm test && pnpm --filter lumen size && cargo test --workspace",
    "build:compiler": "pnpm --filter @lumen/compiler build",
    "build:site": "node scripts/site.ts build",
    "preview:site": "node scripts/site.ts preview"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "happy-dom": "^20.14.5",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0"
}
