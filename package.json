{
  "name": "lumen-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "pnpm -r --parallel --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "cargo:build": "cargo build --workspace",
    "cargo:test": "cargo test --workspace",
    "check": "pnpm typecheck && pnpm lint && pnpm test && cargo test --workspace"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "happy-dom": "^20.14.5",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0"
}
