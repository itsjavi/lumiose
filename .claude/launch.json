      "runtimeArgs": ["--filter", "@lumiose/web", "exec", "lumiose", "dev", "--port", "5196"],
      "port": 5196,
      "url": "http://localhost:5196"
    },
    {
      "name": "dotmatrix",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "examples/spa-dotmatrix",
        "exec",
        "lumiose",
        "dev",
        "--port",
        "5197"
      ],
      "port": 5197,
      "url": "http://localhost:5197"
    },
    {
      "name": "bookshelf",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "examples/ssr-bookshelf", "run", "dev", "--port", "5198"],
      "port": 5198,
      "url": "http://localhost:5198"
    },
    {
      "name": "ui-showcase",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "examples/ui-e2e",
        "exec",
        "lumiose",
        "dev",
